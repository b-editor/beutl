<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <PackageId>Beutl.Extensibility.Sdk</PackageId>
    <PackageType>MSBuildSdk</PackageType>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <Target Name="_GenerateVersionProps" BeforeTargets="GenerateNuspec;Pack">
    <PropertyGroup>
      <_VersionPropsContent>
<![CDATA[<Project>
  <PropertyGroup>
    <BeutlExtensibilitySdkVersion>$(Version)</BeutlExtensibilitySdkVersion>
  </PropertyGroup>
</Project>]]>
      </_VersionPropsContent>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(IntermediateOutputPath)Sdk/Version.props"
      Lines="$(_VersionPropsContent)"
      Overwrite="true" />
  </Target>

  <!-- Writes the auto-references of Sdk.targets from the libraries marked BeutlSdkAutoReference (#2877). -->
  <UsingTask TaskName="WriteBeutlAutoReferences" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Libraries ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputFile Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
ITaskItem[] libraries = Libraries.Where(library => library.GetMetadata("SdkAutoReference") != "").OrderBy(library => library.ItemSpec, StringComparer.Ordinal).ToArray();
// Built from "$" and "(" because MSBuild would expand a property reference written in this code.
string Property(string name) => "$" + "(" + name + ")";
string OptOut(ITaskItem library) => "BeutlAutoReference" + library.GetMetadata("SdkAutoReference");
string Enabled(ITaskItem library) => $"'{Property(OptOut(library))}' == 'true'";
// An analyzer only runs at build time, so it stays out of the extension's package dependencies.
string Reference(ITaskItem library, string assets) => library.GetMetadata("IsAnalyzer") == "true"
    ? $"    <PackageReference Include=\"{library.ItemSpec}\" OutputItemType=\"Analyzer\" ReferenceOutputAssembly=\"false\" Version=\"{Property("BeutlPackagesVersion")}\" PrivateAssets=\"all\" Condition=\"{Enabled(library)}\" />"
    : $"    <PackageReference Include=\"{library.ItemSpec}\" Version=\"{Property("BeutlPackagesVersion")}\"{assets} Condition=\"{Enabled(library)}\" />";
var lines = new List<string> { "<Project>", "  <PropertyGroup>" };
lines.AddRange(libraries.Select(library => $"    <{OptOut(library)} Condition=\"'{Property(OptOut(library))}' == ''\">{Property("BeutlAutoReferenceAll")}</{OptOut(library)}>"));
lines.Add("  </PropertyGroup>");
lines.Add($"  <ItemGroup Condition=\"'{Property("_PreventCopyInternalPackages")}' == 'true'\">");
lines.AddRange(libraries.Select(library => Reference(library, " ExcludeAssets=\"runtime;native\"")));
lines.Add("  </ItemGroup>");
lines.Add($"  <ItemGroup Condition=\"'{Property("_PreventCopyInternalPackages")}' != 'true'\">");
lines.AddRange(libraries.Select(library => Reference(library, "")));
lines.Add("  </ItemGroup>");
lines.Add("</Project>");
Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
File.WriteAllLines(OutputFile, lines);
]]></Code>
    </Task>
  </UsingTask>

  <Target Name="_GenerateAutoReferences" BeforeTargets="GenerateNuspec;Pack">
    <MSBuild Projects="$(RootDirectory)build/BeutlLibraries.proj" Targets="CollectBeutlLibraries">
      <Output TaskParameter="TargetOutputs" ItemName="_BeutlLibrary" />
    </MSBuild>
    <WriteBeutlAutoReferences Libraries="@(_BeutlLibrary)" OutputFile="$(IntermediateOutputPath)Sdk/AutoReferences.targets" />
  </Target>

  <!-- Writes what BeutlHostPackageReference can name, each at the version Beutl ships (#2733). -->
  <UsingTask TaskName="WriteBeutlHostPackages" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Packages ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputFile Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
ITaskItem[] packages = Packages.OrderBy(package => package.ItemSpec, StringComparer.Ordinal).ToArray();
// Built from "@" and "(" because MSBuild would expand an item reference written in this code.
string Requested(ITaskItem package) => "@" + $"(BeutlHostPackageReference->AnyHaveMetadataValue('Identity', '{package.ItemSpec}'))";
var lines = new List<string> { "<Project>", "  <ItemGroup>" };
lines.AddRange(packages.Select(package => $"    <_BeutlHostPackage Include=\"{package.ItemSpec}\" />"));
lines.Add("  </ItemGroup>");
lines.Add("  <ItemGroup>");
// The extension compiles against the library and runs on Beutl's copy, so nothing of it goes into its output or package.
lines.AddRange(packages.Select(package => $"    <PackageReference Include=\"{package.ItemSpec}\" Version=\"{package.GetMetadata("Version")}\" ExcludeAssets=\"runtime;native\" PrivateAssets=\"all\" Condition=\"'{Requested(package)}' == 'true'\" />"));
lines.Add("  </ItemGroup>");
lines.Add("</Project>");
Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
File.WriteAllLines(OutputFile, lines);
]]></Code>
    </Task>
  </UsingTask>

  <ItemGroup>
    <!-- Build and test tools, and what only the FFmpeg worker loads: an extension's load context finds none of them in Beutl. -->
    <_NotABeutlHostPackage Include="Aigamo.ResXGenerator;AvaloniaUI.DiagnosticsSupport;Avalonia.Headless;Avalonia.Headless.NUnit" />
    <_NotABeutlHostPackage Include="BenchmarkDotNet;coverlet.collector;Dotnet.Bundle;Moq;NUnit;NUnit3TestAdapter;Nuke.Common;Roslynator.Analyzers" />
    <_NotABeutlHostPackage Include="Microsoft.CodeAnalysis.Analyzers;Microsoft.CodeAnalysis.BannedApiAnalyzers;Microsoft.Extensions.TimeProvider.Testing" />
    <_NotABeutlHostPackage Include="Microsoft.NET.Test.Sdk;Microsoft.Windows.CsWin32;FFmpeg.AutoGen.Bindings.DynamicallyLoaded;FFmpeg4Sharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Beutl.Extensions.MediaFoundation ships these on Windows x64 alone, so an extension cannot count on them. -->
    <_NotABeutlHostPackage Include="NAudio.Wasapi;Vortice.MediaFoundation" />
    <!-- Only the build and the package tools use these, so the app does not bring them. -->
    <_NotABeutlHostPackage Include="NuGet.Packaging;System.CommandLine;System.Security.Cryptography.Xml" />
  </ItemGroup>

  <Target Name="_GenerateHostPackages" BeforeTargets="GenerateNuspec;Pack">
    <ItemGroup>
      <_BeutlHostPackage Include="@(PackageVersion)" Exclude="@(_NotABeutlHostPackage)" />
    </ItemGroup>
    <WriteBeutlHostPackages Packages="@(_BeutlHostPackage)" OutputFile="$(IntermediateOutputPath)Sdk/HostPackages.targets" />
  </Target>

  <ItemGroup>
    <None Include="$(IntermediateOutputPath)Sdk/Version.props" Pack="true" PackagePath="Sdk/" />
    <None Include="$(IntermediateOutputPath)Sdk/AutoReferences.targets" Pack="true" PackagePath="Sdk/" />
    <None Include="$(IntermediateOutputPath)Sdk/HostPackages.targets" Pack="true" PackagePath="Sdk/" />
  </ItemGroup>
  
  <ItemGroup>
    <None Include="Sdk\Sdk.props" Pack="true" PackagePath="Sdk" />
    <None Include="Sdk\Sdk.targets" Pack="true" PackagePath="Sdk" />
  </ItemGroup>
</Project>