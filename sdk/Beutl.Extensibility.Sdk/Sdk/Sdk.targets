<Project>
  <PropertyGroup>
    <_PreventCopyInternalPackages>false</_PreventCopyInternalPackages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DebugApplication)' == 'true' or '$(DebugApplicationTransitive)' == 'true'">
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <_PreventCopyInternalPackages>true</_PreventCopyInternalPackages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DebugApplicationTransitive)' == 'true'">
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DebugApplication)' == 'true'">
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DebugApplication)' == 'true' and '$(BeutlSideloadPath)' == ''">
    <_BeutlHome Condition="'$(BEUTL_HOME)' != ''">$(BEUTL_HOME)</_BeutlHome>
    <_BeutlHome Condition="'$(_BeutlHome)' == ''">$([System.Environment]::GetFolderPath(SpecialFolder.UserProfile))$([System.IO.Path]::DirectorySeparatorChar).beutl</_BeutlHome>
    <BeutlSideloadPath>$(_BeutlHome)$([System.IO.Path]::DirectorySeparatorChar)sideloads$([System.IO.Path]::DirectorySeparatorChar)$(AssemblyName)</BeutlSideloadPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DebugApplication)' == 'true'">
    <OutputPath>$(BeutlSideloadPath)</OutputPath>
  </PropertyGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <!-- AutoReferences.targets, generated when the SDK is packed, references the libraries Beutl marks, each with an opt-out. -->
  <PropertyGroup>
    <BeutlAutoReferenceAll Condition="'$(BeutlAutoReferenceAll)' == ''">true</BeutlAutoReferenceAll>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)AutoReferences.targets" />

  <!-- HostPackages.targets, generated when the SDK is packed, turns a BeutlHostPackageReference into a compile-only reference at the version Beutl ships. -->
  <Import Project="$(MSBuildThisFileDirectory)HostPackages.targets" />

  <Target Name="_CheckBeutlHostPackageReferences" BeforeTargets="CollectPackageReferences" Condition="'@(BeutlHostPackageReference)' != ''">
    <ItemGroup>
      <_UnknownBeutlHostPackage Include="@(BeutlHostPackageReference)" Exclude="@(_BeutlHostPackage)" />
    </ItemGroup>
    <Error Condition="'@(_UnknownBeutlHostPackage)' != ''"
           Text="BeutlHostPackageReference names a library this Beutl does not ship: @(_UnknownBeutlHostPackage, ', '). Use PackageReference for a library of the extension's own." />
  </Target>

  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="CopyProjectReferencesToPackage" DependsOnTargets="ResolveReferences">
      <ItemGroup>
          <BuildOutputInPackage
              Include="@(ReferenceCopyLocalPaths)"
              Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference'" />
      </ItemGroup>
  </Target>

</Project>
