<Project Sdk="Microsoft.NET.Sdk">

  <!--
    GPL-side test project that never ships. It compiles the worker's types from linked sources instead of
    a ProjectReference to Beutl.FFmpegWorker, so the MIT compile closure stays free of the GPL worker. The
    FFmpeg tests skip when the FFmpeg shared libraries are missing.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <DefineConstants>$(DefineConstants);BEUTL_FFMPEG_WORKER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="FFmpeg.AutoGen.Bindings.DynamicallyLoaded" />
    <PackageReference Include="FFmpeg4Sharp" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <!-- Frame and sample sources shared with the AVFoundation encoder tests. -->
    <Compile Include="..\EncoderTestProviders.cs" Link="EncoderTestProviders.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Beutl.Core\Beutl.Core.csproj" />
    <ProjectReference Include="..\..\src\Beutl.Engine\Beutl.Engine.csproj" />
    <ProjectReference Include="..\..\src\Beutl.Extensibility\Beutl.Extensibility.csproj" />
    <ProjectReference Include="..\..\src\Beutl.FFmpegIpc\Beutl.FFmpegIpc.csproj" />
  </ItemGroup>

  <!-- Worker-side FFmpeg-calling encoding types (direct in-process, GPL originals). -->
  <ItemGroup>
    <Compile Include="..\..\src\Beutl.FFmpegWorker\Handlers\PreviewEncodingHandler.cs" Link="Linked\PreviewEncodingHandler.cs" />
    <Compile Include="..\..\src\Beutl.FFmpegWorker\FFmpegErrorCodeExtractor.cs" Link="Linked\FFmpegErrorCodeExtractor.cs" />
    <Compile Include="..\..\src\Beutl.FFmpegWorker\Encoding\FFmpegEncodingController.cs" Link="Linked\FFmpegEncodingController.cs" />
    <Compile Include="..\..\src\Beutl.FFmpegWorker\Encoding\FrameFit.cs" Link="Linked\FrameFit.cs" />
    <Compile Include="..\..\src\Beutl.FFmpegWorker\Encoding\EncoderOptionsQuery.cs" Link="Linked\EncoderOptionsQuery.cs" />
    <Compile Include="..\..\src\Beutl.FFmpegWorker\ColorSpaceHelper.cs" Link="Linked\ColorSpaceHelper.cs" />
    <Compile Include="..\..\src\Beutl.FFmpegWorker\HardwareAcceleration.cs" Link="Linked\HardwareAcceleration.cs" />
    <Compile Include="..\..\src\Beutl.FFmpegWorker\FFmpegLoaderWorker.cs" Link="Linked\FFmpegLoaderWorker.cs" />
    <Compile Include="..\..\src\Beutl.FFmpegWorker\WorkerLog.cs" Link="Linked\WorkerLog.cs" />
    <Compile Include="..\..\src\Beutl.Extensions.FFmpeg\FFmpegNativeRid.cs" Link="Linked\FFmpegNativeRid.cs" />
  </ItemGroup>

  <!-- Decode encoded frames through both worker read paths for pixel round-trip tests. -->
  <ItemGroup>
    <Compile Include="..\..\src\Beutl.FFmpegWorker\Decoding\FFmpegReader.cs" Link="Linked\FFmpegReader.cs" />
    <Compile Include="..\..\src\Beutl.Extensions.FFmpeg.Core\Decoding\FFmpegSeekDecision.cs" Link="Linked\FFmpegSeekDecision.cs" />
    <Compile Include="..\..\src\Beutl.Extensions.FFmpeg.Core\Decoding\FFmpegFrameValidation.cs" Link="Linked\FFmpegFrameValidation.cs" />
    <Compile Include="..\..\src\Beutl.Extensions.FFmpeg.Core\Decoding\FFmpegDecodingSettings.cs" Link="Linked\FFmpegDecodingSettings.cs" />
    <Compile Include="..\..\src\Beutl.Extensions.FFmpeg.Core\Decoding\FFmpegVideoSlotSizing.cs" Link="Linked\FFmpegVideoSlotSizing.cs" />
  </ItemGroup>

  <!-- The worker's decoding message handler, driven in-process to order a read against a parallel close. -->
  <ItemGroup>
    <Compile Include="..\..\src\Beutl.FFmpegWorker\Handlers\DecodingHandler.cs" Link="Linked\DecodingHandler.cs" />
    <Compile Include="..\..\src\Beutl.FFmpegWorker\Handlers\DecodingHandler.ReaderState.cs" Link="Linked\DecodingHandler.ReaderState.cs" />
    <Compile Include="..\..\src\Beutl.FFmpegWorker\Handlers\VideoRingBuffer.cs" Link="Linked\VideoRingBuffer.cs" />
    <Compile Include="..\..\src\Beutl.FFmpegWorker\Handlers\ColorSpaceIpcHelper.cs" Link="Linked\ColorSpaceIpcHelper.cs" />
    <None Include="..\Beutl.FFmpegIpc.Tests\Fixtures\mf-unsupported.flv" Link="Fixtures\mf-unsupported.flv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Beutl.Extensions.MediaFoundation.Tests\Fixtures\late-video.mp4" Link="Fixtures\late-video.mp4" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Beutl.Extensions.MediaFoundation.Tests\Fixtures\marker-bframes-no-edit.mp4" Link="Fixtures\marker-bframes-no-edit.mp4" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\Beutl.FFmpegIpc.Tests\TestWav.cs" Link="Linked\TestWav.cs" />
  </ItemGroup>

  <!-- Settings/record types shared with the MIT extension (compiled here under BEUTL_FFMPEG_WORKER). -->
  <ItemGroup>
    <Compile Include="..\..\src\Beutl.Extensions.FFmpeg.Core\Encoding\CodecRecord.cs" Link="Linked\CodecRecord.cs" />
    <Compile Include="..\..\src\Beutl.Extensions.FFmpeg.Core\Encoding\FFmpegEncodingSettings.cs" Link="Linked\FFmpegEncodingSettings.cs" />
    <Compile Include="..\..\src\Beutl.Extensions.FFmpeg.Core\Encoding\FFmpegVideoEncoderSettings.cs" Link="Linked\FFmpegVideoEncoderSettings.cs" />
    <Compile Include="..\..\src\Beutl.Extensions.FFmpeg.Core\Encoding\FFmpegAudioEncoderSettings.cs" Link="Linked\FFmpegAudioEncoderSettings.cs" />
  </ItemGroup>

  <!-- Frame timing fixtures, described in Fixtures/README.md. -->
  <ItemGroup>
    <None Update="Fixtures\*.mp4" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Audio origin fixtures, described in the Media Foundation tests' Fixtures/README.md. -->
  <ItemGroup>
    <None Include="..\Beutl.Extensions.MediaFoundation.Tests\Fixtures\late-audio.mp4" Link="Fixtures\late-audio.mp4" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Beutl.Extensions.MediaFoundation.Tests\Fixtures\marker-bframes.mp4" Link="Fixtures\marker-bframes.mp4" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Beutl.Extensions.MediaFoundation.Tests\Fixtures\surround51-tones.m4a" Link="Fixtures\surround51-tones.m4a" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
