<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <EmbeddedResource Include="..\Beutl.UnitTests\Assets\Font\BeutlTestVariable.ttf" LogicalName="ProjectFontFixture.ttf" />
    <EmbeddedResource Include="..\Beutl.UnitTests\Assets\Font\Roboto-Regular.ttf" LogicalName="LatinOnlyFontFixture.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared GPU gate: tests say whether they need any Vulkan device or a hardware GPU. -->
    <Compile Include="..\TestGpu.cs" Link="TestGpu.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Beutl.AgentToolkit\Beutl.AgentToolkit.csproj" />
    <!-- As Beutl.AgentToolkit.Mcp ships it, for the text fallback the server sets up. -->
    <ProjectReference Include="..\..\src\Beutl.BundledFonts\Beutl.BundledFonts.csproj" />
  </ItemGroup>

</Project>
