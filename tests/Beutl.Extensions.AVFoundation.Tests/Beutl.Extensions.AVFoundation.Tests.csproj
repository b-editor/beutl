<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- This test project exercises the AVFoundation dylib, which only loads on macOS. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Beutl.Extensions.AVFoundation\Beutl.Extensions.AVFoundation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Frame and sample sources shared with the FFmpeg worker encoder tests. -->
    <Compile Include="..\EncoderTestProviders.cs" Link="EncoderTestProviders.cs" />
    <None Include="..\Beutl.Extensions.MediaFoundation.Tests\Fixtures\marker-bframes.mp4" Link="Fixtures\marker-bframes.mp4" CopyToOutputDirectory="PreserveNewest" />
    <!-- Variable frame rate fixtures, described in the FFmpeg worker tests' Fixtures/README.md. -->
    <None Include="..\Beutl.FFmpegWorker.Tests\Fixtures\vfr-30-60-30.mp4" Link="Fixtures\vfr-30-60-30.mp4" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Beutl.FFmpegWorker.Tests\Fixtures\vfr-screen.mp4" Link="Fixtures\vfr-screen.mp4" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Mirror the AVF dylib into this project's output (ProjectReferences don't copy native
       runtimes/ assets) so the test host can resolve libBeutlAVF.dylib. BeutlAVFOwnsSwiftBuild=false
       imports only the mirror target; gated on macOS where the dylib loads. -->
  <PropertyGroup>
    <BeutlAVFOwnsSwiftBuild>false</BeutlAVFOwnsSwiftBuild>
    <CopyBeutlAVFDylibsToOutput Condition="'$([MSBuild]::IsOSPlatform(OSX))' == 'true'">true</CopyBeutlAVFDylibsToOutput>
  </PropertyGroup>
  <Import Project="..\..\src\Beutl.Extensions.AVFoundation\build\BeutlAVF.targets" />

</Project>
