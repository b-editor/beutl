<Project>
  <PropertyGroup>
    <!-- The SDK defaults Configuration only after this file is imported, so a project built without -c
         would still see it empty below and keep Optimize=true in Debug. Default it the same way first. -->
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <TargetFramework>net11.0</TargetFramework>
    <!-- Desktop host projects also target Windows so releases cross-publish from any OS.
         CI's test build passes BeutlWindowsTargets=false: those shards only run the
         Linux binaries, and windows-publish still compiles the Windows target. -->
    <BeutlDesktopTargetFrameworks>net11.0;net11.0-windows</BeutlDesktopTargetFrameworks>
    <BeutlDesktopTargetFrameworks Condition="'$(BeutlWindowsTargets)' == 'false'">net11.0</BeutlDesktopTargetFrameworks>
    <LangVersion>15</LangVersion>
    <!-- .NET 11 runtime async: the runtime suspends and resumes async Task and ValueTask methods, which then get
         no compiler-generated state machine. async void methods and async iterators keep theirs. -->
    <Features>$(Features);runtime-async=on</Features>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <RootDirectory>$(MSBuildThisFileDirectory)</RootDirectory>
    <BeutlSkiaSharpNativeRoot Condition="'$(BeutlSkiaSharpNativeRoot)' == ''">$(MSBuildThisFileDirectory)src/Beutl.Engine/</BeutlSkiaSharpNativeRoot>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Preserve reflection bindings for dynamic editor models; projects can opt into compiled bindings. -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <NoWarn>$(NoWarn);NU1507</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyVersion>2.99.99.0</AssemblyVersion>
    <Version>2.99.99</Version>
  </PropertyGroup>

  <PropertyGroup>
    <ResXGenerator_PublicClass>true</ResXGenerator_PublicClass>
    <ResXGenerator_GenerationType>CodeGeneration</ResXGenerator_GenerationType>
    <ResXGenerator_NullForgivingOperators>true</ResXGenerator_NullForgivingOperators>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <Optimize>false</Optimize>
  </PropertyGroup>
</Project>
