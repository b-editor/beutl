###############################################################################
# Set default behavior to automatically normalize line endings.
###############################################################################
* text=auto

# Unified patches require stable line endings; blank context lines contain one space.
native/SkiaSharp/*.patch text eol=lf whitespace=-blank-at-eol

# Pinned native runtimes are committed alongside the engine.
src/Beutl.Engine/runtimes/**/libSkiaSharp.* binary
# Keep upstream license text as provided, including its whitespace.
src/Beutl.Engine/runtimes/**/Skia.NOTICES -whitespace

# Keep upstream font license text as provided.
src/Beutl.Controls/Assets/Fonts/**/OFL.txt -whitespace
src/Beutl.Controls/Assets/Fonts/NotoSansCJK-LICENSE.txt -whitespace
