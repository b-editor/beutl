{
	"name": "C# (.NET)",
	"image": "mcr.microsoft.com/devcontainers/dotnet:9.0",
	"features": {
		"ghcr.io/devcontainers/features/desktop-lite:1": {}
	},
	"forwardPorts": [
		6080
	],
	"portsAttributes": {
		"6080": {
			"label": "desktop"
		}
	},
	"postCreateCommand": "sudo dotnet workload update && dotnet restore",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-dotnettools.csdevkit"
			]
		}
	}
}