diff --git a/src/gpu/ganesh/ops/GrSimpleMeshDrawOpHelper.cpp b/src/gpu/ganesh/ops/GrSimpleMeshDrawOpHelper.cpp
index 5f04c82..fca506c 100644
--- a/src/gpu/ganesh/ops/GrSimpleMeshDrawOpHelper.cpp
+++ b/src/gpu/ganesh/ops/GrSimpleMeshDrawOpHelper.cpp
@@ -79,7 +79,9 @@ GrProcessorSet::Analysis GrSimpleMeshDrawOpHelper::finalizeProcessors(
     auto result = this->finalizeProcessors(caps, clip, clampType, geometryCoverage, &color);
     color.isConstant(geometryColor);
     if (wideColor) {
-        *wideColor = !geometryColor->fitsInBytes();
+        // Beutl: a target with float channels takes the color as floats. Bytes would round it to a
+        // step of 1/255 in the target's color space, which in a linear space loses dark colors.
+        *wideColor = !geometryColor->fitsInBytes() || clampType != GrClampType::kAuto;
     }
     return result;
 }
