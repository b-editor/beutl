--- a/BUILD.gn
+++ b/BUILD.gn
@@ -2029,6 +2029,12 @@
   # for the fork; the list above is left identical to upstream to keep merges clean.
   if (skia_enable_fontmgr_fontconfig) {
     deps += [ ":fontmgr_fontconfig" ]
+  }
+
+  # Beutl: sk_beutl_fontmgr_create_freetype is compiled into :core as well and needs the
+  # SK_FONTMGR_FREETYPE_EMPTY_AVAILABLE define that only targets depending on this one receive.
+  if (skia_enable_fontmgr_custom_empty) {
+    deps += [ ":fontmgr_custom_empty" ]
   }
 }
 
--- a/include/c/sk_typeface.h
+++ b/include/c/sk_typeface.h
@@ -68,6 +68,9 @@
 // font manager
 
 SK_C_API sk_fontmgr_t* sk_fontmgr_create_default(void);
+// Beutl rasterizes its content fonts with FreeType on Windows, where DirectWrite's grayscale
+// coverage is too coarse for scaling text. Only defined when FreeType is built in.
+SK_C_API sk_fontmgr_t* sk_beutl_fontmgr_create_freetype(void);
 SK_C_API void sk_fontmgr_unref(sk_fontmgr_t*);
 SK_C_API int sk_fontmgr_count_families(sk_fontmgr_t*);
 SK_C_API void sk_fontmgr_get_family_name(sk_fontmgr_t*, int index, sk_string_t* familyName);
--- a/src/c/sk_typeface.cpp
+++ b/src/c/sk_typeface.cpp
@@ -40,6 +40,10 @@
 #include "include/ports/SkFontMgr_empty.h"
 #endif
 
+#if defined(SK_FONTMGR_FREETYPE_EMPTY_AVAILABLE)
+#include "include/ports/SkFontMgr_empty.h"
+#endif
+
 #include "include/c/sk_typeface.h"
 
 #include "src/c/sk_types_priv.h"
@@ -190,6 +194,13 @@
 #endif
 }
 
+#if defined(SK_FONTMGR_FREETYPE_EMPTY_AVAILABLE)
+// Left out otherwise, so the export check also catches the ARM64 build, which its x64 build host cannot run.
+sk_fontmgr_t* sk_beutl_fontmgr_create_freetype(void) {
+    return ToFontMgr(SkFontMgr_New_Custom_Empty().release());
+}
+#endif
+
 void sk_fontmgr_unref(sk_fontmgr_t* fontmgr) {
     AsFontMgr(fontmgr)->unref();
 }
