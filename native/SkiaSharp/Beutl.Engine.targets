<Project>
  <PropertyGroup>
    <BeutlSkiaSharpNativeRoot Condition="'$(BeutlSkiaSharpNativeRoot)' == ''">$(MSBuildThisFileDirectory)native/</BeutlSkiaSharpNativeRoot>
    <_BeutlSkiaSharpRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_BeutlSkiaSharpRid>
    <_BeutlSkiaSharpRid Condition="'$(_BeutlSkiaSharpRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</_BeutlSkiaSharpRid>
    <_BeutlSkiaSharpFile Condition="$(_BeutlSkiaSharpRid.StartsWith('linux-'))">libSkiaSharp.so</_BeutlSkiaSharpFile>
    <_BeutlSkiaSharpFile Condition="$(_BeutlSkiaSharpRid.StartsWith('win-'))">libSkiaSharp.dll</_BeutlSkiaSharpFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(_BeutlSkiaSharpFile)' != ''">
    <Content Include="$(BeutlSkiaSharpNativeRoot)runtimes/$(_BeutlSkiaSharpRid)/native/Skia.LICENSE;$(BeutlSkiaSharpNativeRoot)runtimes/$(_BeutlSkiaSharpRid)/native/Skia.NOTICES"
             Condition="Exists('$(BeutlSkiaSharpNativeRoot)runtimes/$(_BeutlSkiaSharpRid)/native/Skia.LICENSE')"
             Link="licenses/SkiaSharp/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" Visible="false" />
  </ItemGroup>

  <!-- Replace the source of the SDK's native assets, preserving their runtime/deps.json metadata.
       This runs for both ordinary builds and RID publishes, and also for NuGet consumers. -->
  <Target Name="UseBeutlSkiaSharp" AfterTargets="ResolvePackageAssets"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_BeutlSkiaRuntime Include="@(RuntimeTargetsCopyLocalItems)"
                         Condition="'%(Filename)' == 'libSkiaSharp' And ('%(Extension)' == '.so' Or '%(Extension)' == '.dll')" />
      <_BeutlSkiaNative Include="@(NativeCopyLocalItems)"
                        Condition="'%(Filename)' == 'libSkiaSharp' And ('%(Extension)' == '.so' Or '%(Extension)' == '.dll')" />
    </ItemGroup>
    <Error Condition="'$(_BeutlSkiaSharpFile)' != '' And ('@(_BeutlSkiaRuntime)' != '' Or '@(_BeutlSkiaNative)' != '') And !Exists('$(BeutlSkiaSharpNativeRoot)runtimes/$(_BeutlSkiaSharpRid)/native/$(_BeutlSkiaSharpFile)')"
           Text="Beutl requires its patched libSkiaSharp for $(_BeutlSkiaSharpRid). Run python3 native/SkiaSharp/build.py --rid $(_BeutlSkiaSharpRid), or set BeutlSkiaSharpNativeRoot to the native CI artifact directory." />
    <Error Condition="'%(_BeutlSkiaRuntime.NuGetPackageVersion)' != '' And '%(_BeutlSkiaRuntime.NuGetPackageVersion)' != '4.152.1'"
           Text="Update native/SkiaSharp/source.json and rebuild libSkiaSharp together with the SkiaSharp packages." />
    <Error Condition="'%(_BeutlSkiaNative.NuGetPackageVersion)' != '' And '%(_BeutlSkiaNative.NuGetPackageVersion)' != '4.152.1'"
           Text="Update native/SkiaSharp/source.json and rebuild libSkiaSharp together with the SkiaSharp packages." />
    <ItemGroup>
      <_BeutlSkiaRuntime Remove="@(_BeutlSkiaRuntime)" Condition="!Exists('$(BeutlSkiaSharpNativeRoot)%(_BeutlSkiaRuntime.PathInPackage)')" />
      <_BeutlSkiaNative Remove="@(_BeutlSkiaNative)" Condition="!Exists('$(BeutlSkiaSharpNativeRoot)%(_BeutlSkiaNative.PathInPackage)')" />
      <RuntimeTargetsCopyLocalItems Remove="@(_BeutlSkiaRuntime)" />
      <RuntimeTargetsCopyLocalItems Include="@(_BeutlSkiaRuntime->'$(BeutlSkiaSharpNativeRoot)%(PathInPackage)')" />
      <NativeCopyLocalItems Remove="@(_BeutlSkiaNative)" />
      <NativeCopyLocalItems Include="@(_BeutlSkiaNative->'$(BeutlSkiaSharpNativeRoot)%(PathInPackage)')" />
      <!-- Upstream PDBs do not describe the rebuilt DLL. -->
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)"
          Condition="'%(Filename)' == 'libSkiaSharp' And '%(Extension)' == '.pdb' And Exists('$(BeutlSkiaSharpNativeRoot)runtimes/%(RuntimeIdentifier)/native/libSkiaSharp.dll')" />
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)"
          Condition="'%(Filename)' == 'libSkiaSharp' And '%(Extension)' == '.pdb' And Exists('$(BeutlSkiaSharpNativeRoot)runtimes/$(_BeutlSkiaSharpRid)/native/libSkiaSharp.dll')" />
    </ItemGroup>
  </Target>
</Project>
