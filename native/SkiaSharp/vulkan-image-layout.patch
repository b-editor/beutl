@@ -322,6 +322,27 @@ bool gr_backendtexture_get_gl_textureinfo(const gr_backendtexture_t* texture, gr
     return SK_ONLY_GPU(GrBackendTextures::GetGLTextureInfo(*AsGrBackendTexture(texture), AsGrGLTextureInfo(glInfo)), false);
 }
 
+bool gr_beutl_backendtexture_get_vk_image_layout(const gr_backendtexture_t* texture, uint32_t* layout) {
+    if (!texture || !layout) {
+        return false;
+    }
+    SK_ONLY_VULKAN(
+        GrVkImageInfo info;
+        if (GrBackendTextures::GetVkImageInfo(*AsGrBackendTexture(texture), &info)) {
+            *layout = static_cast<uint32_t>(info.fImageLayout);
+            return true;
+        }
+    )
+    return false;
+}
+
+void gr_beutl_backendtexture_set_vk_image_layout(gr_backendtexture_t* texture, uint32_t layout) {
+    if (!texture) {
+        return;
+    }
+    SK_ONLY_VULKAN(GrBackendTextures::SetVkImageLayout(AsGrBackendTexture(texture), static_cast<VkImageLayout>(layout)));
+}
+
 
 // GrBackendRenderTarget
 
