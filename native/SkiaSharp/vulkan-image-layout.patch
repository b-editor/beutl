diff --git a/include/c/gr_context.h b/include/c/gr_context.h
index bbad64e..d0bcc0f 100644
--- a/include/c/gr_context.h
+++ b/include/c/gr_context.h
@@ -109,6 +109,10 @@ SK_C_API int gr_backendrendertarget_get_stencils(const gr_backendrendertarget_t*
 SK_C_API gr_backend_t gr_backendrendertarget_get_backend(const gr_backendrendertarget_t* rendertarget);
 SK_C_API bool gr_backendrendertarget_get_gl_framebufferinfo(const gr_backendrendertarget_t* rendertarget, gr_gl_framebufferinfo_t* glInfo);

+// Beutl's Vulkan hand-off uses the mutable state shared with wrapped SkSurfaces.
+SK_C_API bool gr_beutl_backendrendertarget_get_vk_image_layout(const gr_backendrendertarget_t* rendertarget, uint32_t* layout);
+SK_C_API void gr_beutl_backendrendertarget_set_vk_image_layout(gr_backendrendertarget_t* rendertarget, uint32_t layout);
+
 // Drives completion of asynchronous work (e.g. sk_image/sk_surface_async_rescale_and_read_pixels)
 // on the Ganesh backend. A submit must also occur to guarantee a finite time before callbacks fire.
 SK_C_API void gr_direct_context_check_async_work_completion(gr_direct_context_t* context);
diff --git a/src/c/gr_context.cpp b/src/c/gr_context.cpp
index ecbc161..0bc8e69 100644
--- a/src/c/gr_context.cpp
+++ b/src/c/gr_context.cpp
@@ -372,3 +372,21 @@ gr_backend_t gr_backendrendertarget_get_backend(const gr_backendrendertarget_t*
 bool gr_backendrendertarget_get_gl_framebufferinfo(const gr_backendrendertarget_t* rendertarget, gr_gl_framebufferinfo_t* glInfo) {
     return SK_ONLY_GPU(GrBackendRenderTargets::GetGLFramebufferInfo(*AsGrBackendRenderTarget(rendertarget), AsGrGLFramebufferInfo(glInfo)), false);
 }
+
+bool gr_beutl_backendrendertarget_get_vk_image_layout(const gr_backendrendertarget_t* rendertarget, uint32_t* layout) {
+    if (!rendertarget || !layout) {
+        return false;
+    }
+    SK_ONLY_VULKAN(
+        GrVkImageInfo info;
+        if (GrBackendRenderTargets::GetVkImageInfo(*AsGrBackendRenderTarget(rendertarget), &info)) {
+            *layout = static_cast<uint32_t>(info.fImageLayout);
+            return true;
+        }
+    )
+    return false;
+}
+
+void gr_beutl_backendrendertarget_set_vk_image_layout(gr_backendrendertarget_t* rendertarget, uint32_t layout) {
+    SK_ONLY_VULKAN(GrBackendRenderTargets::SetVkImageLayout(AsGrBackendRenderTarget(rendertarget), static_cast<VkImageLayout>(layout)));
+}
