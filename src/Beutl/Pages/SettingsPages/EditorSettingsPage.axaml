<UserControl x:Class="Beutl.Pages.SettingsPages.EditorSettingsPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrls="using:Beutl.Controls"
             xmlns:lang="using:Beutl.Language"
             xmlns:vm="using:Beutl.ViewModels.SettingsPages"
             x:CompileBindings="True"
             x:DataType="vm:EditorSettingsPageViewModel">
    <Grid Margin="18" RowDefinitions="Auto,*">
        <TextBlock Margin="10,8"
                   Text="{x:Static lang:Strings.Editor}"
                   Theme="{StaticResource SimpleLargeBreadcrumbBarTextBlock}" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="10,16,10,0" Spacing="4">
                <TextBlock Text="{x:Static lang:Strings.Timeline}" Theme="{StaticResource BodyStrongTextBlockStyle}" />

                <Border Classes="options-group">
                    <ctrls:OptionsGroupPanel>
                        <ctrls:OptionsDisplayItem Description="{x:Static lang:SettingsStrings.AutoAdjustSceneDuration_Description}" Header="{x:Static lang:SettingsStrings.AutoAdjustSceneDuration}">
                            <ctrls:OptionsDisplayItem.ActionButton>
                                <ToggleSwitch Classes="left"
                                              IsChecked="{CompiledBinding AutoAdjustSceneDuration.Value}"
                                              Theme="{StaticResource CompactToggleSwitchStyle}" />
                            </ctrls:OptionsDisplayItem.ActionButton>
                        </ctrls:OptionsDisplayItem>

                        <ctrls:OptionsDisplayItem Header="{x:Static lang:SettingsStrings.SwapTimelineScrollDirection}">
                            <ctrls:OptionsDisplayItem.ActionButton>
                                <ToggleSwitch Classes="left"
                                              IsChecked="{CompiledBinding SwapTimelineScrollDirection.Value}"
                                              Theme="{StaticResource CompactToggleSwitchStyle}" />
                            </ctrls:OptionsDisplayItem.ActionButton>
                        </ctrls:OptionsDisplayItem>

                        <ctrls:OptionsDisplayItem Description="{x:Static lang:SettingsStrings.SeekOnTimelineClick_Description}" Header="{x:Static lang:SettingsStrings.SeekOnTimelineClick}">
                            <ctrls:OptionsDisplayItem.ActionButton>
                                <ToggleSwitch Classes="left"
                                              IsChecked="{CompiledBinding SeekOnTimelineClick.Value}"
                                              Theme="{StaticResource CompactToggleSwitchStyle}" />
                            </ctrls:OptionsDisplayItem.ActionButton>
                        </ctrls:OptionsDisplayItem>

                        <ctrls:OptionsDisplayItem Description="{x:Static lang:SettingsStrings.TimelineAutoScrollMode_Description}" Header="{x:Static lang:SettingsStrings.TimelineAutoScrollMode}">
                            <ctrls:OptionsDisplayItem.ActionButton>
                                <ComboBox MinWidth="250" SelectedIndex="{CompiledBinding TimelineAutoScrollMode.Value}">
                                    <ComboBoxItem Content="{x:Static lang:SettingsStrings.TimelineAutoScrollMode_None}" />
                                    <ComboBoxItem Content="{x:Static lang:SettingsStrings.TimelineAutoScrollMode_AlwaysFollow}" />
                                    <ComboBoxItem Content="{x:Static lang:SettingsStrings.TimelineAutoScrollMode_PageScroll}" />
                                </ComboBox>
                            </ctrls:OptionsDisplayItem.ActionButton>
                        </ctrls:OptionsDisplayItem>

                        <!--  In the order of TimeDisplayFormat's values.  -->
                        <ctrls:OptionsDisplayItem Description="{x:Static lang:SettingsStrings.TimeDisplayFormat_Description}" Header="{x:Static lang:SettingsStrings.TimeDisplayFormat}">
                            <ctrls:OptionsDisplayItem.ActionButton>
                                <ComboBox MinWidth="250" SelectedIndex="{CompiledBinding TimeDisplayFormat.Value}">
                                    <ComboBoxItem Content="{x:Static lang:SettingsStrings.TimeDisplayFormat_Time}" />
                                    <ComboBoxItem Content="{x:Static lang:SettingsStrings.TimeDisplayFormat_Timecode}" />
                                    <ComboBoxItem Content="{x:Static lang:SettingsStrings.TimeDisplayFormat_Frames}" />
                                </ComboBox>
                            </ctrls:OptionsDisplayItem.ActionButton>
                        </ctrls:OptionsDisplayItem>

                        <ctrls:OptionsDisplayItem Description="{x:Static lang:SettingsStrings.ClampResizeToOriginalLength_Description}" Header="{x:Static lang:SettingsStrings.ClampResizeToOriginalLength}">
                            <ctrls:OptionsDisplayItem.ActionButton>
                                <ToggleSwitch Classes="left"
                                              IsChecked="{CompiledBinding ClampResizeToOriginalLength.Value}"
                                              Theme="{StaticResource CompactToggleSwitchStyle}" />
                            </ctrls:OptionsDisplayItem.ActionButton>
                        </ctrls:OptionsDisplayItem>

                        <ctrls:OptionsDisplayItem Description="{x:Static lang:SettingsStrings.ShowTimelineThumbnailsByDefault_Description}" Header="{x:Static lang:SettingsStrings.ShowTimelineThumbnailsByDefault}">
                            <ctrls:OptionsDisplayItem.ActionButton>
                                <ToggleSwitch Classes="left"
                                              IsChecked="{CompiledBinding ShowTimelineThumbnailsByDefault.Value}"
                                              Theme="{StaticResource CompactToggleSwitchStyle}" />
                            </ctrls:OptionsDisplayItem.ActionButton>
                        </ctrls:OptionsDisplayItem>

                        <ctrls:OptionsDisplayItem Header="{x:Static lang:SettingsStrings.TimelineLayerSize}">
                            <ctrls:OptionsDisplayItem.ActionButton>
                                <ComboBox MinWidth="250" SelectedIndex="{CompiledBinding TimelineLayerSize.Value}">
                                    <ComboBoxItem Content="{x:Static lang:SettingsStrings.TimelineLayerSize_Small}" />
                                    <ComboBoxItem Content="{x:Static lang:SettingsStrings.TimelineLayerSize_Medium}" />
                                    <ComboBoxItem Content="{x:Static lang:SettingsStrings.TimelineLayerSize_Large}" />
                                </ComboBox>
                            </ctrls:OptionsDisplayItem.ActionButton>
                        </ctrls:OptionsDisplayItem>
                    </ctrls:OptionsGroupPanel>
                </Border>

                <TextBlock Margin="0,16,0,0"
                           Text="{x:Static lang:SettingsStrings.PropertyEditor}"
                           Theme="{StaticResource BodyStrongTextBlockStyle}" />

                <Border Classes="options-group">
                    <ctrls:OptionsGroupPanel>
                        <ctrls:OptionsDisplayItem Description="{x:Static lang:SettingsStrings.EnablePointerLockInProperty_Description}" Header="{x:Static lang:SettingsStrings.EnablePointerLockInProperty}">
                            <ctrls:OptionsDisplayItem.ActionButton>
                                <ToggleSwitch Classes="left"
                                              IsChecked="{CompiledBinding EnablePointerLockInProperty.Value}"
                                              Theme="{StaticResource CompactToggleSwitchStyle}" />
                            </ctrls:OptionsDisplayItem.ActionButton>
                        </ctrls:OptionsDisplayItem>
                    </ctrls:OptionsGroupPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
