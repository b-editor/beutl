<UserControl x:Class="Beutl.Pages.SettingsPages.VersionControlSettingsPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrls="using:Beutl.Controls"
             xmlns:lang="using:Beutl.Language"
             xmlns:vm="using:Beutl.ViewModels.SettingsPages"
             x:CompileBindings="True"
             x:DataType="vm:VersionControlSettingsPageViewModel">
    <Grid Margin="18" RowDefinitions="Auto,*">
        <TextBlock Margin="10,8"
                   Text="{x:Static lang:Strings.VersionControl}"
                   Theme="{StaticResource SimpleLargeBreadcrumbBarTextBlock}" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="10,16,10,0" Spacing="4">
                <Border Classes="options-group">
                    <ctrls:OptionsGroupPanel>
                        <ctrls:OptionsDisplayItem Description="{x:Static lang:SettingsStrings.VersionControl_EnableForNewProjects_Description}"
                                                  Header="{x:Static lang:SettingsStrings.VersionControl_EnableForNewProjects}">
                            <ctrls:OptionsDisplayItem.ActionButton>
                                <ToggleSwitch Classes="left"
                                              IsChecked="{CompiledBinding EnableVersionControlForNewProjects.Value}"
                                              Theme="{StaticResource CompactToggleSwitchStyle}" />
                            </ctrls:OptionsDisplayItem.ActionButton>
                        </ctrls:OptionsDisplayItem>

                        <ctrls:OptionsDisplayItem Description="{x:Static lang:SettingsStrings.VersionControl_AutoCommitOnSave_Description}"
                                                  Header="{x:Static lang:SettingsStrings.VersionControl_AutoCommitOnSave}">
                            <ctrls:OptionsDisplayItem.ActionButton>
                                <ToggleSwitch Classes="left"
                                              IsChecked="{CompiledBinding AutoCommitOnSave.Value}"
                                              Theme="{StaticResource CompactToggleSwitchStyle}" />
                            </ctrls:OptionsDisplayItem.ActionButton>
                        </ctrls:OptionsDisplayItem>

                        <ctrls:OptionsDisplayItem Description="{x:Static lang:SettingsStrings.VersionControl_AutoCommitOnClose_Description}"
                                                  Header="{x:Static lang:SettingsStrings.VersionControl_AutoCommitOnClose}">
                            <ctrls:OptionsDisplayItem.ActionButton>
                                <ToggleSwitch Classes="left"
                                              IsChecked="{CompiledBinding AutoCommitOnClose.Value}"
                                              Theme="{StaticResource CompactToggleSwitchStyle}" />
                            </ctrls:OptionsDisplayItem.ActionButton>
                        </ctrls:OptionsDisplayItem>

                        <ctrls:OptionsDisplayItem Description="{x:Static lang:SettingsStrings.VersionControl_GitExecutablePath_Description}"
                                                  Header="{x:Static lang:SettingsStrings.VersionControl_GitExecutablePath}">
                            <ctrls:OptionsDisplayItem.ActionButton>
                                <TextBox MinWidth="250"
                                         VerticalAlignment="Center"
                                         PlaceholderText="{x:Static lang:SettingsStrings.VersionControl_GitExecutablePath_Automatic}"
                                         Text="{CompiledBinding GitExecutablePath.Value, Mode=TwoWay}" />
                            </ctrls:OptionsDisplayItem.ActionButton>
                        </ctrls:OptionsDisplayItem>

                        <ctrls:OptionsDisplayItem Description="{x:Static lang:SettingsStrings.VersionControl_UseLfsWhenAvailable_Description}"
                                                  Header="{x:Static lang:SettingsStrings.VersionControl_UseLfsWhenAvailable}">
                            <ctrls:OptionsDisplayItem.ActionButton>
                                <ToggleSwitch Classes="left"
                                              IsChecked="{CompiledBinding UseLfsWhenAvailable.Value}"
                                              Theme="{StaticResource CompactToggleSwitchStyle}" />
                            </ctrls:OptionsDisplayItem.ActionButton>
                        </ctrls:OptionsDisplayItem>

                        <ctrls:OptionsDisplayItem Description="{x:Static lang:SettingsStrings.VersionControl_LargeMediaWarningThresholdMb_Description}"
                                                  Header="{x:Static lang:SettingsStrings.VersionControl_LargeMediaWarningThresholdMb}">
                            <ctrls:OptionsDisplayItem.ActionButton>
                                <NumericUpDown MinWidth="250"
                                               FormatString="F0"
                                               Increment="1"
                                               Minimum="1"
                                               Value="{CompiledBinding LargeMediaWarningThresholdMb.Value, Mode=TwoWay}" />
                            </ctrls:OptionsDisplayItem.ActionButton>
                        </ctrls:OptionsDisplayItem>
                    </ctrls:OptionsGroupPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
