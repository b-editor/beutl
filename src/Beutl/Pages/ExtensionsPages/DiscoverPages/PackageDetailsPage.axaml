<UserControl x:Class="Beutl.Pages.ExtensionsPages.DiscoverPages.PackageDetailsPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:asyncImageLoader="using:AsyncImageLoader"
             xmlns:converters="using:Beutl.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:lang="using:Beutl.Language"
             xmlns:md="using:LiveMarkdown.Avalonia"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:viewModels="using:Beutl.ViewModels.ExtensionsPages.DiscoverPages"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:CompileBindings="True"
             x:DataType="viewModels:PackageDetailsPageViewModel"
             Focusable="True"
             RenderOptions.BitmapInterpolationMode="HighQuality"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="BorderColor" Color="{DynamicResource ControlStrokeColorDefault}" />
                    <SolidColorBrush x:Key="ForegroundColor" Color="{DynamicResource TextFillColorPrimary}" />
                    <SolidColorBrush x:Key="CardBackgroundColor" Color="{DynamicResource ControlFillColorDefault}" />
                    <SolidColorBrush x:Key="SecondaryCardBackgroundColor" Color="{DynamicResource ControlAltFillColorSecondary}" />
                    <SolidColorBrush x:Key="CodeInlineColor" Color="{DynamicResource TextFillColorPrimary}" />
                    <SolidColorBrush x:Key="QuoteBorderColor" Color="{DynamicResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="PackageCodeHeaderBackground" Color="{DynamicResource ControlStrokeColorDefault}" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="{x:Static sty:FluentAvaloniaTheme.HighContrastTheme}">
                    <SolidColorBrush x:Key="BorderColor" Color="{DynamicResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ForegroundColor" Color="{DynamicResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CardBackgroundColor" Color="{DynamicResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SecondaryCardBackgroundColor" Color="{DynamicResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CodeInlineColor" Color="{DynamicResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="QuoteBorderColor" Color="{DynamicResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="PackageCodeHeaderBackground" Color="{DynamicResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml" />
        <Style Selector="md|CodeBlock /template/ StackPanel > Border:nth-child(1)">
            <Setter Property="Background" Value="{DynamicResource PackageCodeHeaderBackground}" />
        </Style>
        <Style Selector="md|MarkdownRenderer">
            <Setter Property="CodeBlockColorTheme" Value="{Binding $self.ActualThemeVariant, Converter={x:Static converters:MarkdownConverters.CodeBlockTheme}}" />
        </Style>
        <Style Selector="md|MarkdownTextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource BeutlUIFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextOnAccentFillColorSelectedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="Theme" Value="{StaticResource SubtitleTextBlockStyle}" />
        </Style>
        <Style Selector="TextBlock.caution">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Grid.info > :is(Control)">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="Grid.info > TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Styles>

    <UserControl.KeyBindings>
        <KeyBinding Command="{Binding Refresh}" Gesture="F5" />
        <KeyBinding Command="{Binding Refresh}" Gesture="Ctrl+R" />
    </UserControl.KeyBindings>

    <Panel>
        <ScrollViewer>
            <StackPanel MaxWidth="960"
                        Margin="24,12,24,24"
                        Spacing="24">
                <Grid ColumnDefinitions="Auto,16,*,16,Auto">
                    <Panel Width="96"
                           Height="96"
                           VerticalAlignment="Top">
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="12"
                                IsVisible="{Binding Package.LogoUrl.Value, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                            <icons:FluentIcon FontSize="40"
                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                              Icon="PuzzlePiece" />
                        </Border>
                        <asyncImageLoader:AdvancedImage ImageClipping.CornerRadius="12" Source="{Binding Package.LogoUrl.Value}" />
                    </Panel>

                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{Binding DisplayName.Value}"
                                   TextWrapping="Wrap"
                                   Theme="{StaticResource TitleTextBlockStyle}" />

                        <!--  The kind docks right and the publisher takes what is left, so a long name shortens instead of running under the buttons.  -->
                        <DockPanel HorizontalAlignment="Left">
                            <TextBlock VerticalAlignment="Center"
                                       DockPanel.Dock="Right"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding KindText.Value}" />
                            <TextBlock Margin="6,0"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Right"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="·" />
                            <Button Click="OpenPublisherPage_Click" Theme="{StaticResource LiteButtonStyle}">
                                <TextBlock Text="{Binding Package.Owner.Name}" TextTrimming="CharacterEllipsis" />
                            </Button>
                        </DockPanel>

                        <TextBlock Margin="0,4,0,0"
                                   IsVisible="{Binding Package.ShortDescription.Value, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Text="{Binding Package.ShortDescription.Value}"
                                   TextWrapping="Wrap" />

                        <TextBlock x:Name="versionSelectionError"
                                   Classes="caution"
                                   IsVisible="{Binding VersionSelectionError.Value, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Text="{Binding VersionSelectionError.Value}" />

                        <TextBlock Classes="caution"
                                   IsVisible="{Binding IsVersionUnsupported.Value}"
                                   Text="{x:Static lang:ExtensionsStrings.This_extension_does_not_support_your_Beutl_version}" />

                        <TextBlock Classes="caution"
                                   IsVisible="{Binding Downgrade.Value}"
                                   Text="{x:Static lang:ExtensionsStrings.May_not_work_correctly_when_downgrading}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4"
                                Width="160"
                                Spacing="8">
                        <Button HorizontalAlignment="Stretch"
                                Classes="accent"
                                Command="{Binding Install}"
                                Content="{Binding InstallButtonText.Value}"
                                IsVisible="{Binding IsInstallButtonVisible.Value}" />

                        <Button HorizontalAlignment="Stretch"
                                Classes="accent"
                                Command="{Binding Update}"
                                Content="{x:Static lang:ExtensionsStrings.Update}"
                                IsVisible="{Binding IsUpdateButtonVisible.Value}" />

                        <Button HorizontalAlignment="Stretch"
                                Command="{Binding Uninstall}"
                                Content="{x:Static lang:ExtensionsStrings.Uninstall}"
                                IsVisible="{Binding IsUninstallButtonVisible.Value}" />

                        <Button HorizontalAlignment="Stretch"
                                Command="{Binding Cancel}"
                                Content="{x:Static lang:Strings.Cancel}"
                                IsVisible="{Binding CanCancel.Value}" />

                        <StackPanel IsVisible="{Binding StatusText.Value, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Spacing="4">
                            <ProgressBar HorizontalAlignment="Stretch" IsIndeterminate="True" />
                            <TextBlock HorizontalAlignment="Center"
                                       Text="{Binding StatusText.Value}"
                                       Theme="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>

                        <ComboBox HorizontalAlignment="Center"
                                  DisplayMemberBinding="{Binding Version.Value}"
                                  ItemsSource="{Binding AllReleases}"
                                  SelectedItem="{Binding SelectedRelease.Value}"
                                  Theme="{StaticResource LiteComboBoxStyle}" />
                    </StackPanel>
                </Grid>

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              IsVisible="{Binding !!Package.Screenshots.Value.Length}"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl Margin="0,0,0,12" ItemsSource="{Binding Package.Screenshots.Value}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <asyncImageLoader:AdvancedImage Height="200"
                                                                ImageClipping.CornerRadius="8"
                                                                Source="{ReflectionBinding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <md:MarkdownRenderer x:Name="descriptionMarkdown"
                                     LinkClick="Markdown_LinkClick"
                                     UpdateProducer="{Binding Package.Description.Value, Converter={x:Static converters:MarkdownConverters.ToProducer}}" />

                <StackPanel IsVisible="{Binding SelectedRelease.Value, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="8">
                    <TextBlock Classes="heading"
                               IsVisible="{Binding SelectingLatestVersion.Value}"
                               Text="{x:Static lang:ExtensionsStrings.Package_LatestRelease}" />
                    <TextBlock Classes="heading"
                               IsVisible="{Binding !SelectingLatestVersion.Value}"
                               Text="{x:Static lang:ExtensionsStrings.Package_SelectedRelease}" />

                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SelectedRelease.Value.Title.Value}" />
                    <md:MarkdownRenderer x:Name="releaseNotesMarkdown"
                                         LinkClick="Markdown_LinkClick"
                                         UpdateProducer="{Binding SelectedRelease.Value.Body.Value, Converter={x:Static converters:MarkdownConverters.ToProducer}}" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Classes="heading" Text="{x:Static lang:Strings.Info}" />

                    <!--  A row hides both of its cells, so the label column fits the rows that are shown.  -->
                    <Grid Classes="info"
                          ColumnDefinitions="Auto,24,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Classes="label" Text="{x:Static lang:Strings.Name}" />
                        <SelectableTextBlock Grid.Column="2" Text="{Binding Package.Name}" />

                        <TextBlock Grid.Row="1"
                                   Classes="label"
                                   IsVisible="{Binding LatestRelease.Value, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   Text="{x:Static lang:ExtensionsStrings.Package_LatestVersion}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="2"
                                   IsVisible="{Binding LatestRelease.Value, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   Text="{Binding LatestRelease.Value.Version.Value}" />

                        <TextBlock Grid.Row="2"
                                   Classes="label"
                                   IsVisible="{Binding CurrentRelease.Value, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   Text="{x:Static lang:ExtensionsStrings.Package_InstalledVersion}" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="2"
                                   IsVisible="{Binding CurrentRelease.Value, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   Text="{Binding CurrentRelease.Value.Version.Value}" />

                        <TextBlock Grid.Row="3"
                                   Classes="label"
                                   IsVisible="{Binding SelectedRelease.Value.TargetVersion.Value, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}"
                                   Text="{x:Static lang:ExtensionsStrings.Release_TargetVersion}" />
                        <TextBlock Grid.Row="3"
                                   Grid.Column="2"
                                   IsVisible="{Binding SelectedRelease.Value.TargetVersion.Value, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}"
                                   Text="{Binding SelectedRelease.Value.TargetVersion.Value}" />

                        <TextBlock Grid.Row="4"
                                   Classes="label"
                                   IsVisible="{Binding Package.WebSite.Value, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Text="{x:Static lang:Strings.Website}" />
                        <HyperlinkButton Grid.Row="4"
                                         Grid.Column="2"
                                         Padding="0"
                                         HorizontalAlignment="Left"
                                         Click="OpenWebSite_Click"
                                         Content="{Binding Package.WebSite.Value}"
                                         IsVisible="{Binding Package.WebSite.Value, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                        <TextBlock Grid.Row="5"
                                   Classes="label"
                                   IsVisible="{Binding !!VisibleTags.Value.Length}"
                                   Text="{x:Static lang:ExtensionsStrings.Package_Tags}" />
                        <ItemsControl Grid.Row="5"
                                      Grid.Column="2"
                                      IsVisible="{Binding !!VisibleTags.Value.Length}"
                                      ItemsSource="{Binding VisibleTags.Value}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="6" LineSpacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,1"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="10">
                                        <TextBlock Text="{ReflectionBinding}" Theme="{StaticResource CaptionTextBlockStyle}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing IsIndeterminate="{Binding IsBusy.Value}" IsVisible="{Binding IsBusy.Value}" />
    </Panel>
</UserControl>
