<UserControl x:Class="Beutl.Pages.ExtensionsPages.DiscoverPages.UserProfilePage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:asyncImageLoader="using:AsyncImageLoader"
             xmlns:controls="using:Beutl.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:lang="using:Beutl.Language"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModel="using:Beutl.ViewModels.ExtensionsPages.DiscoverPages"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:CompileBindings="True"
             x:DataType="viewModel:UserProfilePageViewModel"
             Focusable="True"
             IsEnabled="{Binding !IsBusy.Value}"
             RenderOptions.BitmapInterpolationMode="HighQuality"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Beutl/Pages/ExtensionsPages/PackageCards.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.KeyBindings>
        <KeyBinding Command="{Binding Refresh}" Gesture="F5" />
        <KeyBinding Command="{Binding Refresh}" Gesture="Ctrl+R" />
    </UserControl.KeyBindings>

    <Panel>
        <ScrollViewer>
            <StackPanel Margin="24,12,24,24" Spacing="16">
                <Grid ColumnDefinitions="Auto,16,*">
                    <Panel Width="64" Height="64">
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="32"
                                IsVisible="{Binding Profile.AvatarUrl.Value, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                            <icons:FluentIcon FontSize="28"
                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                              Icon="Person" />
                        </Border>
                        <asyncImageLoader:AdvancedImage ImageClipping.CornerRadius="32" Source="{Binding Profile.AvatarUrl.Value}" />
                    </Panel>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Spacing="2">
                        <TextBlock IsVisible="{Binding Profile.DisplayName.Value, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Text="{Binding Profile.DisplayName.Value}"
                                   TextTrimming="CharacterEllipsis"
                                   Theme="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock IsVisible="{Binding Profile.DisplayName.Value, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                   Text="{Binding Profile.Name}"
                                   TextTrimming="CharacterEllipsis"
                                   Theme="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   IsVisible="{Binding Profile.DisplayName.Value, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Text="{Binding Profile.Name}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <TextBlock IsVisible="{Binding Profile.Biography.Value, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Text="{Binding Profile.Biography.Value}"
                           TextWrapping="Wrap" />

                <TextBlock Margin="0,8,0,0"
                           Text="{x:Static lang:ExtensionsStrings.Profile_PublishedPackages}"
                           Theme="{StaticResource BodyStrongTextBlockStyle}" />

                <ItemsRepeater ItemTemplate="{StaticResource PackageCardTemplate}" ItemsSource="{Binding Packages}">
                    <ItemsRepeater.Layout>
                        <controls:HorizontalGridLayout ColumnSpacing="12"
                                                       MinItemWidth="300"
                                                       RowSpacing="12" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing IsIndeterminate="{CompiledBinding IsBusy.Value}" IsVisible="{CompiledBinding IsBusy.Value}" />
    </Panel>
</UserControl>
