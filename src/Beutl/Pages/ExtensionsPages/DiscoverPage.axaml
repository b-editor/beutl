<UserControl x:Class="Beutl.Pages.ExtensionsPages.DiscoverPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Beutl.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Beutl.Language"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModel="using:Beutl.ViewModels.ExtensionsPages"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:CompileBindings="True"
             x:DataType="viewModel:DiscoverPageViewModel"
             Focusable="True"
             RenderOptions.BitmapInterpolationMode="HighQuality"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Beutl/Pages/ExtensionsPages/PackageCards.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.KeyBindings>
        <KeyBinding Command="{Binding Refresh}" Gesture="F5" />
        <KeyBinding Command="{Binding Refresh}" Gesture="Ctrl+R" />
    </UserControl.KeyBindings>

    <Panel>
        <ScrollViewer>
            <StackPanel Margin="24,12,24,24" Spacing="16">
                <TabStrip HorizontalAlignment="Left"
                          IsEnabled="{Binding !IsBusy.Value}"
                          SelectedIndex="{Binding Kind.SelectedIndex.Value, Mode=TwoWay}"
                          Theme="{DynamicResource SegmentedTabStrip}">
                    <TabStripItem Content="{x:Static lang:ExtensionsStrings.PackageKind_All}" />
                    <TabStripItem Content="{x:Static lang:ExtensionsStrings.PackageKind_Extensions}" />
                    <TabStripItem Content="{x:Static lang:ExtensionsStrings.PackageKind_Materials}" />
                    <TabStripItem Content="{x:Static lang:ExtensionsStrings.PackageKind_Templates}" />
                </TabStrip>

                <ItemsRepeater ItemTemplate="{StaticResource PackageCardTemplate}" ItemsSource="{Binding Items}">
                    <ItemsRepeater.Layout>
                        <controls:HorizontalGridLayout ColumnSpacing="12"
                                                       MinItemWidth="300"
                                                       RowSpacing="12" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing IsIndeterminate="{Binding IsBusy.Value}" IsVisible="{Binding IsBusy.Value}" />
    </Panel>
</UserControl>
