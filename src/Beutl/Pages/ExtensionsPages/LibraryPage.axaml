<UserControl x:Class="Beutl.Pages.ExtensionsPages.LibraryPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:asyncImageLoader="using:AsyncImageLoader"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:lang="using:Beutl.Language"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:viewModel="using:Beutl.ViewModels.ExtensionsPages"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:CompileBindings="True"
             x:DataType="viewModel:LibraryPageViewModel"
             Focusable="True"
             IsEnabled="{Binding !IsBusy.Value}"
             mc:Ignorable="d">

    <UserControl.Styles>
        <Style Selector="Button.action">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.shimmer">
            <Setter Property="IsEnabled" Value="False" />
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.6" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="1.0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.6" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <UserControl.KeyBindings>
        <KeyBinding Command="{Binding Refresh}" Gesture="F5" />
        <KeyBinding Command="{Binding Refresh}" Gesture="Ctrl+R" />
    </UserControl.KeyBindings>

    <UserControl.Resources>
        <DataTemplate x:Key="UserPackageItemTemplate">
            <ContentControl Content="{ReflectionBinding}">
                <ContentControl.DataTemplates>
                    <DataTemplate x:DataType="viewModel:IUserPackageViewModel">
                        <Button Padding="12"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                Click="Package_Click">
                            <Grid ColumnDefinitions="Auto,12,*,12,Auto,4,Auto">
                                <Panel Width="40" Height="40">
                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="6"
                                            IsVisible="{Binding LogoUrl.Value, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                        <icons:FluentIcon FontSize="20"
                                                          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                          Icon="PuzzlePiece" />
                                    </Border>
                                    <asyncImageLoader:AdvancedImage ImageClipping.CornerRadius="6" Source="{Binding LogoUrl.Value}" />
                                </Panel>

                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                    <TextBlock FontWeight="SemiBold"
                                               IsVisible="{Binding DisplayName.Value, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               Text="{Binding DisplayName.Value}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontWeight="SemiBold"
                                               IsVisible="{Binding DisplayName.Value, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding Publisher}"
                                               TextTrimming="CharacterEllipsis"
                                               Theme="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>

                                <!--  The buttons share one cell and hide with the transparent class, so the cell keeps its width as the state changes.  -->
                                <Button Grid.Column="4"
                                        Classes="action"
                                        Classes.shimmer="{Binding IsBusy.Value}"
                                        Classes.transparent="{Binding !IsInstallButtonVisible.Value}"
                                        Click="ActionButton_Click"
                                        Command="{Binding Install}"
                                        Content="{Binding StatusText.Value, TargetNullValue={x:Static lang:ExtensionsStrings.Install}}" />

                                <Button Grid.Column="4"
                                        Classes="action"
                                        Classes.shimmer="{Binding IsBusy.Value}"
                                        Classes.transparent="{Binding !IsUninstallButtonVisible.Value}"
                                        Click="ActionButton_Click"
                                        Command="{Binding Uninstall}"
                                        Content="{Binding StatusText.Value, TargetNullValue={x:Static lang:ExtensionsStrings.Uninstall}}" />

                                <Button Grid.Column="4"
                                        Classes="action accent"
                                        Classes.shimmer="{Binding IsBusy.Value}"
                                        Classes.transparent="{Binding !IsUpdateButtonVisible.Value}"
                                        Click="ActionButton_Click"
                                        Command="{Binding Update}"
                                        Content="{Binding StatusText.Value, TargetNullValue={x:Static lang:ExtensionsStrings.Update}}" />

                                <Button Grid.Column="4"
                                        Classes="action"
                                        Classes.shimmer="{Binding IsBusy.Value}"
                                        Classes.transparent="{Binding !IsBusy.Value}"
                                        Content="{Binding StatusText.Value}"
                                        IsHitTestVisible="False" />

                                <Button Grid.Column="4"
                                        Classes="action"
                                        Classes.transparent="{Binding !CanCancel.Value}"
                                        Click="ActionButton_Click"
                                        Command="{Binding Cancel}"
                                        Content="{x:Static lang:Strings.Cancel}" />

                                <Button Grid.Column="6"
                                        Click="Overflow_Click"
                                        Theme="{StaticResource TransparentButton}">
                                    <Button.ContextFlyout>
                                        <ui:FAMenuFlyout>
                                            <ui:FAMenuFlyoutItem Command="{Binding Install}"
                                                                 IsEnabled="{Binding IsInstallButtonVisible.Value}"
                                                                 Text="{x:Static lang:ExtensionsStrings.Install}" />
                                            <ui:FAMenuFlyoutItem Command="{Binding Uninstall}"
                                                                 IsEnabled="{Binding IsUninstallButtonVisible.Value}"
                                                                 Text="{x:Static lang:ExtensionsStrings.Uninstall}" />
                                            <ui:FAMenuFlyoutItem Command="{Binding Update}"
                                                                 IsEnabled="{Binding IsUpdateButtonVisible.Value}"
                                                                 Text="{x:Static lang:ExtensionsStrings.Update}" />
                                            <ui:FAMenuFlyoutItem Command="{ReflectionBinding RemoveFromLibrary}"
                                                                 IsVisible="{Binding IsRemote}"
                                                                 Text="{x:Static lang:ExtensionsStrings.RemoveFromLibrary}" />
                                        </ui:FAMenuFlyout>
                                    </Button.ContextFlyout>
                                    <icons:FluentIcon FontSize="20" Icon="MoreHorizontal" />
                                </Button>
                            </Grid>
                        </Button>
                    </DataTemplate>
                    <DataTemplate x:DataType="viewModel:DummyItem">
                        <Button Padding="12"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                IsHitTestVisible="False">
                            <Grid ColumnDefinitions="Auto,12,*">
                                <Border Width="40"
                                        Height="40"
                                        Classes="placeholder"
                                        CornerRadius="6" />

                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Spacing="6">
                                    <Border Width="120"
                                            Height="14"
                                            HorizontalAlignment="Left"
                                            Classes="placeholder"
                                            CornerRadius="7" />
                                    <Border Width="72"
                                            Height="12"
                                            HorizontalAlignment="Left"
                                            Classes="placeholder"
                                            CornerRadius="6" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </DataTemplate>
    </UserControl.Resources>

    <Panel>
        <ScrollViewer>
            <StackPanel Margin="24,12,24,24" Spacing="16">
                <Grid ColumnDefinitions="*,Auto">
                    <TabStrip HorizontalAlignment="Left"
                              SelectedIndex="0"
                              Theme="{DynamicResource SegmentedTabStrip}">
                        <TabStripItem x:Name="packagesTab" Content="{x:Static lang:ExtensionsStrings.Search_Packages}" />
                        <TabStripItem x:Name="localPackagesTab" Content="{x:Static lang:ExtensionsStrings.LocalPackages}" />
                    </TabStrip>

                    <Button Grid.Column="1"
                            Command="{Binding CheckUpdate}"
                            Content="{x:Static lang:ExtensionsStrings.CheckUpdate}" />
                </Grid>

                <ItemsRepeater IsVisible="{Binding #packagesTab.IsSelected}"
                               ItemTemplate="{StaticResource UserPackageItemTemplate}"
                               ItemsSource="{Binding Packages}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>

                <ItemsRepeater IsVisible="{Binding #localPackagesTab.IsSelected}"
                               ItemTemplate="{StaticResource UserPackageItemTemplate}"
                               ItemsSource="{Binding LocalPackages}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing IsIndeterminate="{CompiledBinding IsBusy.Value}" IsVisible="{CompiledBinding IsBusy.Value}" />
    </Panel>
</UserControl>
