<UserControl x:Class="Beutl.Views.MainView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:lang="using:Beutl.Language"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:tutorial="using:Beutl.Views.Tutorial"
             xmlns:views="using:Beutl.Views"
             xmlns:vm="using:Beutl.ViewModels"
             xmlns:wnd="using:FluentAvalonia.UI.Windowing"
             Padding="0"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:CompileBindings="True"
             x:DataType="vm:MainViewModel"
             Focusable="True"
             mc:Ignorable="d">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,1,*">
        <Grid x:Name="Titlebar"
              Background="Transparent"
              ColumnDefinitions="Auto,Auto,*,Auto">
            <Image Name="WindowIcon"
                   MaxWidth="24"
                   MaxHeight="24"
                   Margin="8,0"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapInterpolationMode="HighQuality"
                   Source="avares://Beutl.Controls/Assets/logo.ico">
                <Image.Clip>
                    <EllipseGeometry RadiusX="12"
                                     RadiusY="12"
                                     Rect="0,0,24,24" />
                </Image.Clip>
            </Image>

            <Menu x:Name="MenuBar"
                  Grid.Column="1"
                  WindowDecorationProperties.ElementRole="User" />

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8">
                <views:TitleBreadcrumbBar Name="TitleBreadcrumbBar"
                                          Margin="8,0,0,0"
                                          MinWidth="0"
                                          WindowDecorationProperties.ElementRole="User"
                                          DataContext="{Binding TitleBreadcrumbBar}" />
                <views:TitleBarBranchView x:Name="TitleBarBranchWidget"
                                          VerticalAlignment="Center"
                                          WindowDecorationProperties.ElementRole="User"
                                          DataContext="{Binding TitleBarBranch}" />
            </StackPanel>

            <StackPanel x:Name="TitlebarActions"
                        Grid.Column="3"
                        Margin="0,0,4,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8">
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           IsVisible="{CompiledBinding IsDebuggerAttached}"
                           Text="{x:Static lang:Strings.Debug}" />

                <Button WindowDecorationProperties.ElementRole="User"
                        Click="OpenFeedbackClick"
                        ToolTip.Tip="{x:Static lang:Strings.Feedback}"
                        Theme="{StaticResource TitleBarButtonStyle}">
                    <icons:FluentIcon Icon="Chat" Margin="0,0,0,2" />
                </Button>

                <views:TitleBarStatusView WindowDecorationProperties.ElementRole="User"
                                          DataContext="{Binding Status}" />

                <Button x:Name="OpenNotificationsButton"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        WindowDecorationProperties.ElementRole="User"
                        Theme="{StaticResource TitleBarButtonStyle}">
                    <Button.Flyout>
                        <Flyout FlyoutPresenterTheme="{StaticResource CompactFlyoutPresenterTheme}">
                            <ScrollViewer>
                                <StackPanel x:Name="HiddenNotificationPanel" Spacing="4" />
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                    <Panel>
                        <icons:FluentIcon HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Icon="Alert" />
                        <ui:FAInfoBadge Width="8"
                                      Height="8"
                                      Margin="0,4,4,0"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      IsVisible="{Binding !!#HiddenNotificationPanel.Children.Count}" />
                    </Panel>
                </Button>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource TitleBarBottomBorderBrush}" />

        <views:EditorHostView Name="EditorHost"
                              Grid.Row="2"
                              DataContext="{Binding EditorHost.SelectedTabItem.Value.Context.Value}"
                              IsEnabled="{Binding !#ProjectLifecycleOverlay.IsVisible}"
                              IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}" />

        <views:EditorHostFallback Grid.Row="2"
                                  IsEnabled="{Binding !#ProjectLifecycleOverlay.IsVisible}"
                                  IsVisible="{Binding EditorHost.SelectedTabItem.Value.Context.Value, Converter={x:Static ObjectConverters.IsNull}}" />

        <!-- Covers the editor area while a project is created or closed with Git, or starts being tracked
             with Git, so an editor that is waiting on Git never looks usable. -->
        <Border x:Name="ProjectLifecycleOverlay"
                Grid.Row="2"
                Background="{DynamicResource MainWindowBackground}"
                IsVisible="{Binding EditorHost.LifecycleProgress.Value, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel MaxWidth="560"
                        Margin="32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <ui:FAProgressRing Width="40"
                                   Height="40"
                                   HorizontalAlignment="Center"
                                   IsIndeterminate="{Binding #ProjectLifecycleOverlay.IsVisible}" />
                <TextBlock x:Name="ProjectLifecycleTitle"
                           HorizontalAlignment="Center"
                           Text="{Binding EditorHost.LifecycleProgress.Value.Title}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Theme="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="ProjectLifecycleMessage"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding EditorHost.LifecycleProgress.Value.Message}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel x:Name="NotificationPanel"
                    Grid.RowSpan="3"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Spacing="4">
            <StackPanel.Styles>
                <Style Selector="ui|FAInfoBar">
                    <Style Selector="^">
                        <Style.Animations>
                            <Animation FillMode="Forward" Duration="00:00:00.250">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0.0" />
                                    <Setter Property="ScaleTransform.ScaleX" Value="1.05" />
                                    <Setter Property="ScaleTransform.ScaleY" Value="1.05" />
                                </KeyFrame>
                                <KeyFrame Cue="100%" KeySpline="0,0 0,1">
                                    <Setter Property="Opacity" Value="1.0" />
                                    <Setter Property="ScaleTransform.ScaleX" Value="1.00" />
                                    <Setter Property="ScaleTransform.ScaleY" Value="1.00" />
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                    <Style Selector="^:hidden">
                        <Style.Animations>
                            <Animation FillMode="Backward" Duration="00:00:00.167">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="1.0" />
                                    <Setter Property="ScaleTransform.ScaleX" Value="1.00" />
                                    <Setter Property="ScaleTransform.ScaleY" Value="1.00" />
                                </KeyFrame>
                                <KeyFrame Cue="100%" KeySpline="0,0 0,1">
                                    <Setter Property="Opacity" Value="0.0" />
                                    <Setter Property="ScaleTransform.ScaleX" Value="1.05" />
                                    <Setter Property="ScaleTransform.ScaleY" Value="1.05" />
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>

                        <Style Selector="^ /template/ Border#ContentRoot">
                            <Setter Property="IsVisible" Value="True" />
                        </Style>

                    </Style>
                </Style>
            </StackPanel.Styles>
        </StackPanel>

        <tutorial:TutorialOverlay x:Name="TutorialOverlayPanel"
                                  Grid.RowSpan="3" />

        <views:CommandPaletteView Grid.RowSpan="3"
                                  DataContext="{Binding CommandPalette}" />
        <views:TabSwitcherView x:Name="TabSwitcherOverlay"
                               Grid.RowSpan="3"
                               DataContext="{Binding TabSwitcher}" />
    </Grid>

</UserControl>
