<UserControl x:Class="Beutl.Views.PlayerView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:live="using:Beutl.Controls"
             xmlns:controls="using:Beutl.Controls"
             xmlns:converters="clr-namespace:Beutl.Converters;assembly=Beutl"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:lang="using:Beutl.Language"
             xmlns:local="using:Beutl.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pathEditor="using:Beutl.Editor.Components.PathEditorTab.Views"
             xmlns:vm="using:Beutl.ViewModels"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:CompileBindings="True"
             x:DataType="vm:PlayerViewModel"
             mc:Ignorable="d">
    <Player x:Name="Player"
            Margin="4"
            CurrentTime="{Binding CurrentFrame.Value, Converter={x:Static converters:MediaTimeToTimeSpanConverter.Instance}, StringFormat={}{0:hh\\:mm\\:ss\\.ff}}"
            EndButtonCommand="{Binding End}"
            IsPlaying="{Binding IsPlaying.Value, Mode=OneWay}"
            IsLoopEnabled="{Binding IsLoopEnabled.Value, Mode=TwoWay}"
            Maximum="{Binding Duration.Value, Converter={x:Static converters:MediaTimeToSecondsConverter.Instance}}"
            NextButtonCommand="{Binding Next}"
            PlayButtonCommand="{Binding PlayPause}"
            PreviousButtonCommand="{Binding Previous}"
            StartButtonCommand="{Binding Start}"
            Value="{Binding CurrentFrame.Value, Converter={x:Static converters:MediaTimeToSecondsConverter.Instance}}"
            Duration="{Binding Duration.Value, Converter={x:Static converters:MediaTimeToTimeSpanConverter.Instance}, StringFormat={}{0:hh\\:mm\\:ss\\.ff}}">
        <Player.InnerLeftContent>
            <StackPanel>
                <StackPanel.Styles>
                    <Style Selector="RadioButton">
                        <Setter Property="Theme" Value="{StaticResource LiteNavVerticalRadioButton}" />
                        <Setter Property="Padding" Value="7,6,5,6" />
                    </Style>
                </StackPanel.Styles>
                <RadioButton AutomationProperties.Name="{x:Static lang:Strings.Move}" IsChecked="{Binding IsMoveMode.Value}" ToolTip.Tip="{x:Static lang:Strings.Move}">
                    <icons:FluentIcon Icon="Cursor" />
                </RadioButton>
                <RadioButton AutomationProperties.Name="{x:Static lang:Strings.Hand}" IsChecked="{Binding IsHandMode.Value}" ToolTip.Tip="{x:Static lang:Strings.Hand}">
                    <icons:FluentIcon Icon="HandLeft" />
                </RadioButton>
                <RadioButton AutomationProperties.Name="{x:Static lang:Strings.CropSelection}" IsChecked="{Binding IsCropMode.Value}" ToolTip.Tip="{x:Static lang:Strings.CropSelection}">
                    <icons:FluentIcon Icon="Crop" />
                </RadioButton>
                <RadioButton AutomationProperties.Name="{x:Static lang:Strings.Camera3DControl}" IsChecked="{Binding IsCameraMode.Value}" ToolTip.Tip="{x:Static lang:Strings.Camera3DControl}">
                    <icons:FluentIcon Icon="Video" />
                </RadioButton>
                <!--  Gizmo Mode Selection  -->
                <Border Margin="0,8,0,0"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        IsVisible="{Binding IsCameraMode.Value}" />
                <RadioButton Margin="0,8,0,0"
                             GroupName="GizmoMode"
                             IsChecked="{Binding SelectedGizmoMode.Value, Converter={x:Static converters:GizmoModeConverters.IsTranslate}}"
                             IsVisible="{Binding IsCameraMode.Value}"
                             AutomationProperties.Name="{x:Static lang:Strings.Gizmo_Translate}"
                             ToolTip.Tip="{x:Static lang:Strings.Gizmo_Translate}">
                    <icons:FluentIcon Icon="ArrowMove" />
                </RadioButton>
                <RadioButton GroupName="GizmoMode"
                             IsChecked="{Binding SelectedGizmoMode.Value, Converter={x:Static converters:GizmoModeConverters.IsRotate}}"
                             IsVisible="{Binding IsCameraMode.Value}"
                             AutomationProperties.Name="{x:Static lang:Strings.Gizmo_Rotate}"
                             ToolTip.Tip="{x:Static lang:Strings.Gizmo_Rotate}">
                    <icons:FluentIcon Icon="ArrowRotateClockwise" />
                </RadioButton>
                <RadioButton GroupName="GizmoMode"
                             IsChecked="{Binding SelectedGizmoMode.Value, Converter={x:Static converters:GizmoModeConverters.IsScale}}"
                             IsVisible="{Binding IsCameraMode.Value}"
                             AutomationProperties.Name="{x:Static lang:Strings.Gizmo_Scale}"
                             ToolTip.Tip="{x:Static lang:Strings.Gizmo_Scale}">
                    <icons:FluentIcon Icon="ArrowExpand" />
                </RadioButton>
                <Border Margin="0,8,0,0"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        IsVisible="{Binding PathEditor.Context.Value, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <RadioButton Margin="0,8,0,0"
                             Click="ToggleDragModeClick"
                             GroupName="PathEditor_DragMode"
                             IsChecked="{Binding PathEditor.Symmetry.Value, Mode=OneWay}"
                             IsVisible="{Binding PathEditor.Context.Value, Converter={x:Static ObjectConverters.IsNotNull}}"
                             Tag="Symmetry"
                             AutomationProperties.Name="{x:Static lang:Strings.Symmetry}"
                             ToolTip.Tip="{x:Static lang:Strings.Symmetry}">
                    <Border VerticalAlignment="Center">
                        <Path Width="16"
                              VerticalAlignment="Center"
                              Data="{StaticResource PathEditor_Symmetry}"
                              Fill="{DynamicResource TextFillColorPrimaryBrush}"
                              Stretch="Uniform" />
                    </Border>
                </RadioButton>
                <RadioButton Click="ToggleDragModeClick"
                             GroupName="PathEditor_DragMode"
                             IsChecked="{Binding PathEditor.Asymmetry.Value, Mode=OneWay}"
                             IsVisible="{Binding PathEditor.Context.Value, Converter={x:Static ObjectConverters.IsNotNull}}"
                             Tag="Asymmetry"
                             AutomationProperties.Name="{x:Static lang:Strings.Asymmetry}"
                             ToolTip.Tip="{x:Static lang:Strings.Asymmetry}">
                    <Border VerticalAlignment="Center">
                        <Path Width="16"
                              VerticalAlignment="Center"
                              Data="{StaticResource PathEditor_Asymmetry}"
                              Fill="{DynamicResource TextFillColorPrimaryBrush}"
                              Stretch="Uniform" />
                    </Border>
                </RadioButton>
                <RadioButton Click="ToggleDragModeClick"
                             GroupName="PathEditor_DragMode"
                             IsChecked="{Binding PathEditor.Separately.Value, Mode=OneWay}"
                             IsVisible="{Binding PathEditor.Context.Value, Converter={x:Static ObjectConverters.IsNotNull}}"
                             Tag="Separately"
                             AutomationProperties.Name="{x:Static lang:Strings.Separately}"
                             ToolTip.Tip="{x:Static lang:Strings.Separately}">
                    <Border VerticalAlignment="Center">
                        <Path Width="16"
                              VerticalAlignment="Center"
                              Data="{StaticResource PathEditor_Separately}"
                              Fill="{DynamicResource TextFillColorPrimaryBrush}"
                              Stretch="Uniform" />
                    </Border>
                </RadioButton>
            </StackPanel>
        </Player.InnerLeftContent>
        <Player.InnerRightContent>
            <StackPanel>
                <Button Padding="5,6,5,6"
                        Click="OnPresentationClick"
                        Theme="{StaticResource TransparentButton}"
                        AutomationProperties.Name="{x:Static lang:Strings.PresentationWindow}"
                        ToolTip.Tip="{x:Static lang:Strings.PresentationWindow}">
                    <icons:FluentIcon Icon="Desktop" />
                </Button>
                <Button Padding="5,6,5,6"
                        VerticalAlignment="Top"
                        Command="{Binding OpenPreviewSettings}"
                        Theme="{StaticResource TransparentButton}"
                        AutomationProperties.Name="{x:Static lang:Strings.PreviewSettings}"
                        ToolTip.Tip="{x:Static lang:Strings.PreviewSettings}">
                    <icons:FluentIcon Icon="Settings" />
                </Button>
            </StackPanel>
        </Player.InnerRightContent>
        <Player.Content>
            <Grid>
                <Panel Name="framePanel"
                       Margin="0"
                       Background="Transparent">
                    <Border Name="imageBackground"
                            Background="Black"
                            ClipToBounds="True" />

                    <!-- BitmapView or HdrBitmapView is created dynamically in code-behind -->

                    <local:PreviewGuideOverlay Name="guideOverlay" />

                    <pathEditor:PathEditorView Name="pathEditorView"
                                               DataContext="{Binding PathEditor}" />

                    <local:TransformHandlesOverlay Name="transformHandlesOverlay"
                                                   IsVisible="False" />
                </Panel>

                <Panel Name="pathToolsHost" />

                <!-- Keep the error outside framePanel so preview pan/zoom does not transform it. -->
                <Border Name="previewRenderErrorOverlay"
                        Padding="24"
                        Background="{DynamicResource SmokeFillColorDefaultBrush}"
                        IsHitTestVisible="False"
                        IsVisible="{Binding PreviewRenderError.Value,
                                            Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <Border MaxWidth="480"
                            Padding="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                            BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <StackPanel Spacing="8">
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       Text="{x:Static lang:MessageStrings.UnexpectedError}" />
                            <live:SafeLiveRegionTextBlock Name="previewRenderErrorMessage"
                                       HorizontalAlignment="Center"
                                       AutomationProperties.LiveSetting="Assertive"
                                       AutomationProperties.Name="{Binding PreviewRenderError.Value}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="{Binding PreviewRenderError.Value}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Player.Content>
    </Player>
</UserControl>
