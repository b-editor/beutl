<UserControl x:Class="Beutl.Views.TitleBarBranchView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:lang="using:Beutl.Language"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Beutl.Editor.Components.VersionControl.ViewModels"
             d:DesignHeight="36"
             d:DesignWidth="180"
             x:CompileBindings="True"
             x:DataType="vm:TitleBarBranchViewModel"
             IsVisible="{Binding IsVisible.Value}"
             mc:Ignorable="d">
    <Button x:Name="TitleBarBranchButton"
            Width="NaN"
            MinWidth="0"
            Padding="8,4"
            HorizontalContentAlignment="Stretch"
            Theme="{StaticResource TitleBarButtonStyle}"
            ToolTip.Tip="{Binding AheadBehindText.Value}">
        <Button.Flyout>
            <Flyout Opening="OnBranchFlyoutOpening">
                <StackPanel MinWidth="220" MaxWidth="360" Spacing="4">
                    <TextBlock x:Name="CurrentBranchHeader"
                               Margin="8,4"
                               FontWeight="SemiBold"
                               Text="{Binding CurrentBranchText.Value}"
                               TextTrimming="CharacterEllipsis" />
                    <ItemsControl x:Name="BranchList" ItemsSource="{Binding Branches}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TitleBarBranchItemViewModel">
                                <Button HorizontalContentAlignment="Stretch"
                                        Click="OnBranchClick"
                                        IsEnabled="{Binding CanSwitch.Value}">
                                    <Grid ColumnDefinitions="20,*">
                                        <TextBlock x:Name="CurrentBranchMark"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding IsCurrent}"
                                                   Text="✓" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Separator Margin="0,4" />
                    <Button HorizontalContentAlignment="Left"
                            Command="{Binding CreateBranchCommand}"
                            Content="{x:Static lang:Strings.VersionControl_NewBranch}" />
                </StackPanel>
            </Flyout>
        </Button.Flyout>
        <StackPanel Orientation="Horizontal" Spacing="5">
            <icons:FluentIcon VerticalAlignment="Center" Icon="BranchFork" />
            <TextBlock MaxWidth="220"
                       VerticalAlignment="Center"
                       Text="{Binding DisplayText.Value}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Button>
</UserControl>
