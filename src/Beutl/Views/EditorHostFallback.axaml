<UserControl x:Class="Beutl.Views.EditorHostFallback"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:Beutl.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:lang="using:Beutl.Language"
             xmlns:local="using:Beutl.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sysIO="using:System.IO"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:xaml="using:Avalonia.Markup.Xaml.MarkupExtensions"
             d:DesignHeight="720"
             d:DesignWidth="1280"
             mc:Ignorable="d">
    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.ColumnSpan="2"
                    Margin="32"
                    Spacing="8">
            <TextBlock Text="{x:Static lang:Strings.StartEditing}" Theme="{StaticResource SubtitleTextBlockStyle}" />

            <WrapPanel Margin="-4" Orientation="Horizontal">
                <OptionsDisplayItem x:Name="createNewButton"
                                    Margin="4"
                                    Description="{x:Static lang:Strings.CreateNewProjectOrScene}"
                                    Header="{x:Static lang:Strings.CreateNew}"
                                    Navigates="True"
                                    NavigationRequested="OpenContext">
                    <OptionsDisplayItem.Icon>
                        <icons:FluentIcon Icon="New" />
                    </OptionsDisplayItem.Icon>
                    <OptionsDisplayItem.ContextFlyout>
                        <ui:FAMenuFlyout Placement="AnchorAndGravity"
                                         PlacementAnchor="BottomRight"
                                         PlacementGravity="BottomLeft">
                            <ui:FAMenuFlyoutItem Click="CreateNewProject_Click" Text="{x:Static lang:Strings.CreateNewProject}" />
                            <ui:FAMenuFlyoutItem Click="CreateNewScene_Click" Text="{x:Static lang:Strings.CreateNewScene}" />
                        </ui:FAMenuFlyout>
                    </OptionsDisplayItem.ContextFlyout>
                </OptionsDisplayItem>

                <OptionsDisplayItem Margin="4"
                                    Description="{x:Static lang:Strings.OpenAFileYouHaveAlreadyCreated}"
                                    Header="{x:Static lang:Strings.Open}"
                                    Navigates="True"
                                    NavigationRequested="OpenContext">
                    <OptionsDisplayItem.Icon>
                        <icons:FluentIcon Icon="Open" />
                    </OptionsDisplayItem.Icon>
                    <OptionsDisplayItem.ContextFlyout>
                        <ui:FAMenuFlyout Placement="AnchorAndGravity"
                                         PlacementAnchor="BottomRight"
                                         PlacementGravity="BottomLeft">
                            <ui:FAMenuFlyoutItem Click="OpenProject_Click" Text="{x:Static lang:Strings.Project}" />
                            <ui:FAMenuFlyoutItem Click="OpenFile_Click" Text="{x:Static lang:Strings.File}" />
                        </ui:FAMenuFlyout>
                    </OptionsDisplayItem.ContextFlyout>
                </OptionsDisplayItem>

                <OptionsDisplayItem Margin="4"
                                    Description="{x:Static lang:TutorialStrings.LearnBeutlBasics}"
                                    Header="{x:Static lang:TutorialStrings.StartTutorial}"
                                    Navigates="True"
                                    NavigationRequested="StartTutorial_Click">
                    <OptionsDisplayItem.Icon>
                        <icons:FluentIcon Icon="QuestionCircle" />
                    </OptionsDisplayItem.Icon>
                </OptionsDisplayItem>
            </WrapPanel>
        </StackPanel>

        <!-- The * column caps the panel at 600px while letting it shrink on narrow windows; the
             stretched wrapper keeps it left-anchored (MaxWidth on a stretched grid would centre it). -->
        <Grid Grid.Row="1" Margin="32,0,32,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="600" />
            </Grid.ColumnDefinitions>

            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,8,*">
                <TextBlock Text="{x:Static lang:Strings.Recently}" Theme="{StaticResource SubtitleTextBlockStyle}" />

                <ComboBox x:Name="FilterComboBox"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          SelectedIndex="1"
                          Theme="{StaticResource LiteComboBoxStyle}">
                    <ComboBoxItem Content="{x:Static lang:Strings.All}" />
                    <ComboBoxItem Content="{x:Static lang:Strings.Projects}" />
                    <ComboBoxItem Content="{x:Static lang:Strings.Files}" />
                </ComboBox>

                <ListBox x:Name="recentList"
                         Grid.Row="2"
                         Grid.ColumnSpan="2">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="ContextFlyout">
                                <ui:FAMenuFlyout x:DataType="sysIO:FileInfo">
                                    <ui:FAMenuFlyoutItem Click="DeleteRecentItem_Click" Text="{x:Static lang:Strings.Remove}" />
                                    <ui:FAMenuFlyoutItem Click="OpenRecentItem_Click" Text="{x:Static lang:Strings.Open}" />
                                    <!-- Only projects: deleting a scene on its own would leave its project unable to open. -->
                                    <ui:FAMenuFlyoutSeparator IsVisible="{CompiledBinding Converter={x:Static converters:ProjectFileConverters.IsProjectFile}}" />
                                    <ui:FAMenuFlyoutItem Click="DeleteRecentProjectFromDisk_Click"
                                                         Text="{x:Static lang:Strings.DeleteFromDisk}"
                                                         IsVisible="{CompiledBinding Converter={x:Static converters:ProjectFileConverters.IsProjectFile}}" />
                                </ui:FAMenuFlyout>
                            </Setter>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="sysIO:FileInfo">
                            <Grid Margin="0,4" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="{CompiledBinding Name}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                                    <TextBlock FontSize="12"
                                               Text="{CompiledBinding DirectoryName}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               Theme="{StaticResource LabelTextBlockStyle}" />
                                </StackPanel>
                                <ui:FAProgressRing Grid.Column="1"
                                                   Width="20"
                                                   Height="20"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   IsIndeterminate="{CompiledBinding $self.IsVisible}">
                                    <ui:FAProgressRing.IsVisible>
                                        <MultiBinding Converter="{x:Static converters:EqualAllConverter.Instance}">
                                            <xaml:CompiledBindingExtension Path="FullName" />
                                            <xaml:CompiledBindingExtension Path="$parent[local:EditorHostFallback].OpeningFile" />
                                        </MultiBinding>
                                    </ui:FAProgressRing.IsVisible>
                                </ui:FAProgressRing>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2"
                           IsVisible="{Binding !#recentList.ItemCount}"
                           Text="{x:Static lang:Strings.NoFilesUsedRecently}" />
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2"
                    Margin="32,0,0,0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    RenderOptions.BitmapInterpolationMode="HighQuality"
                    Spacing="8">
            <StackPanel.Styles>
                <Style Selector="Button">
                    <Setter Property="Padding" Value="8" />
                    <Setter Property="CornerRadius" Value="32" />
                    <Setter Property="Width" Value="40" />
                    <Setter Property="Height" Value="40" />
                </Style>
                <Style Selector="Image">
                    <Setter Property="Stretch" Value="Uniform" />
                </Style>
            </StackPanel.Styles>
            <Button Click="SocialClick"
                    AutomationProperties.Name="GitHub"
                    Tag="GitHub"
                    ToolTip.Tip="GitHub">
                <Image x:Name="githubLogo" RenderOptions.BitmapInterpolationMode="HighQuality" />
            </Button>
            <Button Click="SocialClick"
                    AutomationProperties.Name="X"
                    Tag="X"
                    ToolTip.Tip="X">
                <Image x:Name="xLogo"
                       Margin="2"
                       RenderOptions.BitmapInterpolationMode="HighQuality" />
            </Button>
            <Button Click="SocialClick"
                    AutomationProperties.Name="{x:Static lang:Strings.Website}"
                    Tag="Url"
                    ToolTip.Tip="{x:Static lang:Strings.Website}">
                <icons:FluentIcon Width="24"
                                  Height="24"
                                  FontSize="20"
                                  Icon="Link" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
