<UserControl x:Class="Beutl.Views.CommandPaletteView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Beutl.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Beutl.Language"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="using:Beutl.ViewModels"
             d:DesignHeight="480"
             d:DesignWidth="800"
             x:CompileBindings="True"
             x:DataType="viewModels:CommandPaletteViewModel"
             IsHitTestVisible="{Binding IsOpen.Value}"
             IsVisible="{Binding IsOpen.Value}"
             mc:Ignorable="d">
    <Panel>
        <!-- Light-dismiss backdrop -->
        <Border x:Name="Backdrop"
                Background="Transparent"
                IsHitTestVisible="True"
                PointerPressed="OnBackdropPointerPressed" />

        <!-- Palette container (Width はコードビハインドで TopLevel サイズに応じて動的設定) -->
        <Border x:Name="PaletteContainer"
                MaxHeight="480"
                Margin="16,80,16,16"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                BoxShadow="0 8 32 0 #40000000"
                CornerRadius="{DynamicResource OverlayCornerRadius}">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                <TextBlock Margin="16,12,16,0"
                           FontWeight="SemiBold"
                           IsVisible="{Binding IsPrompting.Value}"
                           Text="{Binding Prompt.Value.Title}"
                           TextTrimming="CharacterEllipsis" />

                <TextBox x:Name="QueryTextBox"
                         Grid.Row="1"
                         Margin="8,8,8,4"
                         BorderThickness="0"
                         FontSize="16"
                         Text="{Binding Query.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="{Binding Placeholder.Value}"
                         controls:TextBoxAttachment.EnterDownBehavior="None" />

                <StackPanel Grid.Row="2">
                    <StackPanel IsVisible="{Binding IsPrompting.Value}">
                        <TextBlock Margin="16,4,16,8"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   IsVisible="{Binding Prompt.Value.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}"
                                   Text="{Binding Prompt.Value.Message}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="ValidationMessage"
                                   Margin="16,4,16,8"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   IsVisible="{Binding Prompt.Value.ValidationError.Value, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}"
                                   Text="{Binding Prompt.Value.ValidationError.Value}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Margin="8,0"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1" />
                </StackPanel>

                <Panel Grid.Row="3" IsVisible="{Binding !IsPrompting.Value}">
                    <ListBox x:Name="ResultsListBox"
                             Margin="4,4,4,8"
                             Background="Transparent"
                             BorderThickness="0"
                             DoubleTapped="OnResultsDoubleTapped"
                             IsVisible="{Binding !HasNoResults.Value}"
                             ItemsSource="{Binding FilteredCommands}"
                             SelectedItem="{Binding SelectedCommand.Value, Mode=TwoWay}">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="8,6" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:CommandPaletteItemViewModel">
                                <Grid ColumnDefinitions="*,Auto"
                                      IsEnabled="{Binding IsEnabled}">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock MaxWidth="120"
                                                   HorizontalAlignment="Left"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   IsVisible="{Binding CategoryName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   Text="{Binding CategoryName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   Text="{Binding Description}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Padding="6,2"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource ControlAltFillColorSecondaryBrush}"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            IsVisible="{Binding KeyGestureText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Classes="shortcut"
                                                   FontSize="11"
                                                   Text="{Binding KeyGestureText}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Margin="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               IsVisible="{Binding HasNoResults.Value}"
                               Text="{x:Static lang:Strings.CommandPalette_NoResults}" />
                </Panel>

                <Panel Grid.Row="3" IsVisible="{Binding IsPrompting.Value}">
                    <ListBox x:Name="ChoicesListBox"
                             Margin="4,4,4,8"
                             Background="Transparent"
                             BorderThickness="0"
                             DoubleTapped="OnChoicesDoubleTapped"
                             IsVisible="{Binding Prompt.Value.IsPick}"
                             ItemsSource="{Binding Prompt.Value.FilteredChoices}"
                             SelectedItem="{Binding Prompt.Value.SelectedChoice.Value, Mode=TwoWay}">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="8,6" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:CommandPaletteChoiceViewModel">
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding Label}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               Text="{Binding Description}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Margin="16"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               IsVisible="{Binding Prompt.Value.HasNoResults.Value}"
                               Text="{x:Static lang:Strings.CommandPalette_NoChoices}" />
                </Panel>

                <StackPanel Grid.Row="4"
                            Margin="12,8,12,12"
                            HorizontalAlignment="Right"
                            IsVisible="{Binding IsPrompting.Value}"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Button Click="OnCancelClick"
                            Content="{x:Static lang:Strings.Cancel}" />
                    <Button x:Name="ConfirmButton"
                            Click="OnConfirmClick"
                            Content="{x:Static lang:Strings.OK}"
                            IsEnabled="{Binding Prompt.Value.CanConfirm.Value}" />
                </StackPanel>
            </Grid>
        </Border>
    </Panel>
</UserControl>
