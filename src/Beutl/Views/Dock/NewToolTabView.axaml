<UserControl x:Class="Beutl.Views.Dock.NewToolTabView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Beutl.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dockVm="using:Beutl.ViewModels.Dock"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:lang="using:Beutl.Language"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             d:DesignHeight="450"
             d:DesignWidth="320"
             x:CompileBindings="True"
             x:DataType="dockVm:NewToolTabDockable"
             mc:Ignorable="d">
    <UserControl.Resources>
        <DataTemplate x:Key="ToolTemplate" x:DataType="dockVm:NewToolTabItem">
            <Button AutomationProperties.Name="{Binding Header}"
                    Classes="tool"
                    Click="OnToolClick"
                    IsEnabled="{Binding IsEnabled}"
                    ToolTip.Tip="{Binding Header}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <ui:FAIconSourceElement Width="20"
                                            Height="20"
                                            VerticalAlignment="Center"
                                            IconSource="{Binding Icon}" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Text="{Binding Header}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.tool">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style Selector="Button.tool ui|FAIconSourceElement">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        </Style>
        <Style Selector="Button.tool:disabled ui|FAIconSourceElement">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Styles>

    <!--  A capped, centred column keeps a wide dock from scattering the tiles across the screen.  -->
    <Grid RowDefinitions="Auto,*">
        <!--  Enter opens the first match, so it must not move focus away first.  -->
        <TextBox x:Name="SearchBox"
                 MaxWidth="800"
                 Margin="16,16,16,8"
                 controls:TextBoxAttachment.EnterDownBehavior="None"
                 AutomationProperties.Name="{x:Static lang:Strings.NewToolTab_Search}"
                 Classes="clearButton"
                 InputMethod.IsInputMethodEnabled="True"
                 KeyDown="OnSearchBoxKeyDown"
                 PlaceholderText="{x:Static lang:Strings.NewToolTab_Search}"
                 Text="{Binding SearchText}">
            <TextBox.InnerLeftContent>
                <icons:FluentIcon Margin="10,0,0,0"
                                  FontSize="16"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Icon="Search" />
            </TextBox.InnerLeftContent>
        </TextBox>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="800"
                        Margin="16,8,16,16"
                        Spacing="8"
                        XYFocus.NavigationModes="Keyboard">
                <!--  Tiles reflow with the dock's width: one column in a side panel, up to three across a wide one.  -->
                <ItemsRepeater x:Name="AvailableList"
                               ItemTemplate="{StaticResource ToolTemplate}"
                               ItemsSource="{Binding AvailableItems}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout ItemsStretch="Fill"
                                           MinColumnSpacing="6"
                                           MinItemWidth="200"
                                           MinRowSpacing="6"
                                           Orientation="Horizontal" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>

                <TextBlock Margin="0,16"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           IsVisible="{Binding !HasMatches}"
                           Text="{x:Static lang:Strings.NewToolTab_NoResults}" />

                <!--  Open single-instance tools sit apart, so the grid above holds only what can be opened.  -->
                <TextBlock Margin="2,16,2,0"
                           Classes="section"
                           IsVisible="{Binding !!OpenItems.Count}"
                           Text="{x:Static lang:Strings.NewToolTab_AlreadyOpen}" />
                <ItemsRepeater x:Name="OpenList"
                               IsVisible="{Binding !!OpenItems.Count}"
                               ItemTemplate="{StaticResource ToolTemplate}"
                               ItemsSource="{Binding OpenItems}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout ItemsStretch="Fill"
                                           MinColumnSpacing="6"
                                           MinItemWidth="200"
                                           MinRowSpacing="6"
                                           Orientation="Horizontal" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
