<UserControl x:Class="Beutl.Views.Dock.NewToolTabView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Beutl.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dockVm="using:Beutl.ViewModels.Dock"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:lang="using:Beutl.Language"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             d:DesignHeight="450"
             d:DesignWidth="320"
             x:CompileBindings="True"
             x:DataType="dockVm:NewToolTabDockable"
             mc:Ignorable="d">
    <UserControl.Resources>
        <DataTemplate x:Key="ToolTemplate" x:DataType="dockVm:NewToolTabItem">
            <Button AutomationProperties.Name="{Binding Header}"
                    Classes="tool"
                    Click="OnToolClick"
                    IsEnabled="{Binding IsEnabled}"
                    Theme="{StaticResource TransparentButton}"
                    ToolTip.ShowOnDisabled="True"
                    ToolTip.Tip="{Binding Header}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Classes="icon">
                        <ui:FAIconSourceElement Width="18"
                                                Height="18"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IconSource="{Binding Icon}" />
                    </Border>
                    <!--  Narrow columns wrap a long name onto a second line instead of cutting it off.  -->
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               MaxLines="2"
                               Text="{Binding Header}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.tool">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <!--  The icon sits on a soft tile, which marks each row without boxing it in.  -->
        <Style Selector="Button.tool Border.icon">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Button.tool ui|FAIconSourceElement">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        </Style>
        <Style Selector="Button.tool:disabled ui|FAIconSourceElement">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Styles>

    <!--  A capped, centred column keeps a wide dock from scattering the tiles across the screen.  -->
    <Grid RowDefinitions="Auto,*">
        <!--  Enter opens the first match, so it must not move focus away first.  -->
        <TextBox x:Name="SearchBox"
                 MaxWidth="720"
                 Margin="16,16,16,12"
                 controls:TextBoxAttachment.EnterDownBehavior="None"
                 AutomationProperties.Name="{x:Static lang:Strings.NewToolTab_Search}"
                 Classes="clearButton"
                 InputMethod.IsInputMethodEnabled="True"
                 KeyDown="OnSearchBoxKeyDown"
                 PlaceholderText="{x:Static lang:Strings.NewToolTab_Search}"
                 Text="{Binding SearchText}">
            <TextBox.InnerLeftContent>
                <icons:FluentIcon Margin="10,0,0,0"
                                  FontSize="16"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Icon="Search" />
            </TextBox.InnerLeftContent>
        </TextBox>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="720"
                        Margin="16,0,16,16"
                        Spacing="8"
                        XYFocus.NavigationModes="Keyboard">
                <!--
                    Columns follow the page width: one in a side dock at its usual width, two when a
                    little wider, and at most three, so even a wide dock keeps room between them.
                    Every row is tall enough for two lines, so a wrapped name never changes its height.
                -->
                <ItemsRepeater x:Name="AvailableList"
                               ItemTemplate="{StaticResource ToolTemplate}"
                               ItemsSource="{Binding AvailableItems}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout ItemsStretch="Fill"
                                           MaximumRowsOrColumns="3"
                                           MinColumnSpacing="16"
                                           MinItemHeight="54"
                                           MinItemWidth="168"
                                           MinRowSpacing="2"
                                           Orientation="Horizontal" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>

                <TextBlock Margin="0,16"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           IsVisible="{Binding !HasMatches}"
                           Text="{x:Static lang:Strings.NewToolTab_NoResults}" />

                <!--  Open single-instance tools sit apart, so the grid above holds only what can be opened.  -->
                <TextBlock Margin="6,20,6,2"
                           Classes="section"
                           IsVisible="{Binding !!OpenItems.Count}"
                           Text="{x:Static lang:Strings.NewToolTab_AlreadyOpen}" />
                <ItemsRepeater x:Name="OpenList"
                               IsVisible="{Binding !!OpenItems.Count}"
                               ItemTemplate="{StaticResource ToolTemplate}"
                               ItemsSource="{Binding OpenItems}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout ItemsStretch="Fill"
                                           MaximumRowsOrColumns="3"
                                           MinColumnSpacing="16"
                                           MinItemHeight="54"
                                           MinItemWidth="168"
                                           MinRowSpacing="2"
                                           Orientation="Horizontal" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
