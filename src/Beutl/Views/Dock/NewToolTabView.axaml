<UserControl x:Class="Beutl.Views.Dock.NewToolTabView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Beutl.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dockVm="using:Beutl.ViewModels.Dock"
             xmlns:lang="using:Beutl.Language"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             d:DesignHeight="450"
             d:DesignWidth="320"
             x:CompileBindings="True"
             x:DataType="dockVm:NewToolTabDockable"
             mc:Ignorable="d">
    <UserControl.Styles>
        <!--  The tooltip is set by style, not locally, so the :disabled style below can replace it.  -->
        <Style x:DataType="dockVm:NewToolTabItem" Selector="Button.tool">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
            <!--  Narrow docks trim long names.  -->
            <Setter Property="ToolTip.Tip" Value="{Binding Header}" />
        </Style>
        <Style Selector="Button.tool:disabled">
            <Setter Property="ToolTip.Tip" Value="{x:Static lang:Strings.NewToolTab_AlreadyOpen}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <controls:ToolTabBar>
            <!--  Enter opens the first match, so it must not move focus away first.  -->
            <TextBox x:Name="SearchBox"
                     controls:TextBoxAttachment.EnterDownBehavior="None"
                     AutomationProperties.Name="{x:Static lang:Strings.NewToolTab_Search}"
                     Classes="clearButton"
                     InputMethod.IsInputMethodEnabled="True"
                     KeyDown="OnSearchBoxKeyDown"
                     PlaceholderText="{x:Static lang:Strings.NewToolTab_Search}"
                     Text="{Binding SearchText}" />
        </controls:ToolTabBar>

        <!--  Tiles reflow with the dock's width: one column in a side panel, a grid in the bottom panel.  -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <ItemsRepeater x:Name="ToolsList"
                           Margin="4"
                           ItemsSource="{Binding VisibleItems}"
                           XYFocus.NavigationModes="Keyboard">
                <ItemsRepeater.Layout>
                    <UniformGridLayout ItemsStretch="Fill"
                                       MinColumnSpacing="2"
                                       MinItemWidth="140"
                                       MinRowSpacing="2"
                                       Orientation="Horizontal" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="dockVm:NewToolTabItem">
                        <Button AutomationProperties.Name="{Binding Header}"
                                Classes="tool"
                                Click="OnToolClick"
                                IsEnabled="{Binding IsEnabled}"
                                Theme="{StaticResource TransparentButton}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <ui:FAIconSourceElement Width="16"
                                                        Height="16"
                                                        VerticalAlignment="Center"
                                                        IconSource="{Binding Icon}" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Text="{Binding Header}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <TextBlock Grid.Row="1"
                   Margin="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   IsVisible="{Binding !VisibleItems.Count}"
                   Text="{x:Static lang:Strings.NewToolTab_NoResults}" />
    </Grid>
</UserControl>
