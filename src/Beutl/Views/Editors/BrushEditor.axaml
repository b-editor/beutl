<UserControl x:Class="Beutl.Views.Editors.BrushEditor"
             xmlns="https://github.com/avaloniaui"
             xmlns:propertyEditors="using:Beutl.Editor.Components.PropertyEditors.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Beutl.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:intv="using:Avalonia.Xaml.Interactivity"
             xmlns:lang="using:Beutl.Language"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pe="using:Beutl.Controls.PropertyEditors"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Beutl.ViewModels.Editors"
             x:Name="root"
             d:DesignHeight="300"
             d:DesignWidth="300"
             x:CompileBindings="True"
             x:DataType="vm:BrushEditorViewModel"
             Brush="{Binding AvaloniaBrush.Value}"
             OriginalBrush="{Binding Value.Value}"
             mc:Ignorable="d">
    <Grid RowDefinitions="Auto,Auto">
        <ToggleButton x:Name="expandToggle"
                      Margin="8,4"
                      Classes="center-fill"
                      Content="{Binding Header, FallbackValue=Brush}"
                      IsChecked="{Binding IsExpanded.Value}"
                      IsVisible="{Binding !IsPresenter.Value}"
                      Theme="{DynamicResource PropertyEditorMiniExpanderToggleButton}"
                      ToolTip.Tip="{Binding HoverInfo.Value}">
            <ToggleButton.Tag>
                <Grid ColumnDefinitions="*,4,Auto">
                    <Button x:Name="BrushPreviewButton"
                            Width="{DynamicResource BrushEditorPreviewWidth}"
                            Height="24"
                            Padding="1"
                            HorizontalAlignment="Right"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Click="OpenFlyout_Click"
                            Theme="{StaticResource TransparentButton}">
                        <Panel>
                            <!--  Half a pixel tighter than ControlCornerRadius: the swatch sits inside the button's 1px padding.  -->
                            <Border Background="{StaticResource ColorControlCheckeredBackgroundBrush}" CornerRadius="7.5" />
                            <Border Background="{Binding AvaloniaBrush.Value}" CornerRadius="7.5" />
                        </Panel>
                    </Button>

                    <Button x:Name="ExpandMenuButton"
                            Grid.Column="2"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Classes="size-24x24"
                            Click="Menu_Click"
                            Theme="{StaticResource TransparentButton}">
                        <Button.ContextFlyout>
                            <ui:FAMenuFlyout Placement="Pointer" />
                        </Button.ContextFlyout>
                        <icons:FluentIcon Icon="Compose" />
                    </Button>
                </Grid>
            </ToggleButton.Tag>
        </ToggleButton>

        <pe:ReferenceEditor Header="{Binding Header, FallbackValue=Brush}"
                            IsVisible="{Binding IsPresenter.Value}"
                            SelectTargetRequested="SelectTarget_Requested"
                            ToolTip.Tip="{Binding HoverInfo.Value}"
                            TargetName="{Binding CurrentTargetName.Value}">
            <pe:ReferenceEditor.MenuContent>
                <Button x:Name="ReferenceMenuButton"
                        Margin="0,0,4,0"
                        Padding="0"
                        Classes="size-24x24"
                        Theme="{StaticResource TransparentButton}">
                    <Button.Flyout>
                        <ui:FAMenuFlyout Placement="Pointer" />
                    </Button.Flyout>
                    <icons:FluentIcon Icon="MoreVertical" />
                </Button>
            </pe:ReferenceEditor.MenuContent>
        </pe:ReferenceEditor>

        <controls:TreeLineDecorator x:Name="content"
                                    Grid.Row="1"
                                    IsVisible="{Binding !IsPresenter.Value}"
                                    LineBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <Panel>
                <TextBlock IsVisible="{Binding Value.Value, Converter={x:Static ObjectConverters.IsNull}}" Text="{x:Static lang:MessageStrings.PropertyUnset}" />

                <propertyEditors:PropertiesEditor Padding="0"
                                        DataContext="{Binding ChildContext.Value}"
                                        IsEnabled="{ReflectionBinding #root.DataContext.CanEdit.Value}">
                    <propertyEditors:PropertiesEditor.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Converter="{x:Static ObjectConverters.IsNotNull}"
                                     ElementName="root"
                                     Path="DataContext.Value.Value" />
                            <Binding Converter="{x:Static BoolConverters.Not}"
                                     ElementName="root"
                                     Path="DataContext.IsFallback.Value" />
                        </MultiBinding>
                    </propertyEditors:PropertiesEditor.IsVisible>
                </propertyEditors:PropertiesEditor>
            </Panel>
        </controls:TreeLineDecorator>
    </Grid>
</UserControl>
