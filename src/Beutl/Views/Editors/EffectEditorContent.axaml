<UserControl x:Class="Beutl.Views.Editors.EffectEditorContent"
             xmlns="https://github.com/avaloniaui"
             xmlns:propertyEditors="using:Beutl.Editor.Components.PropertyEditors.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Beutl.Controls"
             xmlns:lang="using:Beutl.Language">
    <Panel>
        <TextBlock Margin="16,0,0,0"
                   IsVisible="{Binding Value.Value, Converter={x:Static ObjectConverters.IsNull}}"
                   Text="{x:Static lang:MessageStrings.PropertyUnset}" />

        <controls:TreeLineDecorator LineBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <propertyEditors:PropertiesEditor Padding="0"
                                    DataContext="{Binding Properties.Value}" />
        </controls:TreeLineDecorator>

        <ItemsControl DataContext="{Binding Group.Value}" ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <propertyEditors:ListItemEditor />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Panel>
</UserControl>
