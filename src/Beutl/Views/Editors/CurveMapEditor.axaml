<UserControl x:Class="Beutl.Views.Editors.CurveMapEditor"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Beutl.Language"
             xmlns:local="using:Beutl.Views.Editors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Beutl.ViewModels.Editors"
             Margin="4,0"
             d:DesignWidth="300"
             x:CompileBindings="True"
             x:DataType="vm:CurveMapEditorViewModel"
             mc:Ignorable="d">
    <local:OpenInTabEditor Click="OpenCurvesTab_Click"
                           Icon="Edit"
                           Text="{x:Static lang:Strings.Curves}" />
</UserControl>
