<UserControl x:Class="Beutl.Views.Editors.EffectEditorHeaderButtons"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent">
    <StackPanel Orientation="Horizontal" Spacing="4">
        <ToggleButton Padding="0"
                      Classes="size-24x24"
                      IsChecked="{Binding IsEnabled.Value}"
                      IsEnabled="{Binding CanEditProperty.Value}"
                      IsVisible="{Binding !IsGroupOrNull.Value}"
                      Theme="{StaticResource VisibilityToggleButtonStyle}" />

        <Button Padding="0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Classes="size-24x24"
                Click="OnButtonClick"
                Theme="{StaticResource TransparentButton}">
            <icons:FluentIcon Classes.add="{Binding IsGroup.Value}">
                <icons:FluentIcon.Styles>
                    <Style Selector="icons|FluentIcon">
                        <Setter Property="Icon" Value="Compose" />
                    </Style>
                    <Style Selector="icons|FluentIcon.add">
                        <Setter Property="Icon" Value="Add" />
                    </Style>
                </icons:FluentIcon.Styles>
            </icons:FluentIcon>
        </Button>
    </StackPanel>
</UserControl>
