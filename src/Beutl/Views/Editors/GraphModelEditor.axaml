<UserControl x:Class="Beutl.Views.Editors.GraphModelEditor"
             xmlns="https://github.com/avaloniaui"
             xmlns:propertyEditors="using:Beutl.Editor.Components.PropertyEditors.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Beutl.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Beutl.Language"
             xmlns:local="using:Beutl.Views.Editors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModel="using:Beutl.ViewModels.Editors"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:DataType="viewModel:GraphModelEditorViewModel"
             Background="Transparent"
             mc:Ignorable="d">
    <Grid RowDefinitions="Auto,Auto">
        <propertyEditors:OpenInTabEditor Margin="4,0"
                               Click="OpenNodeGraphTab_Click"
                               Icon="Flow"
                               Text="{x:Static lang:Strings.OpenInTab}" />

        <controls:TreeLineDecorator Grid.Row="1" LineBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <ItemsControl Margin="-16,0,0,0" ItemsSource="{Binding NodeMembers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:GraphModelNodeMemberView />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </controls:TreeLineDecorator>
    </Grid>
</UserControl>
