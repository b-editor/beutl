<ui:FAContentDialog x:Class="Beutl.Views.Dialogs.UpdateDialog"
                  xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:lang="using:Beutl.Language"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:ui="using:FluentAvalonia.UI.Controls"
                  xmlns:viewModels="clr-namespace:Beutl.ViewModels.Dialogs"
                  Title="{x:Static lang:Strings.Update}"
                  d:DesignHeight="450"
                  d:DesignWidth="800"
                  x:CompileBindings="True"
                  x:DataType="viewModels:UpdateDialogViewModel"
                  CloseButtonText="{Binding CloseButtonText.Value}"
                  IsPrimaryButtonEnabled="{Binding IsPrimaryButtonEnabled.Value}"
                  PrimaryButtonText="{Binding PrimaryButtonText.Value}"
                  IsSecondaryButtonEnabled="{Binding IsSecondaryButtonEnabled.Value}"
                  SecondaryButtonText="{Binding SecondaryButtonText.Value}"
                  mc:Ignorable="d">
    <ui:FAContentDialog.Resources>
        <!-- Wide enough for three buttons, whose labels are long in every language. -->
        <x:Double x:Key="ContentDialogMinWidth">560</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
    </ui:FAContentDialog.Resources>

    <StackPanel Spacing="8">
        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{Binding VersionText}"
                   Theme="{StaticResource CaptionTextBlockStyle}" />
        <!-- Selectable so the user can copy a command or an error message. -->
        <SelectableTextBlock Text="{Binding ProgressText.Value}" TextWrapping="Wrap" />
        <ProgressBar IsIndeterminate="{Binding IsIndeterminate.Value}"
                     Maximum="{Binding ProgressMax.Value}"
                     Value="{Binding ProgressValue.Value}" />
        <!-- Here rather than on the dialog's own buttons, which are fixed when it opens. -->
        <Button Command="{Binding Retry}"
                Content="{x:Static lang:MessageStrings.UpdateAction_Retry}"
                IsVisible="{Binding IsRetryVisible.Value}" />
    </StackPanel>
</ui:FAContentDialog>
