<Window x:Class="Beutl.Views.Dialogs.MissingMediaDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lang="using:Beutl.Language"
        xmlns:vm="using:Beutl.ViewModels.Dialogs"
        x:DataType="vm:MissingMediaDialogViewModel"
        x:CompileBindings="True"
        Title="{x:Static lang:MissingMediaStrings.Title}"
        Width="980" Height="620" MinWidth="760" MinHeight="440"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="12">
        <StackPanel Spacing="6">
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="{x:Static lang:MissingMediaStrings.Title}" />
            <TextBlock Text="{x:Static lang:MissingMediaStrings.Description}" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsEnabled="{Binding CanEdit.Value}">
            <TextBox Name="SearchDirectoryBox" PlaceholderText="{x:Static lang:MissingMediaStrings.SearchDirectory}"
                     Text="{Binding SearchDirectory.Value, Mode=TwoWay}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Name="SearchButton" Content="{x:Static lang:MissingMediaStrings.Search}" Click="SearchClick" />
                <Button Name="FindFolderButton" Content="{x:Static lang:MissingMediaStrings.FindInFolder}" Click="FindFolderClick" />
            </StackPanel>
        </Grid>
        <ProgressBar Grid.Row="2" Height="3" IsIndeterminate="True" IsVisible="{Binding IsBusy.Value}" />
        <ListBox Name="MissingMediaList" Grid.Row="3" ItemsSource="{Binding Rows}"
                 IsEnabled="{Binding CanEdit.Value}">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MissingMediaRowViewModel">
                    <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="12" Margin="0,6">
                        <TextBlock Name="MediaKindText" VerticalAlignment="Top" Text="{Binding Kind}" Opacity="0.7" />
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Name="MediaNameText" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Name="ExpectedPathText" Text="{Binding ExpectedLocation}" Opacity="0.65" FontSize="11"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ExpectedLocation}" />
                            <TextBlock Text="{Binding Elements}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ReplacementPath.Value}" FontSize="11" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding ReplacementPath.Value}" />
                            <TextBlock Text="{Binding Status.Value}" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="{x:Static lang:MissingMediaStrings.Replace}" Click="ReplaceClick" />
                                <Button Content="{x:Static lang:MissingMediaStrings.MatchFolder}" Click="MatchFolderClick" />
                            </StackPanel>
                            <CheckBox Content="{x:Static lang:MissingMediaStrings.KeepOffline}" IsChecked="{Binding IsOffline.Value, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Name="ErrorText" Grid.Row="4" Text="{Binding Error.Value}" TextWrapping="Wrap" MaxHeight="72" Foreground="#DF5454" />
        <Grid Grid.Row="5" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Name="SummaryText" Text="{Binding Summary.Value}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Name="ContinueOfflineButton" Content="{x:Static lang:MissingMediaStrings.ContinueOffline}"
                        IsEnabled="{Binding CanDismiss.Value}" Click="ContinueOfflineClick" />
                <Button Name="ApplyButton" Content="{x:Static lang:MissingMediaStrings.ApplyAndSave}"
                        IsEnabled="{Binding CanApply.Value}" Click="ApplyClick" Classes="accent" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
