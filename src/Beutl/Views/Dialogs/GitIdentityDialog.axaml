<ui:ContentDialog x:Class="Beutl.Views.Dialogs.GitIdentityDialog"
                  xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:lang="using:Beutl.Language"
                  xmlns:ui="using:FluentAvalonia.UI.Controls"
                  xmlns:vm="using:Beutl.ViewModels.Dialogs"
                  Title="{x:Static lang:Strings.VersionControl_IdentityTitle}"
                  x:CompileBindings="True"
                  x:DataType="vm:GitIdentityDialogViewModel"
                  CloseButtonText="{x:Static lang:Strings.Cancel}"
                  DefaultButton="Primary"
                  IsPrimaryButtonEnabled="{CompiledBinding CanSave.Value}"
                  PrimaryButtonText="{x:Static lang:Strings.Save}">
    <StackPanel MinWidth="360" Spacing="8">
        <TextBlock Text="{x:Static lang:Strings.VersionControl_IdentityName}" />
        <TextBox Text="{CompiledBinding Name.Value, Mode=TwoWay}" />
        <TextBlock Margin="0,8,0,0"
                   Text="{x:Static lang:Strings.VersionControl_IdentityEmail}" />
        <TextBox Text="{CompiledBinding Email.Value, Mode=TwoWay}" />
    </StackPanel>
</ui:ContentDialog>
