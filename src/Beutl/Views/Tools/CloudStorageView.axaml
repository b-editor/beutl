<UserControl x:Class="Beutl.Views.Tools.CloudStorageView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fileVm="using:Beutl.Editor.Components.FileBrowserTab.ViewModels"
             xmlns:files="using:Beutl.Editor.Components.FileBrowserTab.Views"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:lang="using:Beutl.Language"
             xmlns:local="using:Beutl.Views.Tools"
             xmlns:vm="using:Beutl.ViewModels.Tools"
             x:CompileBindings="True"
             x:DataType="vm:CloudStorageViewModel">
    <UserControl.Resources>
        <DataTemplate x:Key="StorageIconTemplate" x:DataType="vm:CloudStorageItem">
            <Border Padding="4"
                    Background="Transparent"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    ToolTip.Tip="{Binding ToolTip}">
                <files:FileBrowserItemView Icon="{Binding Icon}"
                                           IsIconView="True"
                                           ItemName="{Binding Name}" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="StorageListTemplate" x:DataType="vm:CloudStorageItem">
            <Border Padding="4,2"
                    Background="Transparent"
                    ToolTip.Tip="{Binding ToolTip}">
                <files:FileBrowserItemView Icon="{Binding Icon}" ItemName="{Binding Name}" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="ListBox#StorageItems">
            <Setter Property="ItemTemplate" Value="{StaticResource StorageListTemplate}" />
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox#StorageItems.icons">
            <Setter Property="ItemTemplate" Value="{StaticResource StorageIconTemplate}" />
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <local:StorageIconPanel />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox#StorageItems ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>
    <UserControl.KeyBindings>
        <KeyBinding Command="{Binding Refresh}" Gesture="F5" />
    </UserControl.KeyBindings>
    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !SignedIn.Value}">
            <StackPanel x:Name="SignInState"
                        MaxWidth="320"
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <icons:FluentIcon FontSize="32" Icon="Cloud" />
                <TextBlock Text="{x:Static lang:Strings.CloudStorageSignIn}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <Button x:Name="AccountSettingsButton"
                        HorizontalAlignment="Center"
                        Click="OnAccountSettingsClick"
                        Content="{x:Static lang:Strings.CloudStorageAccountSettings}" />
            </StackPanel>
        </ScrollViewer>
        <Grid IsVisible="{Binding SignedIn.Value}" RowDefinitions="Auto,Auto,*,Auto">
            <ProgressBar Height="2"
                         IsIndeterminate="True"
                         IsVisible="{Binding IsLoading.Value}" />
            <TextBlock x:Name="ErrorText"
                       Grid.Row="1"
                       Margin="8,4"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       IsVisible="{Binding Error.Value, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Text="{Binding Error.Value}"
                       TextWrapping="Wrap" />
            <ListBox x:Name="StorageItems"
                     Grid.Row="2"
                     Classes.icons="{Binding ViewMode.Value, Converter={x:Static fileVm:FileBrowserViewModeConverters.IsIcon}}"
                     DoubleTapped="OnItemDoubleTapped"
                     ItemsSource="{Binding Items}"
                     KeyDown="OnItemsKeyDown"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            <TextBlock x:Name="EmptyState"
                       Grid.Row="2"
                       MaxWidth="320"
                       Margin="24"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsEmpty.Value}"
                       Text="{x:Static lang:Strings.CloudStorageEmpty}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <StackPanel Grid.Row="3" Spacing="4">
                <ProgressBar Height="2"
                             AutomationProperties.Name="{x:Static lang:Strings.CloudStorageLoadingMore}"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsLoadingMore.Value}" />
                <Grid Margin="8,4"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="8"
                      IsVisible="{Binding LoadMoreError.Value, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock x:Name="LoadMoreErrorText"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Text="{Binding LoadMoreError.Value}"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1"
                            Command="{Binding RetryLoadMore}"
                            Content="{x:Static lang:Strings.CloudStorageRetryLoadMore}" />
                </Grid>
                <StackPanel Margin="8,4"
                            IsVisible="{Binding HasUsage.Value}"
                            Spacing="4">
                    <TextBlock x:Name="UsageText"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding UsageText.Value}"
                               TextWrapping="Wrap" />
                    <ProgressBar Height="2"
                                 AutomationProperties.Name="{x:Static lang:Strings.CloudStorage}"
                                 Maximum="100"
                                 Minimum="0"
                                 Value="{Binding UsagePercent.Value}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
