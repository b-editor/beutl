<UserControl x:Class="Beutl.Views.Tools.TransitionTabView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:editors="using:Beutl.Views.Editors"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:lang="using:Beutl.Language"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pe="using:Beutl.Controls.PropertyEditors"
             xmlns:viewModels="using:Beutl.ViewModels.Tools"
             x:Name="root"
             d:DesignHeight="450"
             d:DesignWidth="320"
             x:CompileBindings="True"
             x:DataType="viewModels:TransitionTabViewModel"
             mc:Ignorable="d">
    <Panel>
        <TextBlock Margin="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   IsVisible="{Binding !HasTarget.Value}"
                   Text="{x:Static lang:Strings.TransitionTab_Placeholder}"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />

        <ScrollViewer IsVisible="{Binding HasTarget.Value}">
            <!--  The type is picked as a font family is, the delete button removes the transition, and the
                  transition's properties follow at the same level.  -->
            <StackPanel Margin="0,4">
                <pe:DropDownPickerEditor x:Name="typeEditor"
                                         DropDownClick="OnTypeDropDownClick"
                                         Header="{Binding EdgeName.Value}"
                                         IsReadOnly="{Binding !CanEdit.Value}"
                                         Text="{Binding TypeName.Value, TargetNullValue={x:Static lang:Strings.Null}}">
                    <pe:DropDownPickerEditor.MenuContent>
                        <Button Width="24"
                                Height="24"
                                Margin="0,0,4,0"
                                Padding="0"
                                VerticalAlignment="Center"
                                BorderThickness="0"
                                Click="OnDeleteClick"
                                IsEnabled="{Binding CanDelete.Value}"
                                Theme="{StaticResource TransparentButton}"
                                ToolTip.Tip="{x:Static lang:Strings.Delete}">
                            <icons:FluentIcon FontSize="16" Icon="Delete" />
                        </Button>
                    </pe:DropDownPickerEditor.MenuContent>
                </pe:DropDownPickerEditor>

                <editors:PropertiesEditor Padding="0"
                                          DataContext="{Binding Properties.Value}"
                                          IsVisible="{ReflectionBinding #root.DataContext.Properties.Value,
                                                                        Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
