<UserControl x:Class="Beutl.Views.Tools.OutputView"
             xmlns="https://github.com/avaloniaui"
             xmlns:propertyEditors="using:Beutl.Editor.Components.PropertyEditors.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:Beutl.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Beutl.Language"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:usage="using:Beutl.Editor.Components.Helpers"
             xmlns:viewModel="using:Beutl.ViewModels.Tools"
             Name="Root"
             d:DesignHeight="800"
             d:DesignWidth="600"
             x:CompileBindings="True"
             x:DataType="viewModel:OutputViewModel"
             mc:Ignorable="d">
    <StackPanel Spacing="4">
        <StackPanel Margin="8,4" Spacing="6">
            <!-- The buttons stay on top, so that Cancel takes the place of the Encode just pressed. -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding ProgressText.Value}"
                           TextWrapping="Wrap" />
                <Button Grid.Column="1"
                        VerticalAlignment="Top"
                        usage:UsageTracking.Feature="Output.StartOutput"
                        Classes="accent"
                        Click="StartOutputClick"
                        Content="{x:Static lang:Strings.Encode}"
                        IsEnabled="{Binding CanEncode.Value}"
                        IsVisible="{Binding !IsRunning.Value, ElementName=Root}" />
                <Button Grid.Column="1"
                        VerticalAlignment="Top"
                        usage:UsageTracking.Feature="Output.CancelOutput"
                        Click="CancelOutputClick"
                        Content="{x:Static lang:Strings.Cancel}"
                        IsVisible="{Binding IsRunning.Value, ElementName=Root}" />
            </Grid>

            <StackPanel IsVisible="{Binding HasProgress.Value}" Spacing="6">
                <ProgressBar Maximum="{Binding ProgressMax.Value}"
                             Value="{Binding ProgressValue.Value}" />
                <!-- The same columns as the rows below, so that the figures read as part of the form. -->
                <Grid ColumnDefinitions="2*,Auto,3*"
                      RowDefinitions="Auto,Auto,Auto,Auto"
                      RowSpacing="4">
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Opacity="0.7"
                               Text="{x:Static lang:Strings.ElapsedTime}" />
                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Text="{Binding Elapsed.Value}" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Opacity="0.7"
                               Text="{x:Static lang:Strings.RemainingTime}" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="2"
                               Text="{Binding Eta.Value}" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Opacity="0.7"
                               Text="{x:Static lang:Strings.Frames}" />
                    <TextBlock Grid.Row="2"
                               Grid.Column="2"
                               Text="{Binding FrameProgressText.Value}" />

                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Opacity="0.7"
                               Text="{x:Static lang:Strings.FileSize}" />
                    <StackPanel Grid.Row="3"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="6">
                        <TextBlock Text="{Binding CurrentSize.Value}" />
                        <TextBlock Opacity="0.5" Text="/" />
                        <TextBlock Text="{Binding EstimatedSize.Value}" />
                    </StackPanel>

                    <GridSplitter Grid.RowSpan="4"
                                  Grid.Column="1"
                                  Background="Transparent" />
                </Grid>
            </StackPanel>
        </StackPanel>

        <Grid Margin="8,0" ToolTip.Tip="{x:Static lang:Strings.DestinationToSaveTo_Tip}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <TextBlock HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       ClipToBounds="False"
                       Text="{x:Static lang:Strings.DestinationToSaveTo}"
                       TextTrimming="CharacterEllipsis" />

            <GridSplitter Grid.Column="1" Background="Transparent" />

            <TextBox x:Name="DestinationInputTextBox"
                     Grid.Column="2"
                     MinWidth="120"
                     Margin="0,4"
                     Text="{Binding DestinationFile.Value, Mode=TwoWay}"
                     ToolTip.Tip="{Binding DestinationFile.Value}">
                <TextBox.InnerRightContent>
                    <Button usage:UsageTracking.Feature="Output.SelectDestinationFile"
                            Click="SelectDestinationFileClick"
                            Theme="{StaticResource TextBoxOpenButtonStyle}" />
                </TextBox.InnerRightContent>
            </TextBox>
        </Grid>

        <Grid Margin="8,0" ToolTip.Tip="{x:Static lang:Strings.Encoder_Tip}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <TextBlock HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       ClipToBounds="False"
                       Text="{x:Static lang:Strings.Encoder}"
                       TextTrimming="CharacterEllipsis" />

            <GridSplitter Grid.Column="1" Background="Transparent" />

            <ComboBox Grid.Column="2"
                      MinWidth="120"
                      Margin="0,4"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Encoders}"
                      SelectedItem="{Binding SelectedEncoder.Value}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid Margin="8,0" ToolTip.Tip="{x:Static lang:Strings.Supersampling_Tip}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <TextBlock HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       ClipToBounds="False"
                       Text="{x:Static lang:Strings.Supersampling}"
                       TextTrimming="CharacterEllipsis" />

            <GridSplitter Grid.Column="1" Background="Transparent" />

            <ComboBox Grid.Column="2"
                      MinWidth="120"
                      Margin="0,4"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding SupersampleFactors}"
                      SelectedItem="{Binding SupersampleFactor.Value}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="x:Int32">
                        <TextBlock Text="{Binding Converter={x:Static converters:SupersampleFactorNameConverter.Instance}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <TextBlock Margin="8,0"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                   IsVisible="{Binding SupersampleWarning.Value, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Text="{Binding SupersampleWarning.Value}"
                   TextWrapping="Wrap" />

        <TextBlock Margin="8,16,0,0"
                   Text="{x:Static lang:Strings.Video}"
                   Theme="{StaticResource BodyStrongTextBlockStyle}" />

        <propertyEditors:PropertiesEditor DataContext="{Binding VideoSettings.Value}" HideMenu="True" />

        <TextBlock Margin="8,16,0,0"
                   Text="{x:Static lang:Strings.Audio}"
                   Theme="{StaticResource BodyStrongTextBlockStyle}" />

        <propertyEditors:PropertiesEditor DataContext="{Binding AudioSettings.Value}" HideMenu="True" />
    </StackPanel>
</UserControl>
