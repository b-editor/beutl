<UserControl x:Class="Beutl.Views.Tools.AiWorkspaceView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Beutl.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dialogs="using:Beutl.ViewModels.Dialogs"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:lang="using:Beutl.Language"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tools="using:Beutl.Views.Tools"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:viewModels="using:Beutl.ViewModels.Tools"
             d:DesignHeight="640"
             d:DesignWidth="380"
             x:CompileBindings="True"
             x:DataType="viewModels:AiWorkspaceViewModel"
             mc:Ignorable="d">
    <UserControl.DataTemplates>
        <DataTemplate DataType="dialogs:AiImageGenerationDialogViewModel">
            <tools:AiImageGenerationView />
        </DataTemplate>
        <DataTemplate DataType="dialogs:AiImageEditDialogViewModel">
            <tools:AiImageEditView />
        </DataTemplate>
        <DataTemplate DataType="dialogs:AiVideoGenerationDialogViewModel">
            <tools:AiVideoGenerationView />
        </DataTemplate>
        <DataTemplate DataType="dialogs:AiSubtitleDialogViewModel">
            <tools:AiSubtitleView />
        </DataTemplate>
        <DataTemplate DataType="viewModels:AiJobCenterViewModel">
            <tools:AiJobCenterView />
        </DataTemplate>
    </UserControl.DataTemplates>
    <Grid RowDefinitions="Auto,*">
        <controls:ToolTabBar x:Name="ToolBar">
            <TabStrip x:Name="SectionStrip"
                      Classes="toolTabNavigation"
                      ItemsSource="{CompiledBinding Sections}"
                      SelectedItem="{CompiledBinding SelectedSection.Value}">
                <!--  A narrow dock would push the last pages off the edge of a single
                      row, and a page you cannot reach is a page you have lost.  -->
                <TabStrip.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </TabStrip.ItemsPanel>
                <TabStrip.Styles>
                    <Style x:DataType="viewModels:AiWorkspaceSectionViewModel" Selector="TabStripItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                        <Setter Property="ToolTip.Tip" Value="{Binding DisplayName}" />
                    </Style>
                </TabStrip.Styles>
                <TabStrip.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:AiWorkspaceSectionViewModel">
                        <Grid ColumnDefinitions="Auto,*">
                            <icons:FluentIcon Icon="{CompiledBinding Icon}" />
                            <TextBlock Grid.Column="1" Text="{CompiledBinding DisplayName}" />
                        </Grid>
                    </DataTemplate>
                </TabStrip.ItemTemplate>
            </TabStrip>
        </controls:ToolTabBar>

        <ContentControl Grid.Row="1"
                        Content="{CompiledBinding ActiveContent.Value}"
                        IsVisible="{CompiledBinding !IsGateOpen.Value}" />

        <!--  Signed out or without a plan there is nothing to run yet, so the
              content reads like the browser's blank page or an untracked
              project: one centered panel instead of a disabled form. The
              section strip stays so pages remain reachable.  -->
        <ScrollViewer Grid.Row="1"
                      HorizontalContentAlignment="Stretch"
                      Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                      HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{CompiledBinding IsGateOpen.Value}">
            <Border x:Name="AiGatePanel"
                    Margin="24"
                    Padding="8,24"
                    VerticalAlignment="Center"
                    IsVisible="{CompiledBinding IsGateOpen.Value}">
                <StackPanel MaxWidth="320"
                            HorizontalAlignment="Center"
                            Spacing="24">
                    <Border Width="64"
                            Height="64"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="20">
                        <icons:FluentIcon HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          FontSize="30"
                                          Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                          Icon="Sparkle" />
                    </Border>
                    <StackPanel Spacing="10">
                        <TextBlock FontSize="20"
                                   FontWeight="Normal"
                                   Text="{x:Static lang:Strings.Ai}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="AiGateDescription"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   LineHeight="22"
                                   Text="{x:Static lang:Strings.AiProRequired}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="AiGateSignInButton"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="{x:Static lang:SettingsStrings.SignIn}"
                            Command="{CompiledBinding SignIn}"
                            IsVisible="{CompiledBinding RequiresSignIn.Value}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <icons:FluentIcon VerticalAlignment="Center"
                                              FontSize="16"
                                              Icon="Person"
                                              IsVisible="{CompiledBinding !IsSigningIn.Value}" />
                            <ui:FAProgressRing x:Name="AiGateSignInProgress"
                                               Width="16"
                                               Height="16"
                                               IsIndeterminate="True"
                                               IsVisible="{CompiledBinding IsSigningIn.Value}" />
                            <TextBlock x:Name="AiGateSignInLabel"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="{x:Static lang:SettingsStrings.SignIn}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Button>
                    <Button x:Name="AiGatePlanButton"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="{x:Static lang:Strings.AiJoinPro}"
                            Command="{CompiledBinding OpenAiPlan}"
                            Content="{x:Static lang:Strings.AiJoinPro}"
                            IsVisible="{CompiledBinding RequiresPlan.Value}" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
