<UserControl x:Class="Beutl.Views.Tools.AiVideoEditingView"
             xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Beutl.ViewModels.Dialogs" xmlns:tools="using:Beutl.Views.Tools"
             xmlns:lang="using:Beutl.Language" x:CompileBindings="True" x:DataType="vm:AiVideoEditingViewModel">
    <Grid RowDefinitions="Auto,*">
        <StackPanel Margin="12,10,12,0" Spacing="4">
            <TextBlock Text="{x:Static lang:Strings.AiEditTask}" />
            <ComboBox x:Name="TaskPicker" HorizontalAlignment="Stretch" ItemsSource="{CompiledBinding Tasks}"
                      SelectedItem="{CompiledBinding SelectedTask.Value}" IsEnabled="{CompiledBinding CanChooseTask.Value}"
                      AutomationProperties.Name="{x:Static lang:Strings.AiEditTask}" />
        </StackPanel>
        <tools:AiVideoGenerationView Grid.Row="1" DataContext="{CompiledBinding ActiveContent.Value}" />
    </Grid>
</UserControl>
