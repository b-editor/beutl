<UserControl x:Class="Beutl.Views.Tools.AiVideoEditingView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ai="using:Beutl.Services.AI"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:lang="using:Beutl.Language"
             xmlns:tools="using:Beutl.Views.Tools"
             xmlns:vm="using:Beutl.ViewModels.Dialogs"
             x:CompileBindings="True" x:DataType="vm:AiVideoEditingViewModel">
    <UserControl.Resources>
        <DataTemplate x:Key="SourceTemplate" x:DataType="vm:AiVideoGenerationDialogViewModel">
            <StackPanel Spacing="8">
            <Border Padding="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="4"
                    IsVisible="{CompiledBinding RecoveryAvailable.Value}">
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Static lang:Strings.AiPendingRequest}" TextWrapping="Wrap" />
                    <ComboBox AutomationProperties.Name="{x:Static lang:Strings.AiPendingRequest}"
                              ItemsSource="{CompiledBinding RecoveryAttempts.Value}"
                              SelectedItem="{CompiledBinding SelectedRecoveryAttempt.Value}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="ai:AiPendingAttempt">
                                <TextBlock Text="{CompiledBinding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <WrapPanel Orientation="Horizontal">
                        <Button Margin="0,0,6,0"
                                Command="{CompiledBinding RecoverSelectedAttempt}"
                                Content="{x:Static lang:Strings.AiRecoverRequest}" />
                        <Button Command="{CompiledBinding AbandonSelectedAttempt}"
                                Content="{x:Static lang:Strings.AiAbandonRequest}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
                <StackPanel x:Name="SourceField" Spacing="4" IsEnabled="{CompiledBinding !IsGenerating.Value}">
                    <TextBlock Text="{x:Static lang:Strings.AiSourceVideo}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="SourcePath" IsReadOnly="True"
                                 Text="{CompiledBinding SourceVideoPath.Value}"
                                 PlaceholderText="{x:Static lang:Strings.AiVideoNoSourceSelected}"
                                 AutomationProperties.Name="{x:Static lang:Strings.AiSourceVideo}" />
                        <Button Grid.Column="1" Margin="8,0,0,0"
                                Command="{CompiledBinding SelectSourceVideo}" Content="{x:Static lang:Strings.AiEditBrowse}"
                                AutomationProperties.Name="{x:Static lang:Strings.AiEditBrowse}"
                                ToolTip.Tip="{x:Static lang:Strings.AiEditBrowse}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="EditorTemplate" x:DataType="vm:AiVideoGenerationDialogViewModel">
            <StackPanel Spacing="8">
                <StackPanel x:Name="ModelField" Spacing="4" IsVisible="{CompiledBinding ModelPicker.HasChoice.Value}">
                    <TextBlock Text="{x:Static lang:Strings.AiModel}" />
                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{CompiledBinding ModelPicker.Options}"
                              SelectedItem="{CompiledBinding ModelPicker.Selected.Value}"
                              IsEnabled="{CompiledBinding ModelPicker.IsSelectionEnabled.Value}"
                              AutomationProperties.Name="{x:Static lang:Strings.AiModel}" />
                </StackPanel>
                <StackPanel x:Name="PromptField" Spacing="4">
                    <TextBlock Text="{x:Static lang:Strings.AiPrompt}" />
                    <TextBox AcceptsReturn="True" Height="72" TextWrapping="Wrap"
                             Text="{CompiledBinding Prompt.Value}" MaxLength="{CompiledBinding MaxPromptLength.Value}"
                             PlaceholderText="{x:Static lang:Strings.AiVideoEditPromptPlaceholder}"
                             AutomationProperties.Name="{x:Static lang:Strings.AiPrompt}" />
                    <TextBlock Text="{CompiledBinding VisiblePromptValidationError.Value}" TextWrapping="Wrap"
                               IsVisible="{CompiledBinding VisiblePromptValidationError.Value, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}" AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>
                <StackPanel x:Name="DurationField" Spacing="4" IsVisible="{CompiledBinding CanChooseDuration}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{x:Static lang:Strings.AiVideoDuration}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{CompiledBinding SelectedDuration.Value}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <Slider Minimum="0" Maximum="{CompiledBinding MaxDurationIndex.Value}"
                            Value="{CompiledBinding DurationIndex.Value}" IsSnapToTickEnabled="True" TickFrequency="1" TickPlacement="BottomRight"
                            AutomationProperties.Name="{x:Static lang:Strings.AiVideoDuration}" />
                </StackPanel>
                <StackPanel Spacing="8" IsVisible="{CompiledBinding IsMotionControl}" IsEnabled="{CompiledBinding !IsGenerating.Value}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Static lang:Strings.AiCharacterImage}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox IsReadOnly="True" Text="{CompiledBinding CharacterImagePath.Value}"
                                     PlaceholderText="{x:Static lang:Strings.AiEditNoSourceSelected}"
                                     AutomationProperties.Name="{x:Static lang:Strings.AiCharacterImage}" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Command="{CompiledBinding SelectCharacterImage}"
                                    Content="{x:Static lang:Strings.AiEditBrowse}" ToolTip.Tip="{x:Static lang:Strings.AiEditBrowse}"
                                    AutomationProperties.Name="{x:Static lang:Strings.AiCharacterImage}" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Static lang:Strings.AiMotionOrientation}" />
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{CompiledBinding Orientations}"
                                  SelectedItem="{CompiledBinding Orientation.Value}" AutomationProperties.Name="{x:Static lang:Strings.AiMotionOrientation}" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Static lang:Strings.AiMotionQuality}" />
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{CompiledBinding Qualities}"
                                  SelectedItem="{CompiledBinding Quality.Value}" AutomationProperties.Name="{x:Static lang:Strings.AiMotionQuality}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{CompiledBinding InputError.Value}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                           IsVisible="{CompiledBinding InputError.Value, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <StackPanel Spacing="8">
                <StackPanel IsVisible="{CompiledBinding Usage.HasSnapshot.Value}" Spacing="4">
                    <tools:AiUsageSummaryView DataContext="{CompiledBinding Usage}" />
                    <tools:AiUsageEstimateView DataContext="{CompiledBinding EstimatedUsage}" />
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto">
                    <Button HorizontalAlignment="Stretch"
                            Classes="accent"
                            Command="{CompiledBinding Generate}"
                            Content="{x:Static lang:Strings.AiEditRun}"
                            AutomationProperties.Name="{x:Static lang:Strings.AiEditRun}"
                            IsEnabled="{CompiledBinding CanGenerate.Value}" />
                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            AutomationProperties.Name="{x:Static lang:Strings.Cancel}"
                            Command="{CompiledBinding StopGenerating}"
                            Content="{x:Static lang:Strings.Cancel}"
                            IsVisible="{CompiledBinding IsGenerating.Value}" />
                </Grid>
            </StackPanel>

            <Border Padding="16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8">
                <Grid>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <icons:FluentIcon FontSize="24"
                                           Icon="VideoClipWand"
                                           Opacity="0.6" />
                        <TextBlock HorizontalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.Name="{CompiledBinding StatusText.Value}"
                                   Opacity="0.6"
                                   Text="{CompiledBinding StatusText.Value}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button AutomationProperties.Name="{x:Static lang:Strings.AiVideoOpenPreview}"
                                Command="{CompiledBinding OpenResult}"
                                Content="{x:Static lang:Strings.AiVideoOpenPreview}"
                                IsVisible="{CompiledBinding ResultVideoPath.Value, Converter={x:Static ObjectConverters.IsNotNull}}"
                                ToolTip.Tip="{x:Static lang:Strings.AiVideoOpenPreview}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock AutomationProperties.LiveSetting="Assertive"
                       AutomationProperties.Name="{CompiledBinding Error.Value}"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       IsVisible="{CompiledBinding Error.Value, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Text="{CompiledBinding Error.Value}"
                       TextWrapping="Wrap" />

            <StackPanel IsVisible="{CompiledBinding ShowJoinPro.Value}" Spacing="8">
                <TextBlock Text="{x:Static lang:Strings.AiProRequired}"
                           TextWrapping="Wrap" />
                <Button HorizontalAlignment="Left"
                        Command="{CompiledBinding OpenAiPlan}"
                        Content="{x:Static lang:Strings.AiJoinPro}" />
            </StackPanel>

            <WrapPanel IsVisible="{CompiledBinding CanAddToScene.Value}" Orientation="Horizontal">
                <Button Margin="0,0,8,8"
                        Command="{CompiledBinding AddToScene}"
                        Content="{x:Static lang:Strings.AiAddToScene}" />
                <Button Margin="0,0,0,8"
                        Command="{CompiledBinding SaveToFile}"
                        Content="{x:Static lang:Strings.AiSaveToFile}" />
            </WrapPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,10" Spacing="8">
            <ContentControl HorizontalContentAlignment="Stretch" Content="{CompiledBinding ActiveContent.Value}" ContentTemplate="{StaticResource SourceTemplate}" />
            <StackPanel x:Name="TaskField" Spacing="4">
                <TextBlock Text="{x:Static lang:Strings.AiEditTask}" />
                <ComboBox x:Name="TaskPicker" HorizontalAlignment="Stretch" ItemsSource="{CompiledBinding Tasks}"
                          SelectedItem="{CompiledBinding SelectedTask.Value}" IsEnabled="{CompiledBinding CanChooseTask.Value}"
                          AutomationProperties.Name="{x:Static lang:Strings.AiEditTask}" />
            </StackPanel>
            <ContentControl HorizontalContentAlignment="Stretch" Content="{CompiledBinding ActiveContent.Value}" ContentTemplate="{StaticResource EditorTemplate}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
