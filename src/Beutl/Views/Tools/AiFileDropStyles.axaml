<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <SolidColorBrush x:Key="AiFileDropBackgroundBrush"
                         Color="{DynamicResource SystemAccentColor}"
                         Opacity="0.14" />
    </Styles.Resources>
    <Style Selector=":is(Panel).aifiledrop">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector=":is(Panel).aifiledrop.dragover">
        <Setter Property="Background" Value="{DynamicResource AiFileDropBackgroundBrush}" />
    </Style>
</Styles>
