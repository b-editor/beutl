<UserControl x:Class="Beutl.Editor.Components.PropertyEditors.Views.PropertiesEditor"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editorConverters="using:Beutl.Controls.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:CompileBindings="False"
             mc:Ignorable="d">
    <UserControl.Resources>
        <DataTemplate x:Key="EditorTemplate">
            <ContentControl Content="{Binding Converter={x:Static editorConverters:PropertyEditorContextToViewConverter.Instance}}" />
        </DataTemplate>
        <DataTemplate x:Key="EditorWithoutMenuTemplate">
            <ContentControl Content="{Binding Converter={x:Static editorConverters:PropertyEditorContextToViewConverter.HideMenu}}" />
        </DataTemplate>
    </UserControl.Resources>
    <ItemsControl x:Name="items"
                  ItemTemplate="{StaticResource EditorTemplate}"
                  ItemsSource="{Binding Properties}" />
</UserControl>
