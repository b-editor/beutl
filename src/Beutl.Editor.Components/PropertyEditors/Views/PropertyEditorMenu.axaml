<UserControl x:Class="Beutl.Editor.Components.PropertyEditors.Views.PropertyEditorMenu"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:decoding="using:Beutl.Media.Decoding"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:lang="using:Beutl.Language"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:media="using:Beutl.Media"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Beutl.Editor.PropertyEditors"
             Margin="0,0,4,0"
             Classes="property-editor-menu"
             VerticalAlignment="Center"
             d:DesignHeight="500"
             d:DesignWidth="500"
             x:CompileBindings="True"
             x:DataType="vm:PropertyEditorViewModel"
             mc:Ignorable="d">
    <Button Width="24"
            Height="24"
            Padding="0"
            HorizontalAlignment="Center"
            BorderThickness="0"
            Click="Button_Click"
            ToolTip.Tip="{Binding ValueDifference.Value}"
            Theme="{StaticResource TransparentButton}">
        <Button.ContextFlyout>
            <ui:FAMenuFlyout Opening="Menu_Opening">
                <ui:FAMenuFlyoutItem x:Name="resetItem" Command="{Binding Reset}"
                                   Text="{x:Static lang:Strings.Reset}">
                    <ui:FAMenuFlyoutItem.IsEnabled>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="CanEdit.Value" />
                            <Binding Path="CanReset" />
                        </MultiBinding>
                    </ui:FAMenuFlyoutItem.IsEnabled>
                </ui:FAMenuFlyoutItem>
                <ui:FAMenuFlyoutItem x:Name="matchOtherElementsItem"
                                   Command="{Binding MatchOtherElements}"
                                   IsEnabled="{Binding CanEdit.Value}"
                                   Text="{x:Static lang:Strings.MultipleElements_ApplyValueToAll}">
                    <ui:FAMenuFlyoutItem.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Converter="{x:Static ObjectConverters.IsNotNull}" Path="ValueDifference.Value" />
                            <Binding Path="CanMatchOtherElements" />
                        </MultiBinding>
                    </ui:FAMenuFlyoutItem.IsVisible>
                </ui:FAMenuFlyoutItem>
                <ui:FAMenuFlyoutItem x:Name="separateComponentsItem"
                                   IsVisible="False"
                                   IsEnabled="{Binding CanEditProperty.Value}"
                                   Click="SeparateComponents_Click"
                                   Text="{x:Static lang:Strings.SeparateComponents}" />
                <ui:FAMenuFlyoutItem x:Name="unseparateComponentsItem"
                                   IsVisible="False"
                                   IsEnabled="{Binding CanUnseparateComponents.Value}"
                                   Click="UnseparateComponents_Click"
                                   Text="{x:Static lang:Strings.UnseparateComponents}"
                                   ToolTip.ShowOnDisabled="True"
                                   ToolTip.Tip="{Binding UnseparateComponentsDescription}" />
                <ui:FAMenuFlyoutItem x:Name="editAnimationItem"
                                   IsEnabled="{Binding CanEditProperty.Value}"
                                   Click="EditAnimation_Click"
                                   Text="{x:Static lang:Strings.EditAnimation}" />
                <ui:FAMenuFlyoutItem x:Name="editInlineAnimationItem"
                                   IsEnabled="{Binding CanEditProperty.Value}"
                                   Click="EditInlineAnimation_Click"
                                   Text="{x:Static lang:Strings.EditAnimationInInlineView}" />
                <ui:FAMenuFlyoutItem x:Name="removeAnimationItem"
                                   IsEnabled="{Binding CanRemoveAnimation.Value}"
                                   Click="RemoveAnimation_Click"
                                   Text="{x:Static lang:CommandNames.DeleteAnimation}" />
                <ui:FAToggleMenuFlyoutItem x:Name="toggleLivePreview"
                                         IsChecked="{ReflectionBinding IsLivePreviewEnabled.Value,
                                                                       Mode=TwoWay}"
                                         IsVisible="False"
                                         Text="{x:Static lang:Strings.EnableLivePreview}" />
                <ui:FAToggleMenuFlyoutItem x:Name="uniformEditorToggle"
                                         IsChecked="{ReflectionBinding IsUniformEditorEnabled.Value,
                                                                       Mode=TwoWay}"
                                         IsVisible="False"
                                         Text="{x:Static lang:Strings.UniformValue}" />
                <ui:FAMenuFlyoutSubItem x:Name="transferInterpretationMenu"
                                      IsVisible="False"
                                      IsEnabled="{Binding CanEditProperty.Value}"
                                      Text="{x:Static lang:GraphicsStrings.SourceVideo_TransferInterpretation}">
                    <ui:FARadioMenuFlyoutItem Click="TransferInterpretation_Click"
                                            GroupName="TransferInterpretation"
                                            Tag="{x:Static media:VideoTransferInterpretation.Auto}"
                                            Text="{x:Static lang:GraphicsStrings.VideoTransfer_Auto}" />
                    <ui:FARadioMenuFlyoutItem Click="TransferInterpretation_Click"
                                            GroupName="TransferInterpretation"
                                            Tag="{x:Static media:VideoTransferInterpretation.QuickTime}"
                                            Text="{x:Static lang:GraphicsStrings.VideoTransfer_QuickTime}" />
                    <ui:FARadioMenuFlyoutItem Click="TransferInterpretation_Click"
                                            GroupName="TransferInterpretation"
                                            Tag="{x:Static media:VideoTransferInterpretation.Bt1886}"
                                            Text="{x:Static lang:GraphicsStrings.VideoTransfer_Bt1886}" />
                    <ui:FARadioMenuFlyoutItem Click="TransferInterpretation_Click"
                                            GroupName="TransferInterpretation"
                                            Tag="{x:Static media:VideoTransferInterpretation.Srgb}"
                                            Text="{x:Static lang:GraphicsStrings.VideoTransfer_Srgb}" />
                    <ui:FARadioMenuFlyoutItem Click="TransferInterpretation_Click"
                                            GroupName="TransferInterpretation"
                                            Tag="{x:Static media:VideoTransferInterpretation.Bt709Scene}"
                                            Text="{x:Static lang:GraphicsStrings.VideoTransfer_Bt709Scene}" />
                </ui:FAMenuFlyoutSubItem>
                <ui:FAMenuFlyoutSubItem x:Name="deinterlaceMenu"
                                      IsVisible="False"
                                      IsEnabled="{Binding CanEditProperty.Value}"
                                      Text="{x:Static lang:GraphicsStrings.SourceVideo_Deinterlace}">
                    <ui:FAMenuFlyoutItem x:Name="deinterlaceStatusItem" IsEnabled="False" IsVisible="False" />
                    <ui:FARadioMenuFlyoutItem Click="DeinterlaceOption_Click" GroupName="DeinterlaceMode"
                                            Tag="{x:Static decoding:DeinterlaceMode.Off}"
                                            Text="{x:Static lang:GraphicsStrings.VideoDeinterlace_Off}" />
                    <ui:FARadioMenuFlyoutItem Click="DeinterlaceOption_Click" GroupName="DeinterlaceMode"
                                            Tag="{x:Static decoding:DeinterlaceMode.Auto}"
                                            Text="{x:Static lang:GraphicsStrings.VideoDeinterlace_Auto}" />
                    <ui:FARadioMenuFlyoutItem Click="DeinterlaceOption_Click" GroupName="DeinterlaceMode"
                                            Tag="{x:Static decoding:DeinterlaceMode.On}"
                                            Text="{x:Static lang:GraphicsStrings.VideoDeinterlace_On}" />
                    <ui:FAMenuFlyoutSeparator />
                    <ui:FAMenuFlyoutSubItem x:Name="deinterlaceFieldOrderMenu" Text="{x:Static lang:GraphicsStrings.SourceVideo_DeinterlaceFieldOrder}">
                        <ui:FARadioMenuFlyoutItem Click="DeinterlaceOption_Click" GroupName="DeinterlaceFieldOrder"
                                                Tag="{x:Static decoding:DeinterlaceFieldOrder.Auto}"
                                                Text="{x:Static lang:GraphicsStrings.VideoDeinterlace_Auto}" />
                        <ui:FARadioMenuFlyoutItem Click="DeinterlaceOption_Click" GroupName="DeinterlaceFieldOrder"
                                                Tag="{x:Static decoding:DeinterlaceFieldOrder.TopFieldFirst}"
                                                Text="{x:Static lang:GraphicsStrings.VideoDeinterlace_TopFieldFirst}" />
                        <ui:FARadioMenuFlyoutItem Click="DeinterlaceOption_Click" GroupName="DeinterlaceFieldOrder"
                                                Tag="{x:Static decoding:DeinterlaceFieldOrder.BottomFieldFirst}"
                                                Text="{x:Static lang:GraphicsStrings.VideoDeinterlace_BottomFieldFirst}" />
                    </ui:FAMenuFlyoutSubItem>
                    <ui:FAMenuFlyoutSubItem x:Name="deinterlaceMethodMenu" Text="{x:Static lang:GraphicsStrings.SourceVideo_DeinterlaceMethod}">
                        <ui:FARadioMenuFlyoutItem Click="DeinterlaceOption_Click" GroupName="DeinterlaceMethod"
                                                Tag="{x:Static decoding:DeinterlaceMethod.Bwdif}"
                                                Text="{x:Static lang:GraphicsStrings.VideoDeinterlace_Bwdif}" />
                        <ui:FARadioMenuFlyoutItem Click="DeinterlaceOption_Click" GroupName="DeinterlaceMethod"
                                                Tag="{x:Static decoding:DeinterlaceMethod.Yadif}"
                                                Text="{x:Static lang:GraphicsStrings.VideoDeinterlace_Yadif}" />
                    </ui:FAMenuFlyoutSubItem>
                    <ui:FAMenuFlyoutSubItem x:Name="deinterlaceFrameRateMenu" Text="{x:Static lang:GraphicsStrings.SourceVideo_DeinterlaceFrameRate}">
                        <ui:FARadioMenuFlyoutItem Click="DeinterlaceOption_Click" GroupName="DeinterlaceFrameRateMode"
                                                Tag="{x:Static decoding:DeinterlaceFrameRateMode.Frame}"
                                                Text="{x:Static lang:GraphicsStrings.VideoDeinterlace_Frame}" />
                        <ui:FARadioMenuFlyoutItem Click="DeinterlaceOption_Click" GroupName="DeinterlaceFrameRateMode"
                                                Tag="{x:Static decoding:DeinterlaceFrameRateMode.Field}"
                                                Text="{x:Static lang:GraphicsStrings.VideoDeinterlace_Field}" />
                    </ui:FAMenuFlyoutSubItem>
                </ui:FAMenuFlyoutSubItem>
                <ui:FAMenuFlyoutSeparator x:Name="expressionSeparator" IsVisible="False" />
                <ui:FAMenuFlyoutItem x:Name="editExpressionItem"
                                   IsEnabled="{Binding CanEditProperty.Value}"
                                   Click="EditExpression_Click"
                                   IsVisible="False"
                                   Text="{x:Static lang:Strings.EditExpression}" />
                <ui:FAMenuFlyoutItem x:Name="removeExpressionItem"
                                   Click="RemoveExpression_Click"
                                   IsVisible="False"
                                   Text="{x:Static lang:Strings.RemoveExpression}">
                    <ui:FAMenuFlyoutItem.IsEnabled>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="CanEditProperty.Value" />
                            <Binding Path="HasExpression.Value" />
                        </MultiBinding>
                    </ui:FAMenuFlyoutItem.IsEnabled>
                </ui:FAMenuFlyoutItem>
                <ui:FAMenuFlyoutItem x:Name="linkToAnotherPropertyItem"
                                   Click="LinkToAnotherProperty_Click"
                                   IsEnabled="{Binding CanEditProperty.Value}"
                                   IsVisible="False"
                                   Text="{x:Static lang:Strings.LinkToAnotherProperty}" />
                <ui:FAMenuFlyoutSeparator x:Name="copyPropertyPathSeparator" IsVisible="False" />
                <ui:FAMenuFlyoutItem x:Name="copyPropertyPathItem"
                                   Click="CopyPropertyPath_Click"
                                   IsVisible="False"
                                   Text="{x:Static lang:Strings.CopyPropertyPath}" />
                <ui:FAMenuFlyoutItem x:Name="copyGetPropertyCodeItem"
                                   Click="CopyGetPropertyCode_Click"
                                   IsVisible="False"
                                   Text="{x:Static lang:Strings.CopyGetPropertyCode}" />
                <ui:FAMenuFlyoutSubItem x:Name="copyPropertyPathSubItem"
                                      IsVisible="False"
                                      Text="{x:Static lang:Strings.CopyPropertyPath}" />
                <ui:FAMenuFlyoutSubItem x:Name="copyGetPropertyCodeSubItem"
                                      IsVisible="False"
                                      Text="{x:Static lang:Strings.CopyGetPropertyCode}" />
            </ui:FAMenuFlyout>
        </Button.ContextFlyout>
        <Panel Width="20" Height="20">
            <icons:FluentIcon x:Name="symbolIcon"
                              Classes.hasAnimation="{Binding HasAnimation.Value}"
                              Classes.hasExpression="{Binding HasExpression.Value}"
                              Classes.atKeyFrame="{Binding IsAtKeyFrame.Value}">
                <icons:FluentIcon.Styles>
                    <Style Selector="icons|FluentIcon">
                        <Setter Property="Icon" Value="MoreVertical" />
                    </Style>
                    <Style Selector="icons|FluentIcon.atKeyFrame">
                        <Setter Property="IconVariant" Value="Filled" />
                    </Style>
                    <Style Selector="icons|FluentIcon.hasAnimation">
                        <Setter Property="Icon" Value="Diamond" />
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCaution}" />
                    </Style>
                    <Style Selector="icons|FluentIcon.hasExpression:not(.hasAnimation)">
                        <Setter Property="Icon" Value="MathFormula" />
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccess}" />
                    </Style>
                </icons:FluentIcon.Styles>
            </icons:FluentIcon>
            <icons:FluentIcon x:Name="expressionBadge"
                              Width="10"
                              Height="10"
                              FontSize="10"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Foreground="{DynamicResource SystemFillColorSuccess}"
                              Icon="MathFormula"
                              IsHitTestVisible="False">
                <icons:FluentIcon.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="HasAnimation.Value" />
                        <Binding Path="HasExpression.Value" />
                    </MultiBinding>
                </icons:FluentIcon.IsVisible>
            </icons:FluentIcon>
            <!--  The elements the editor stands for hold different values; the button's tip lists them.  -->
            <Ellipse x:Name="valueDifferenceBadge"
                     Width="6"
                     Height="6"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Fill="{DynamicResource AccentFillColorDefaultBrush}"
                     IsHitTestVisible="False"
                     IsVisible="{Binding ValueDifference.Value, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </Panel>
    </Button>
</UserControl>
