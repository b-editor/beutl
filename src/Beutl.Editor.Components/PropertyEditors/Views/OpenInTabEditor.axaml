<UserControl x:Class="Beutl.Editor.Components.PropertyEditors.Views.OpenInTabEditor"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:local="using:Beutl.Editor.Components.PropertyEditors.Views"
             xmlns:pe="using:Beutl.Controls.PropertyEditors"
             xmlns:vm="using:Beutl.Editor.PropertyEditors"
             x:CompileBindings="True"
             x:DataType="vm:PropertyEditorViewModel">
    <pe:PropertyEditorGrid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Margin="4,0,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   ClipToBounds="False"
                   Text="{Binding Header}"
                   ToolTip.Tip="{Binding HoverInfo.Value}"
                   TextTrimming="CharacterEllipsis" />

        <GridSplitter Grid.Column="1" Background="Transparent" />

        <Button Grid.Column="2"
                Margin="4"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Click="OnButtonClick"
                IsEnabled="{Binding CanEdit.Value}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <icons:FluentIcon x:Name="IconElement" VerticalAlignment="Center" />
                <TextBlock x:Name="TextElement" />
            </StackPanel>
        </Button>

        <local:PropertyEditorMenu Grid.Column="3" />
    </pe:PropertyEditorGrid>
</UserControl>
