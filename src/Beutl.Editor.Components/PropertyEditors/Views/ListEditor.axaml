<UserControl x:Class="Beutl.Editor.Components.PropertyEditors.Views.ListEditor"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Beutl.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:lang="using:Beutl.Language"
             xmlns:local="using:Beutl.Editor.Components.PropertyEditors.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Beutl.Editor.Components.PropertyEditors.ViewModels"
             d:DesignHeight="70"
             d:DesignWidth="300"
             x:CompileBindings="False"
             mc:Ignorable="d">
    <Grid x:Name="layout" RowDefinitions="Auto,Auto">
        <ToggleButton x:Name="expandToggle"
                      Margin="8,4"
                      Content="{Binding Header, FallbackValue=List}"
                      ToolTip.Tip="{Binding HoverInfo.Value}"
                      IsChecked="{Binding IsExpanded.Value}"
                      Theme="{DynamicResource PropertyEditorMiniExpanderToggleButton}">
            <ToggleButton.Tag>
                <StackPanel x:Name="headerActions"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4">
                    <Button x:Name="addButton"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Classes="size-24x24"
                            Click="Add_Click"
                            Theme="{StaticResource TransparentButton}">
                        <Button.ContextFlyout>
                            <ui:FAMenuFlyout>
                                <ui:FAMenuFlyoutItem Click="InitializeClick" Text="{x:Static lang:Strings.Initialize}" />
                                <ui:FAMenuFlyoutItem Click="DeleteClick" Text="{x:Static lang:Strings.Remove}" />
                            </ui:FAMenuFlyout>
                        </Button.ContextFlyout>
                        <icons:FluentIcon x:Name="addIcon" Classes.add="{Binding List.Value, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <icons:FluentIcon.Styles>
                                <Style Selector="icons|FluentIcon">
                                    <Setter Property="Icon" Value="MoreVertical" />
                                </Style>
                                <Style Selector="icons|FluentIcon.add">
                                    <Setter Property="Icon" Value="Add" />
                                </Style>
                            </icons:FluentIcon.Styles>
                        </icons:FluentIcon>
                    </Button>
                    <Button x:Name="removeButton"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Classes="size-24x24"
                            IsEnabled="False"
                            Theme="{StaticResource TransparentButton}">
                        <icons:FluentIcon Icon="Subtract" />
                    </Button>
                </StackPanel>
            </ToggleButton.Tag>
        </ToggleButton>

        <Grid x:Name="fixedHeader"
              Margin="8,4"
              ColumnDefinitions="*,Auto">
            <TextBlock x:Name="headerLabel"
                       VerticalAlignment="Center"
                       Text="{Binding Header, FallbackValue=List}"
                       ToolTip.Tip="{Binding HoverInfo.Value}" />
        </Grid>

        <Grid x:Name="expandItem"
              Grid.Row="1"
              IsVisible="False"
              RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="1"
                       IsVisible="{Binding List.Value, Converter={x:Static ObjectConverters.IsNull}}"
                       Text="{x:Static lang:MessageStrings.PropertyUnset}" />

            <ItemsControl x:Name="items"
                          Grid.Row="1"
                          controls:ItemsMotion.RevealsAddedItems="True"
                          ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:ListItemEditor />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</UserControl>
