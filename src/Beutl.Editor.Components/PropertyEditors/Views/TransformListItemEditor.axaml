<local:PresenterListItemEditor x:Class="Beutl.Editor.Components.PropertyEditors.Views.TransformListItemEditor"
                               xmlns="https://github.com/avaloniaui"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:controls="using:Beutl.Controls"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               xmlns:icons="using:FluentIcons.Avalonia.Fluent"
                               xmlns:lang="using:Beutl.Language"
                               xmlns:local="using:Beutl.Editor.Components.PropertyEditors.Views"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:pe="using:Beutl.Controls.PropertyEditors"
                               xmlns:ui="using:FluentAvalonia.UI.Controls"
                               xmlns:viewModel="using:Beutl.Editor.Components.PropertyEditors.ViewModels"
                               d:DesignHeight="450"
                               d:DesignWidth="400"
                               x:CompileBindings="False"
                               mc:Ignorable="d">
    <local:PresenterListItemEditor.Styles>
        <Style Selector="Grid.hidden-item">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </local:PresenterListItemEditor.Styles>
    <local:PresenterListItemEditor.ContextFlyout>
        <ui:FAMenuFlyout Placement="Pointer">
            <ui:FAToggleMenuFlyoutItem IsChecked="{Binding IsEnabled.Value, Mode=TwoWay}"
                                       IsEnabled="{Binding CanEditProperty.Value}"
                                       Text="{x:Static lang:Strings.Visible}" />
            <ui:FAMenuFlyoutItem Click="DeleteClick" Text="{x:Static lang:Strings.Remove}">
                <ui:FAMenuFlyoutItem.IconSource>
                    <icons:FluentIconSource Icon="Delete" />
                </ui:FAMenuFlyoutItem.IconSource>
            </ui:FAMenuFlyoutItem>
        </ui:FAMenuFlyout>
    </local:PresenterListItemEditor.ContextFlyout>
    <!--  The background takes a right click anywhere on the item.  -->
    <Grid Background="Transparent"
          Classes.hidden-item="{Binding !IsEnabled.Value}"
          RowDefinitions="Auto,Auto">
        <!--  The row with the name has room for the buttons, which the menu also offers.  -->
        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding ShowsName.Value}">
            <ToggleButton x:Name="reorderHandle"
                          Content="{Binding TransformName.Value}"
                          Cursor="SizeNorthSouth"
                          IsChecked="{Binding IsExpanded.Value}"
                          Theme="{StaticResource ListEditorMiniExpanderToggleButton}"
                          ToolTip.Tip="{Binding HoverInfo.Value}">
                <ToggleButton.Tag>
                    <ui:FAPathIcon Data="{Binding TransformType.Value, Converter={StaticResource TransformTypeToIconConverter}}" RenderTransform="scale(0.7)" />
                </ToggleButton.Tag>
            </ToggleButton>

            <ToggleButton Grid.Column="1"
                          Margin="4,0,0,0"
                          Padding="0"
                          Classes="size-24x24"
                          IsChecked="{Binding IsEnabled.Value}"
                          IsEnabled="{Binding CanEditProperty.Value}"
                          Theme="{StaticResource VisibilityToggleButtonStyle}" />

            <Button Grid.Column="2"
                    Margin="4,0,8,0"
                    Padding="0"
                    Classes="size-24x24"
                    Click="DeleteClick"
                    Theme="{StaticResource TransparentButton}">
                <icons:FluentIcon Icon="Delete" />
            </Button>
        </Grid>

        <pe:ReferenceEditor x:Name="presenterEditor"
                            Margin="4,0,36,0"
                            EditorStyle="ListItem"
                            IsVisible="{Binding IsPresenter.Value}"
                            SelectTargetRequested="SelectTarget_Requested"
                            ToolTip.Tip="{Binding HoverInfo.Value}"
                            TargetName="{Binding CurrentTargetName.Value}" />

        <Panel x:Name="content" Grid.Row="1">
            <Panel.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsExpanded.Value" />
                    <Binding Path="!IsPresenter.Value" />
                </MultiBinding>
            </Panel.IsVisible>
            <local:ListItemRowsPanel>
                <controls:TreeLineDecorator IsVisible="{Binding !IsFallback.Value}" Theme="{StaticResource ListItemTreeLine}" />

                <local:PropertiesEditor Margin="{StaticResource ListItemContentMargin}"
                                        Padding="0"
                                        DataContext="{Binding Properties.Value}" />

                <ItemsControl Margin="{StaticResource ListItemContentMargin}"
                              DataContext="{Binding Group.Value}"
                              ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:ListItemEditor />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ToggleButton x:Name="inlineHandle"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Cursor="SizeNorthSouth"
                              IsChecked="{Binding IsExpanded.Value}"
                              IsVisible="{Binding !ShowsName.Value}"
                              Theme="{StaticResource ListEditorMiniExpanderToggleButton}"
                              ToolTip.Tip="{Binding TransformName.Value}">
                    <ToggleButton.Tag>
                        <ui:FAPathIcon Data="{Binding TransformType.Value, Converter={StaticResource TransformTypeToIconConverter}}" RenderTransform="scale(0.7)" />
                    </ToggleButton.Tag>
                </ToggleButton>
            </local:ListItemRowsPanel>
        </Panel>
    </Grid>
</local:PresenterListItemEditor>
