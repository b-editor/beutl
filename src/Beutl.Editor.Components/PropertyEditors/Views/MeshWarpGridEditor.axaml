<UserControl x:Class="Beutl.Editor.Components.PropertyEditors.Views.MeshWarpGridEditor"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:lang="using:Beutl.Language"
             xmlns:local="using:Beutl.Editor.Components.PropertyEditors.Views"
             xmlns:pe="using:Beutl.Controls.PropertyEditors"
             xmlns:vm="using:Beutl.Editor.Components.PropertyEditors.ViewModels"
             x:CompileBindings="True"
             x:DataType="vm:MeshWarpGridEditorViewModel"
             Margin="4,0">
    <pe:PropertyEditorGrid ColumnDefinitions="*,Auto,*,Auto">
        <TextBlock Margin="4,0,0,0"
                   VerticalAlignment="Center"
                   Text="{Binding Header}"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding HoverInfo.Value}" />
        <GridSplitter Grid.Column="1" Background="Transparent" />
        <Grid Grid.Column="2" Margin="4" ColumnDefinitions="*,Auto">
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding Summary.Value}"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1"
                    x:Name="resetMeshButton"
                    Padding="6"
                    Command="{Binding ResetMesh}"
                    IsEnabled="{Binding CanEdit.Value}"
                    AutomationProperties.Name="{x:Static lang:GraphicsStrings.MeshWarp_Reset}"
                    ToolTip.Tip="{x:Static lang:GraphicsStrings.MeshWarp_Reset}">
                <icons:FluentIcon Icon="ArrowReset" FontSize="16" />
            </Button>
        </Grid>
        <local:PropertyEditorMenu Grid.Column="3" />
    </pe:PropertyEditorGrid>
</UserControl>
