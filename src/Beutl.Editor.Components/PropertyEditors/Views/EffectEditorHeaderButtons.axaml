<UserControl x:Class="Beutl.Editor.Components.PropertyEditors.Views.EffectEditorHeaderButtons"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             x:CompileBindings="False">
    <StackPanel Orientation="Horizontal" Spacing="4">
        <ToggleButton Padding="0"
                      Classes="size-24x24"
                      IsChecked="{Binding IsEnabled.Value}"
                      IsEnabled="{Binding CanEditProperty.Value}"
                      IsVisible="{Binding !IsGroupOrNull.Value}"
                      Theme="{StaticResource VisibilityToggleButtonStyle}" />

        <Button Padding="0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Classes="size-24x24"
                Click="OnButtonClick"
                Theme="{StaticResource TransparentButton}">
            <icons:FluentIcon Icon="Add" />
        </Button>
    </StackPanel>
</UserControl>
