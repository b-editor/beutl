<UserControl x:Class="Beutl.Editor.Components.PropertyEditors.Views.AudioEffectEditor"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Beutl.Language"
             xmlns:local="using:Beutl.Editor.Components.PropertyEditors.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:viewModel="using:Beutl.Editor.Components.PropertyEditors.ViewModels"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:CompileBindings="False"
             x:DataType="viewModel:AudioEffectEditorViewModel"
             Background="Transparent"
             mc:Ignorable="d">
    <Grid RowDefinitions="Auto,Auto">
        <ToggleButton x:Name="expandToggle"
                      Margin="8,4"
                      IsChecked="{Binding IsExpanded.Value}"
                      Theme="{DynamicResource PropertyEditorMiniExpanderToggleButton}"
                      ToolTip.Tip="{Binding HoverInfo.Value}">
            <ToggleButton.ContextFlyout>
                <ui:FAMenuFlyout>
                    <ui:FAMenuFlyoutItem Click="ChangeEffectTypeClick"
                                       IconSource="New"
                                       Text="{x:Static lang:Strings.Change}" />
                    <ui:FAMenuFlyoutItem Click="SetNullClick" Text="{x:Static lang:Strings.Null}" />
                </ui:FAMenuFlyout>
            </ToggleButton.ContextFlyout>
            <ToggleButton.Tag>
                <local:EffectEditorHeaderButtons Click="Tag_Click" />
            </ToggleButton.Tag>
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Header, FallbackValue=Filter}" />
                <TextBlock Margin="8,0,0,0"
                           IsVisible="{Binding !IsGroupOrNull.Value}"
                           Text="{Binding FilterName.Value}" />
            </WrapPanel>
        </ToggleButton>

        <Panel x:Name="content"
               Grid.Row="1"
               MinHeight="24">
            <local:EffectEditorContent />
        </Panel>
    </Grid>
</UserControl>
