<UserControl x:Class="Beutl.Editor.Components.PathEditorTab.Views.PathEditorTabView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editorConverters="using:Beutl.Controls.Converters"
             xmlns:convert="using:Beutl.Editor.Components.PathEditorTab.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:lang="using:Beutl.Language"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:Beutl.Controls"
             xmlns:editors="using:Beutl.Controls.PropertyEditors"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:views="using:Beutl.Editor.Components.PathEditorTab.Views"
             xmlns:viewModels="using:Beutl.Editor.Components.PathEditorTab.ViewModels"
             x:Name="root"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Focusable="True"
             x:DataType="viewModels:PathEditorTabViewModel"
             RenderOptions.BitmapInterpolationMode="HighQuality"
             mc:Ignorable="d">
    <UserControl.Styles>
        <Style Selector="Button.toolbar">
            <Setter Property="Theme" Value="{StaticResource ToolTabBarIconButtonTheme}" />
        </Style>
        <Style Selector="RadioButton.mode">
            <Setter Property="Theme" Value="{StaticResource LiteNavRadioButton}" />
            <Setter Property="Padding" Value="7,6,5,6" />
        </Style>
        <Style Selector="TextBlock.sectionHeader">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Styles>
    <Grid Name="panel" RowDefinitions="Auto,*" ColumnDefinitions="*,240">
        <controls:ToolTabBar x:Name="EditorToolBar" Grid.ColumnSpan="2">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel x:Name="ToolSlot" Orientation="Horizontal" />
                <StackPanel x:Name="ZoomTools" Grid.Column="2" Orientation="Horizontal" Spacing="0">
                    <Button x:Name="ZoomOutButton" Classes="toolbar" Click="ZoomOutClicked"
                            ToolTip.Tip="{x:Static lang:Strings.PathEditor_ZoomOut}"
                            AutomationProperties.Name="{x:Static lang:Strings.PathEditor_ZoomOut}">
                        <icons:FluentIcon Icon="Subtract" FontSize="16" />
                    </Button>
                    <Button x:Name="ZoomValueButton" Classes="toolbar" MinWidth="46"
                            Click="ResetZoomClicked" Content="100%"
                            ToolTip.Tip="{x:Static lang:Strings.ResetZoom}"
                            AutomationProperties.Name="{x:Static lang:Strings.ResetZoom}" />
                    <Button x:Name="ZoomInButton" Classes="toolbar" Click="ZoomInClicked"
                            ToolTip.Tip="{x:Static lang:Strings.PathEditor_ZoomIn}"
                            AutomationProperties.Name="{x:Static lang:Strings.PathEditor_ZoomIn}">
                        <icons:FluentIcon Icon="Add" FontSize="16" />
                    </Button>
                    <Button x:Name="FitButton" Classes="toolbar" Click="FitClicked"
                            ToolTip.Tip="{x:Static lang:Strings.PathEditor_Fit}"
                            AutomationProperties.Name="{x:Static lang:Strings.PathEditor_Fit}">
                        <icons:FluentIcon Icon="ArrowAutofitWidth" FontSize="16" />
                    </Button>
                    <Button x:Name="CompactSettingsButton" Classes="toolbar" Click="ShowPointSettingsClicked"
                            ToolTip.Tip="{x:Static lang:Strings.PathEditor_PointSettings}"
                            AutomationProperties.Name="{x:Static lang:Strings.PathEditor_PointSettings}">
                        <icons:FluentIcon Icon="Options" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>
        </controls:ToolTabBar>
        <Panel x:Name="Viewport" Grid.Row="1" ClipToBounds="True"
               Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}">
            <Path Name="path"
                  Fill="{DynamicResource TextFillColorPrimaryBrush}"
                  RenderTransform="{Binding #root.Matrix, Converter={x:Static convert:MatrixToTransformConverter.Instance}}"
                  RenderTransformOrigin="0%,0%"
                  StrokeThickness="2" />

            <Canvas Name="canvas" Background="Transparent">
                <Canvas.ContextFlyout>
                    <ui:FAMenuFlyout>
                        <ui:FAMenuFlyoutItem Click="AddOpClicked"
                                           Tag="Cubic"
                                           Text="{x:Static lang:GraphicsStrings.CubicBezierSegment}" />
                        <ui:FAMenuFlyoutItem Click="AddOpClicked"
                                           Tag="Quad"
                                           Text="{x:Static lang:GraphicsStrings.QuadraticBezierSegment}" />
                        <ui:FAMenuFlyoutItem Click="AddOpClicked"
                                           Tag="Line"
                                           Text="{x:Static lang:GraphicsStrings.LineSegment}" />
                        <ui:FAMenuFlyoutItem Click="AddOpClicked"
                                           Tag="Arc"
                                           Text="{x:Static lang:GraphicsStrings.ArcSegment}" />
                        <ui:FAMenuFlyoutItem Click="AddOpClicked"
                                           Tag="Conic"
                                           Text="{x:Static lang:GraphicsStrings.ConicSegment}" />
                        <ui:FAMenuFlyoutSeparator />
                        <ui:FARadioMenuFlyoutItem Click="ToggleDragModeClick"
                                                IsChecked="{Binding Symmetry.Value, Mode=OneWay}"
                                                Tag="Symmetry"
                                                Text="{x:Static lang:Strings.Symmetry}" />
                        <ui:FARadioMenuFlyoutItem Click="ToggleDragModeClick"
                                                IsChecked="{Binding Asymmetry.Value, Mode=OneWay}"
                                                Tag="Asymmetry"
                                                Text="{x:Static lang:Strings.Asymmetry}" />
                        <ui:FARadioMenuFlyoutItem Click="ToggleDragModeClick"
                                                IsChecked="{Binding Separately.Value, Mode=OneWay}"
                                                Tag="Separately"
                                                Text="{x:Static lang:Strings.Separately}" />
                        <ui:FAMenuFlyoutSeparator />
                        <ui:FAMenuFlyoutItem Click="ResetZoomClicked" Text="{x:Static lang:Strings.ResetZoom}" />
                    </ui:FAMenuFlyout>
                </Canvas.ContextFlyout>
            </Canvas>

            <views:PathGeometryControl x:Name="view"
                                       Figure="{Binding PathFigure.Value}"
                                       Geometry="{Binding PathGeometry.Value}"
                                       GeometryResource="{Binding GeometryResource.Value}"
                                       IsHitTestVisible="False"
                                       IsPlaying="{Binding IsPlaying.Value}"
                                       Matrix="{Binding #root.Matrix}"
                                       Scale="{Binding #root.Scale}"
                                       SelectedOperation="{Binding SelectedOperation.Value}" />
            <TextBlock x:Name="EmptyHint" Classes="secondary" Margin="24"
                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="240"
                       TextWrapping="Wrap" TextAlignment="Center" IsHitTestVisible="False"
                       IsVisible="{Binding PathFigure.Value, Converter={x:Static ObjectConverters.IsNull}}"
                       Text="{x:Static lang:Strings.PathEditor_EmptyHint}" />
        </Panel>
        <Border x:Name="Inspector" Grid.Row="1" Grid.Column="1"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <ScrollViewer x:Name="PropertiesScroll" HorizontalScrollBarVisibility="Disabled">
                <Border x:Name="PointProperties" Padding="0,8">
                    <StackPanel Spacing="12">
                        <editors:Vector2Editor x:Name="PointPosition" x:TypeArguments="x:Single"
                                               Header="{x:Static lang:Strings.PathEditor_SelectionPosition}"
                                               FirstHeader="X" SecondHeader="Y" EditorStyle="Compact"
                                               MinWidth="0" NumberFormat="0.##"
                                               ValueChanged="OnPointPositionChanged"
                                               ValueConfirmed="OnPointPositionConfirmed"
                                               AutomationProperties.Name="{x:Static lang:Strings.PathEditor_SelectionPosition}" />
                        <TextBlock x:Name="ActivePointLabel" Margin="8,0" Classes="sectionHeader"
                                   IsVisible="{Binding #PointPosition.IsVisible}"
                                   Text="{x:Static lang:Strings.PathEditor_ActivePoint}" />
                        <ItemsControl x:Name="PointPropertyList" ItemsSource="{Binding PointProperties.Value}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:Object">
                                    <ContentControl Content="{Binding Converter={x:Static editorConverters:PropertyEditorContextToViewConverter.Instance}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Margin="8,0" Spacing="4">
                            <TextBlock Classes="sectionHeader" Text="{x:Static lang:Strings.PathEditor_Handles}" />
                            <StackPanel x:Name="DragModeTools" Orientation="Horizontal" Spacing="4">
                                <RadioButton Classes="mode" Theme="{StaticResource LiteNavRadioButton}" Click="ToggleDragModeClick" GroupName="PathEditor_DragMode"
                                             IsChecked="{Binding Symmetry.Value, Mode=OneWay}" Tag="Symmetry"
                                             AutomationProperties.Name="{x:Static lang:Strings.PathEditor_MirrorBoth}"
                                             ToolTip.Tip="{x:Static lang:Strings.PathEditor_MirrorBoth}">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                          Data="{StaticResource PathEditor_Symmetry}" />
                                </RadioButton>
                                <RadioButton Classes="mode" Theme="{StaticResource LiteNavRadioButton}" Click="ToggleDragModeClick" GroupName="PathEditor_DragMode"
                                             IsChecked="{Binding Asymmetry.Value, Mode=OneWay}" Tag="Asymmetry"
                                             AutomationProperties.Name="{x:Static lang:Strings.PathEditor_MirrorAngle}"
                                             ToolTip.Tip="{x:Static lang:Strings.PathEditor_MirrorAngle}">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                          Data="{StaticResource PathEditor_Asymmetry}" />
                                </RadioButton>
                                <RadioButton Classes="mode" Theme="{StaticResource LiteNavRadioButton}" Click="ToggleDragModeClick" GroupName="PathEditor_DragMode"
                                             IsChecked="{Binding Separately.Value, Mode=OneWay}" Tag="Separately"
                                             AutomationProperties.Name="{x:Static lang:Strings.PathEditor_Independent}"
                                             ToolTip.Tip="{x:Static lang:Strings.PathEditor_Independent}">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                          Data="{StaticResource PathEditor_Separately}" />
                                </RadioButton>
                            </StackPanel>
                        </StackPanel>
                        <Border x:Name="ToolGroupSeparator" Height="1" Margin="8,0"
                                Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        <StackPanel Margin="8,0" Spacing="4">
                            <TextBlock Classes="sectionHeader" Text="{x:Static lang:Strings.PathEditor_Display}" />
                            <StackPanel x:Name="DisplayTools" Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock VerticalAlignment="Center" Text="{x:Static lang:Strings.PathEditor_StrokeLabel}" />
                                    <ToggleButton x:Name="StrokeToggleButton" Grid.Column="1" IsChecked="True"
                                                  Theme="{StaticResource ToolTabVisibilityToggleButtonTheme}"
                                                  AutomationProperties.Name="{x:Static lang:Strings.PathEditor_ShowStroke}"
                                                  ToolTip.Tip="{x:Static lang:Strings.PathEditor_ShowStroke}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock VerticalAlignment="Center" Text="{x:Static lang:Strings.PathEditor_FillLabel}" />
                                    <ToggleButton x:Name="FillToggleButton" Grid.Column="1" IsChecked="True"
                                                  Theme="{StaticResource ToolTabVisibilityToggleButtonTheme}"
                                                  AutomationProperties.Name="{x:Static lang:Strings.PathEditor_ShowFill}"
                                                  ToolTip.Tip="{x:Static lang:Strings.PathEditor_ShowFill}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
