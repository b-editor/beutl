<UserControl x:Class="Beutl.Editor.Components.NodeGraphTab.Views.NodeGraphView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Beutl.Language"
             xmlns:local="using:Beutl.Editor.Components.NodeGraphTab.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:paz="using:Avalonia.Controls.PanAndZoom"
             xmlns:usage="using:Beutl.Editor.Components.Helpers"
             xmlns:viewModel="using:Beutl.Editor.Components.NodeGraphTab.ViewModels"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:DataType="viewModel:NodeGraphViewModel"
             RenderOptions.BitmapInterpolationMode="HighQuality"
             mc:Ignorable="d">
    <ScrollViewer Grid.Row="4"
                  Grid.Column="1"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
        <Panel>
            <local:NodeGraphBackground HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                      IsHitTestVisible="False"
                                      ZoomBorder="{Binding #zoomBorder}" />

            <paz:ZoomBorder Name="zoomBorder"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            ClipToBounds="True"
                            Focusable="True"
                            PanButton="Left"
                            Stretch="None"
                            EnableDoubleClickZoom="False"
                            ZoomSpeed="1.2">
                <paz:ZoomBorder.ContextFlyout>
                    <ui:FAMenuFlyout Opened="CanvasMenuOpened">
                        <ui:FAMenuFlyoutSubItem x:Name="addNode" Text="{x:Static lang:Strings.AddNode}" />
                        <ui:FAMenuFlyoutSubItem x:Name="templatesMenu" Text="{x:Static lang:NodeGraphStrings.Template_Templates}" />
                        <ui:FAMenuFlyoutItem usage:UsageTracking.Feature="NodeGraph.ResetZoom"
                                             Click="ResetZoomClick"
                                             Text="{x:Static lang:Strings.ResetZoom}" />
                        <ui:FAMenuFlyoutSeparator />
                        <ui:FAMenuFlyoutItem usage:UsageTracking.Feature="NodeGraph.RunGenerative"
                                             Click="RunGenerativeClick"
                                             Text="{x:Static lang:NodeGraphStrings.Generative_RunQueue}"
                                             IsEnabled="{Binding CanRunGenerative.Value}" />
                        <ui:FAMenuFlyoutItem usage:UsageTracking.Feature="NodeGraph.StopGenerative"
                                             Click="StopGenerativeClick"
                                             Text="{x:Static lang:NodeGraphStrings.Generative_StopQueue}"
                                             IsVisible="{Binding IsGenerating.Value}" />
                    </ui:FAMenuFlyout>
                </paz:ZoomBorder.ContextFlyout>
                <Canvas x:Name="canvas" />
            </paz:ZoomBorder>

            <local:NodeGraphOverlay x:Name="overlay"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   IsHitTestVisible="False"
                                   ZoomBorder="{Binding #zoomBorder}" />
        </Panel>
    </ScrollViewer>
</UserControl>
