<UserControl x:Class="Beutl.Editor.Components.NodeGraphTab.Views.NodeGraphTabView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Beutl.Language"
             xmlns:local="using:Beutl.Editor.Components.NodeGraphTab.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:viewModel="using:Beutl.Editor.Components.NodeGraphTab.ViewModels"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:CompileBindings="True"
             x:DataType="viewModel:NodeGraphTabViewModel"
             mc:Ignorable="d">
    <Grid RowDefinitions="Auto,*">
        <Border x:Name="NavigationBar"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                ClipToBounds="True"
                IsVisible="{Binding NodeGraph.Value, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="*,Auto">
            <ui:FABreadcrumbBar x:Name="BreadcrumbBar"
                                Margin="8"
                                ItemClicked="BreadcrumbBarItemClicked"
                                ItemsSource="{Binding Items}">
                <ui:FABreadcrumbBar.ItemTemplate>
                    <DataTemplate x:DataType="viewModel:NodeGraphNavigationItem">
                        <ui:FABreadcrumbBarItem Content="{Binding}">
                            <ui:FABreadcrumbBarItem.ContentTemplate>
                                <DataTemplate DataType="viewModel:NodeGraphNavigationItem">
                                    <TextBlock MaxWidth="{Binding $parent[ui:FABreadcrumbBar].Bounds.Width}"
                                               Text="{Binding Name.Value}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Name.Value}" />
                                </DataTemplate>
                            </ui:FABreadcrumbBarItem.ContentTemplate>
                        </ui:FABreadcrumbBarItem>
                    </DataTemplate>
                </ui:FABreadcrumbBar.ItemTemplate>
            </ui:FABreadcrumbBar>
            <StackPanel Grid.Column="1"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                <TextBlock MaxWidth="320"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           IsVisible="{Binding NodeGraph.Value.GenerativeError.Value, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
                           Text="{Binding NodeGraph.Value.GenerativeError.Value, FallbackValue={x:Null}}"
                           TextTrimming="CharacterEllipsis" />
                <Button Click="RunGenerativeClick"
                        Content="{x:Static lang:NodeGraphStrings.Generative_RunQueue}"
                        IsEnabled="{Binding !NodeGraph.Value.IsGenerating.Value, FallbackValue=False}" />
                <Button Click="StopGenerativeClick"
                        Content="{x:Static lang:NodeGraphStrings.Generative_StopQueue}"
                        IsVisible="{Binding NodeGraph.Value.IsGenerating.Value, FallbackValue=False}" />
            </StackPanel>
            </Grid>
        </Border>

        <local:NodeGraphView x:Name="GraphView"
                             Grid.Row="1"
                             ClipToBounds="True"
                             DataContext="{Binding NodeGraph.Value}" />
    </Grid>
</UserControl>
