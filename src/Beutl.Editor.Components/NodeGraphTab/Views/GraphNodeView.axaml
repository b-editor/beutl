<UserControl x:Class="Beutl.Editor.Components.NodeGraphTab.Views.GraphNodeView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:lang="using:Beutl.Language"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pe="using:Beutl.Controls.PropertyEditors"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:viewModels="using:Beutl.Editor.Components.NodeGraphTab.ViewModels"
             xmlns:views="using:Beutl.Editor.Components.NodeGraphTab.Views"
             Canvas.Left="{Binding Position.Value.X}"
             Canvas.Top="{Binding Position.Value.Y}"
             Width="215"
             x:CompileBindings="True"
             x:DataType="viewModels:GraphNodeViewModel"
             Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
             BorderBrush="{DynamicResource ControlElevationBorderBrush}"
             BorderThickness="1"
             Classes.selected="{Binding IsSelected.Value}"
             ClipToBounds="False"
             CornerRadius="{DynamicResource ControlCornerRadius}"
             mc:Ignorable="d">
    <UserControl.Styles>
        <Style Selector=":is(Control).property-editor-menu">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- Include editors created inside composite controls, not only port-backed rows. -->
        <Style Selector=":is(pe|PropertyEditor)">
            <Setter Property="EditorStyle" Value="Compact" />
        </Style>
        <!-- Root rows keep the original theme minimum width and horizontal layout. -->
        <Style Selector="views|NodePortView.nested :is(pe|PropertyEditor), :is(pe|PropertyEditor):list-item">
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style Selector="views|GraphNodeView.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
        </Style>
    </UserControl.Styles>
    <!--  BoxShadow="0 32 64 #47000000, 0 2 21 #38000000">  -->
    <!--  BoxShadow="0 32 64 #8E000000, 0 2 21 #8C000000">  -->
    <Grid RowDefinitions="Auto,Auto">
        <Border x:Name="handle"
                Padding="4"
                Background="{Binding Color}"
                CornerRadius="{DynamicResource ControlCornerRadius}"
                Focusable="True"
                ToolTip.Tip="{Binding NodeName.Value}">
            <Border.ContextFlyout>
                <ui:FAMenuFlyout Opening="NodeMenuOpening">
                    <ui:FAMenuFlyoutItem Command="{Binding Delete}"
                                       InputGesture="Delete"
                                       Text="{x:Static lang:Strings.Delete}">
                        <ui:FAMenuFlyoutItem.IconSource>
                            <icons:FluentIconSource Icon="Delete" />
                        </ui:FAMenuFlyoutItem.IconSource>
                    </ui:FAMenuFlyoutItem>
                    <ui:FAMenuFlyoutItem Click="RegenerateClick"
                                       IsVisible="{Binding IsGenerative}"
                                       Text="{x:Static lang:NodeGraphStrings.Generative_RegenerateNode}">
                        <ui:FAMenuFlyoutItem.IconSource>
                            <icons:FluentIconSource Icon="Sparkle" />
                        </ui:FAMenuFlyoutItem.IconSource>
                    </ui:FAMenuFlyoutItem>
                    <ui:FAMenuFlyoutSubItem IsVisible="{Binding IsGenerative}"
                                            Text="{x:Static lang:NodeGraphStrings.Generative_Variations}">
                        <ui:FAMenuFlyoutSubItem.IconSource>
                            <icons:FluentIconSource Icon="Grid" />
                        </ui:FAMenuFlyoutSubItem.IconSource>
                        <ui:FAMenuFlyoutItem Click="Variations2Click" x:Name="Variations2Item" />
                        <ui:FAMenuFlyoutItem Click="Variations4Click" x:Name="Variations4Item" />
                    </ui:FAMenuFlyoutSubItem>
                    <ui:FAMenuFlyoutItem x:Name="CompareItem"
                                       Click="CompareClick"
                                       IsVisible="{Binding IsGenerative}"
                                       Text="{x:Static lang:NodeGraphStrings.Generative_Compare}">
                        <ui:FAMenuFlyoutItem.IconSource>
                            <icons:FluentIconSource Icon="ImageMultiple" />
                        </ui:FAMenuFlyoutItem.IconSource>
                    </ui:FAMenuFlyoutItem>
                    <ui:FAMenuFlyoutSubItem x:Name="PromptLibraryMenu"
                                            IsVisible="{Binding IsPromptTarget}"
                                            Text="{x:Static lang:NodeGraphStrings.Generative_PromptLibrary}">
                        <ui:FAMenuFlyoutSubItem.IconSource>
                            <icons:FluentIconSource Icon="Library" />
                        </ui:FAMenuFlyoutSubItem.IconSource>
                    </ui:FAMenuFlyoutSubItem>
                    <ui:FAMenuFlyoutSubItem x:Name="GenerationHistoryMenu"
                                            IsVisible="{Binding IsGenerative}"
                                            Text="{x:Static lang:NodeGraphStrings.Generative_History}">
                        <ui:FAMenuFlyoutSubItem.IconSource>
                            <icons:FluentIconSource Icon="History" />
                        </ui:FAMenuFlyoutSubItem.IconSource>
                    </ui:FAMenuFlyoutSubItem>
                    <ui:FAMenuFlyoutItem Click="SaveTemplateClick"
                                       IsVisible="{Binding IsGroup}"
                                       Text="{x:Static lang:NodeGraphStrings.Template_SaveAs}">
                        <ui:FAMenuFlyoutItem.IconSource>
                            <icons:FluentIconSource Icon="Save" />
                        </ui:FAMenuFlyoutItem.IconSource>
                    </ui:FAMenuFlyoutItem>
                    <ui:FAMenuFlyoutItem Click="RenameClick" Text="{x:Static lang:Strings.Rename}">
                        <ui:FAMenuFlyoutItem.IconSource>
                            <icons:FluentIconSource Icon="Rename" />
                        </ui:FAMenuFlyoutItem.IconSource>
                    </ui:FAMenuFlyoutItem>
                </ui:FAMenuFlyout>
            </Border.ContextFlyout>
            <Border.KeyBindings>
                <KeyBinding Command="{Binding Delete}" Gesture="Delete" />
            </Border.KeyBindings>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <ToggleButton x:Name="expandToggle"
                              Width="30"
                              Padding="5"
                              VerticalAlignment="Stretch"
                              IsChecked="{Binding IsExpanded.Value}"
                              Theme="{StaticResource ExpandCollapseToggleButtonStyle}" />

                <TextBlock Grid.Column="1"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Text="{Binding NodeName.Value}"
                           TextTrimming="CharacterEllipsis" />

                <Button Grid.Column="2"
                        Click="OpenNodeClick"
                        IsVisible="{Binding IsGroupNode}"
                        Theme="{StaticResource TransparentButton}">
                    <icons:FluentIcon Icon="Open" />
                </Button>
            </Grid>
        </Border>
        <Border x:Name="nodeContent"
                Grid.Row="1"
                Padding="0,0,0,8"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                ClipToBounds="False">
            <StackPanel x:Name="stackPanel">
                <ItemsControl x:Name="itemsControl"
                              ClipToBounds="False"
                              ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:NodePortView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <views:NodePortOverlay x:Name="nestedPortOverlay"
                               Grid.RowSpan="2"
                               ClipToBounds="False"
                               IsVisible="{Binding IsExpanded.Value}" />
    </Grid>
</UserControl>
