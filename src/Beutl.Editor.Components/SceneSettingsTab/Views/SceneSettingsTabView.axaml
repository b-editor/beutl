<UserControl x:Class="Beutl.Editor.Components.SceneSettingsTab.Views.SceneSettingsTabView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:Beutl.Editor.Components.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Beutl.Language"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pe="using:Beutl.Controls.PropertyEditors"
             xmlns:usage="using:Beutl.Editor.Components.Helpers"
             xmlns:viewModel="using:Beutl.Editor.Components.SceneSettingsTab.ViewModels"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:CompileBindings="True"
             x:DataType="viewModel:SceneSettingsTabViewModel"
             mc:Ignorable="d">
    <ScrollViewer x:Name="SettingsScrollViewer"
                  BringIntoViewOnFocusChange="True"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="4">
            <pe:Vector2Editor x:Name="sizeEditor"
                              x:TypeArguments="x:Int32"
                              Margin="4,8,4,0"
                              FirstHeader="{x:Static lang:Strings.Width}"
                              Header="{x:Static lang:Strings.Size}"
                              SecondHeader="{x:Static lang:Strings.Height}" />

            <TextBlock Margin="8,8,8,0" Text="{x:Static lang:Strings.StartTime}" />
            <TextBox x:Name="StartInputTextBox" Margin="8,0" Text="{Binding StartInput.Value, Mode=TwoWay}" />

            <TextBlock Margin="8,8,8,0" Text="{x:Static lang:Strings.DurationTime}" />
            <TextBox x:Name="DurationInputTextBox" Margin="8,0" Text="{Binding DurationInput.Value, Mode=TwoWay}" />

            <pe:NumberEditor x:Name="countEditor"
                             x:TypeArguments="x:Int32"
                             Margin="4,8,4,0"
                             EditorStyle="Compact"
                             Header="{x:Static lang:Strings.Number_of_Layers}" />

            <TextBlock Margin="8,8,8,0" Text="{x:Static lang:Strings.ProjectAudioChannels}" />
            <ComboBox x:Name="ChannelLayoutComboBox"
                      Margin="8,0" HorizontalAlignment="Stretch"
                      SelectedIndex="{Binding ChannelLayout.Value, Mode=TwoWay, Converter={x:Static converters:EnumIndexConverters.SpeakerLayouts}}">
                <ComboBoxItem Content="{x:Static lang:Strings.SpeakerLayout_Mono}" />
                <ComboBoxItem Content="{x:Static lang:Strings.SpeakerLayout_Stereo}" />
                <ComboBoxItem Content="{x:Static lang:Strings.SpeakerLayout_Surround51}" />
                <ComboBoxItem Content="{x:Static lang:Strings.SpeakerLayout_Surround71}" />
            </ComboBox>

            <WrapPanel x:Name="ActionButtons" Margin="8" ItemSpacing="4" LineSpacing="4">
                <Button x:Name="ApplyButton"
                        usage:UsageTracking.Feature="SceneSettings.Apply"
                        Classes="accent"
                        Command="{Binding Apply}">
                    <TextBlock Text="{x:Static lang:Strings.Apply}" TextAlignment="Center" TextWrapping="Wrap" />
                </Button>
                <Button x:Name="RevertButton"
                        usage:UsageTracking.Feature="SceneSettings.Revert"
                        Command="{Binding Revert}">
                    <TextBlock Text="{x:Static lang:Strings.DiscardChanges}" TextAlignment="Center" TextWrapping="Wrap" />
                </Button>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
