<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Beutl.Controls"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:lang="using:Beutl.Language"
             xmlns:local="using:Beutl.Editor.Components.CutDetectionTab.Views"
             xmlns:vm="using:Beutl.Editor.Components.CutDetectionTab.ViewModels"
             x:Class="Beutl.Editor.Components.CutDetectionTab.Views.CutDetectionTabView"
             x:DataType="vm:CutDetectionTabViewModel"
             x:CompileBindings="True">
    <UserControl.Styles>
        <Style Selector="TextBlock.secondary">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto">
        <controls:ToolTabBar x:Name="ToolBar">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding TargetName.Value}"
                           Theme="{StaticResource ToolTabBarTitleTextBlockTheme}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding TargetName.Value}" />
                <Button x:Name="RefreshButton" Grid.Column="1"
                        Click="OnRefreshClick" IsEnabled="{Binding !IsApplying.Value}"
                        Theme="{StaticResource ToolTabBarIconButtonTheme}"
                        AutomationProperties.Name="{x:Static lang:Strings.Refresh}"
                        ToolTip.Tip="{x:Static lang:Strings.Refresh}">
                    <icons:FluentIcon FontSize="16" Icon="ArrowClockwise" />
                </Button>
            </Grid>
        </controls:ToolTabBar>

        <TextBlock Grid.Row="1" Margin="16" Classes="secondary"
                   IsVisible="{Binding !HasAnalysis.Value}"
                   Text="{x:Static lang:Strings.CutDetection_SelectVideo}" />
        <ScrollViewer x:Name="BodyScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding HasAnalysis.Value}" IsEnabled="{Binding !IsApplying.Value}">
            <Grid x:Name="ContentLayout" RowDefinitions="Auto,Auto" ColumnDefinitions="*">
                <Grid x:Name="PreviewPane" Margin="8" RowDefinitions="*,Auto" RowSpacing="8" Background="Transparent">
                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" Padding="8">
                        <Grid Background="Transparent" ClipToBounds="True">
                            <local:CutPreviewControl x:Name="Preview" Height="140" MinHeight="90" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" ColumnDefinitions="*,*">
                        <TextBlock x:Name="PreviewStartTime" Classes="secondary" />
                        <TextBlock x:Name="PreviewEndTime" Grid.Column="1" Classes="secondary" HorizontalAlignment="Right" />
                    </Grid>
                </Grid>

                <ScrollViewer x:Name="OptionsScroll" Grid.Row="1" Margin="8" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="OptionsStack" Spacing="12">
                        <Border x:Name="ParameterGroup" Classes="options-group" Padding="12">
                            <Grid ColumnDefinitions="*,120" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                <TextBlock Text="{x:Static lang:Strings.CutDetection_Threshold}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <NumericUpDown Grid.Column="1" Minimum="0.01" Maximum="1" Increment="0.01" VerticalAlignment="Center"
                                               FormatString="0.00" Value="{Binding Analysis.Value.Threshold.Value}"
                                               AutomationProperties.Name="{x:Static lang:Strings.CutDetection_Threshold}" />
                                <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="0.01" Maximum="1" TickFrequency="0.01"
                                        IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                        Value="{Binding Analysis.Value.ThresholdSlider.Value}"
                                        AutomationProperties.Name="{x:Static lang:Strings.CutDetection_Threshold}" />
                                <TextBlock Grid.Row="2" Text="{x:Static lang:Strings.CutDetection_Minimum}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="20" Maximum="3600000" Increment="20" VerticalAlignment="Center"
                                               Value="{Binding Analysis.Value.MinimumMilliseconds.Value}"
                                               AutomationProperties.Name="{x:Static lang:Strings.CutDetection_Minimum}" />
                            </Grid>
                        </Border>

                        <CheckBox x:Name="Linked" IsVisible="{Binding Analysis.Value.HasLinkedElements}"
                                  IsChecked="{Binding Analysis.Value.IncludeLinked.Value}">
                            <TextBlock Text="{x:Static lang:Strings.CutDetection_Linked}" TextWrapping="Wrap" />
                        </CheckBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="12" IsVisible="{Binding HasAnalysis.Value}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid x:Name="FooterLayout" RowDefinitions="Auto,Auto" ColumnDefinitions="*" RowSpacing="8" ColumnSpacing="16">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,8,0" Background="#F5962D"
                                IsVisible="{Binding Analysis.Value.CanApply.Value}" />
                        <TextBlock x:Name="StatusText" Grid.Column="1" Text="{Binding Analysis.Value.Status.Value}" Classes="secondary" />
                        <Button x:Name="CancelButton" Grid.Column="2" Content="{x:Static lang:Strings.CutDetection_Cancel}"
                                Click="OnCancelClick" Padding="12,2" VerticalAlignment="Center"
                                IsVisible="{Binding Analysis.Value.IsBusy.Value}"
                                IsEnabled="{Binding !IsApplying.Value}" />
                    </Grid>
                    <ProgressBar x:Name="OperationProgress" Height="4" Maximum="100"
                                 Value="{Binding Analysis.Value.Progress.Value}" IsVisible="{Binding Analysis.Value.IsBusy.Value}"
                                 IsIndeterminate="{Binding Analysis.Value.IsProgressIndeterminate.Value}"
                                 AutomationProperties.Name="{Binding Analysis.Value.Status.Value}" />
                </StackPanel>
                <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button x:Name="SplitButton" Content="{x:Static lang:Strings.CutDetection_Split}" Classes="accent"
                            HorizontalAlignment="Stretch" Click="OnSplitClick">
                        <Button.IsEnabled>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="Analysis.Value.CanApply.Value" />
                                <Binding Path="!IsApplying.Value" />
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>
                    <Button x:Name="MarkersButton" Grid.Column="1" Content="{x:Static lang:Strings.CutDetection_AddMarkers}"
                            HorizontalAlignment="Stretch" Click="OnAddMarkersClick">
                        <Button.IsEnabled>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="Analysis.Value.CanApply.Value" />
                                <Binding Path="!IsApplying.Value" />
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
