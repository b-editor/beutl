<UserControl x:Class="Beutl.Editor.Components.GraphEditorTab.Views.GraphEditorView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Beutl.Controls"
             xmlns:convert="using:Beutl.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:lang="using:Beutl.Language"
             xmlns:local="using:Beutl.Editor.Components.GraphEditorTab.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:paz="using:Avalonia.Controls.PanAndZoom"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:usage="using:Beutl.Editor.Components.Helpers"
             xmlns:viewModel="using:Beutl.Editor.Components.GraphEditorTab.ViewModels"
             xmlns:views="using:Beutl.Editor.Components.Views"
             x:Name="root"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:CompileBindings="True"
             x:DataType="viewModel:GraphEditorViewModel"
             Focusable="True"
             mc:Ignorable="d">
    <Grid x:Name="grid"
          Background="{DynamicResource GraphEditorBackgroundBrush}"
          ColumnDefinitions="Auto,*"
          RowDefinitions="Auto,*,Auto">

        <Border Grid.ColumnSpan="2"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="{DynamicResource ToolTabBarBorderThickness}"
                IsHitTestVisible="False" />

        <Border Grid.Row="0" Grid.Column="0" Background="Transparent" />

        <Border x:Name="RulerBar"
                Grid.Column="1"
                Height="{DynamicResource ToolTabBarMinHeight}"
                Background="Transparent">
            <views:TimelineScale x:Name="scale"
                                 Height="32"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Bottom"
                                 EndingBarBrush="{DynamicResource SystemFillColorCriticalBrush}"
                                 EndingBarMargin="{Binding EndingBarMargin.Value}"
                                 Scale="{Binding Options.Value.Scale}"
                                 ScaleBrush="{DynamicResource TextControlForeground}"
                                 SeekBarBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                 SeekBarMargin="{Binding SeekBarMargin.Value}"
                                 StartingBarBrush="{DynamicResource SystemFillColorCriticalBrush}"
                                 StartingBarMargin="{Binding StartingBarMargin.Value}"
                                 Offset="{Binding #scroll.Offset, Mode=OneWay}" />
        </Border>

        <!--  Match the plot viewport for both overlay and inset scrollbar themes.  -->
        <local:GraphEditorScale x:Name="verticalScale"
                      Grid.Row="1"
                                Width="56"
                                Height="{Binding #scroll.Viewport.Height}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Baseline="{Binding Baseline.Value}"
                                Scale="{Binding ScaleY.Value}"
                                Offset="{Binding #scroll.Offset, Mode=OneWay}" />

        <ScrollViewer x:Name="scroll" SizeChanged="OnGraphViewportChanged"
                      Grid.Row="1"
                      Grid.Column="1"
                      HorizontalScrollBarVisibility="Visible">
            <Panel x:Name="graphPanel"
                   Width="{Binding PanelWidth.Value}"
                   MinWidth="{Binding #scroll.Bounds.Width}"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Stretch"
                   Background="{DynamicResource GraphEditorBackgroundBrush}">
                <Panel.ContextMenu>
                    <ContextMenu>
                        <MenuItem usage:UsageTracking.Feature="GraphEditor.ValueGraph"
                                  Click="GraphActionClick"
                                  Header="{x:Static lang:Strings.GraphValueGraph}"
                                  IsChecked="{Binding !IsSpeedGraph.Value, Mode=OneWay}"
                                  Tag="ValueGraph"
                                  ToggleType="Radio" />
                        <MenuItem usage:UsageTracking.Feature="GraphEditor.SpeedGraph"
                                  Click="GraphActionClick"
                                  Header="{x:Static lang:Strings.GraphSpeedGraph}"
                                  IsChecked="{Binding IsSpeedGraph.Value, Mode=OneWay}"
                                  Tag="SpeedGraph"
                                  ToggleType="Radio" />
                        <Separator />
                        <MenuItem usage:UsageTracking.Feature="GraphEditor.Ease"
                                  Click="GraphActionClick"
                                  Header="{x:Static lang:Strings.GraphEasyEase}"
                                  Tag="Ease" />
                        <MenuItem usage:UsageTracking.Feature="GraphEditor.EaseIn"
                                  Click="GraphActionClick"
                                  Header="{x:Static lang:Strings.GraphEasyEaseIn}"
                                  Tag="EaseIn" />
                        <MenuItem usage:UsageTracking.Feature="GraphEditor.EaseOut"
                                  Click="GraphActionClick"
                                  Header="{x:Static lang:Strings.GraphEasyEaseOut}"
                                  Tag="EaseOut" />
                        <MenuItem usage:UsageTracking.Feature="GraphEditor.Velocity"
                                  Click="GraphActionClick"
                                  Header="{x:Static lang:Strings.GraphVelocity}"
                                  Tag="Velocity" />
                        <Separator />
                        <MenuItem usage:UsageTracking.Feature="GraphEditor.CopyAllKeyFramesCommand"
                                  Command="{Binding CopyAllKeyFramesCommand}"
                                  Header="{x:Static lang:Strings.CopyAll}">
                            <MenuItem.Icon>
                                <icons:FluentIcon Icon="DocumentCopy" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem usage:UsageTracking.Feature="GraphEditor.PasteKeyFrameAtCurrentPositionCommand"
                                  Command="{Binding PasteKeyFrameAtCurrentPositionCommand}"
                                  Header="{x:Static lang:Strings.Paste}">
                            <MenuItem.Icon>
                                <icons:FluentIcon Icon="ClipboardPaste" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem usage:UsageTracking.Feature="GraphEditor.Zoom"
                                  Header="{x:Static lang:Strings.TimelineZoom}"
                                  MenuItem.Click="ZoomClick">
                            <MenuItem.Icon>
                                <icons:FluentIcon Icon="ZoomIn" />
                            </MenuItem.Icon>
                            <MenuItem CommandParameter="8.75" Header="875%" />
                            <MenuItem CommandParameter="7.0" Header="700%" />
                            <MenuItem CommandParameter="3.5" Header="350%" />
                            <MenuItem CommandParameter="2.0" Header="200%" />
                            <MenuItem CommandParameter="1.7" Header="170%" />
                            <MenuItem CommandParameter="1.5" Header="150%" />
                            <MenuItem CommandParameter="1.2" Header="120%" />
                            <MenuItem CommandParameter="1.0" Header="100%" />
                            <MenuItem CommandParameter="0.7" Header="70%" />
                            <MenuItem CommandParameter="0.5" Header="50%" />
                            <MenuItem CommandParameter="0.2" Header="20%" />
                            <MenuItem CommandParameter="0.1" Header="10%" />
                            <MenuItem CommandParameter="0.05" Header="5%" />
                            <MenuItem CommandParameter="0.01" Header="1%" />
                        </MenuItem>
                        <MenuItem usage:UsageTracking.Feature="GraphEditor.SelectedView"
                                  Header="{x:Static lang:Strings.View}"
                                  IsEnabled="{Binding !!Views.Length}"
                                  ItemsSource="{Binding Views}"
                                  MenuItem.Click="SelectedView_Click">
                            <!--  https://github.com/AvaloniaUI/Avalonia/issues/9696
                            <MenuItem.ItemTemplate>
                                <DataTemplate x:DataType="viewModel:GraphEditorViewViewModel">
                                    ...
                                </DataTemplate>
                            </MenuItem.ItemTemplate>
                            -->

                            <MenuItem.DataTemplates>
                                <DataTemplate x:DataType="viewModel:GraphEditorViewViewModel">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <ui:FAPathIcon Margin="6,0,16,0"
                                                       VerticalAlignment="Center"
                                                       Classes.transparent="{Binding !IsSelected.Value}"
                                                       Data="M0,2a2,2 0 1,0 4,0a2,2 0 1,0 -4,0"
                                                       Foreground="{DynamicResource MenuFlyoutSubItemChevron}"
                                                       UseLayoutRounding="False" />

                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" />
                                    </Grid>
                                </DataTemplate>
                            </MenuItem.DataTemplates>
                        </MenuItem>
                        <MenuItem usage:UsageTracking.Feature="GraphEditor.ShowBpmGridFlyout"
                                  Click="ShowBpmGridFlyout"
                                  Header="{x:Static lang:Strings.BpmGrid}">
                            <MenuItem.Icon>
                                <icons:FluentIcon Icon="MusicNote1" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem usage:UsageTracking.Feature="GraphEditor.ToggleUseGlobalClock"
                                  Command="{Binding ToggleUseGlobalClock}"
                                  Header="{x:Static lang:Strings.UseGlobalClock}"
                                  IsChecked="{Binding UseGlobalClock.Value, Mode=OneWay}"
                                  ToggleType="CheckBox" />
                    </ContextMenu>
                </Panel.ContextMenu>

                <local:GraphEditorBackground x:Name="background" IsSpeedGraph="{Binding IsSpeedGraph.Value}"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             Baseline="{Binding Baseline.Value}"
                                             Maximum="{Binding Factory.MaxValue}"
                                             Minimum="{Binding Factory.MinValue}"
                                             Scale="{Binding ScaleY.Value}"
                                             Viewport="{Binding #scroll.Viewport, Mode=OneWay}"
                                             Offset="{Binding #scroll.Offset, Mode=OneWay}" />

                <local:GraphEditorSpeedGraph x:Name="SpeedGraph"
                                             IsVisible="{Binding IsSpeedGraph.Value}" />

                <local:GraphEditorSelectionAdorner x:Name="SelectionAdorner"
                                                   IsHitTestVisible="False" ZIndex="5" />

                <views:BpmGridOverlay x:Name="BpmGrid"
                                      VerticalAlignment="Stretch"
                                      BeatBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                      BpmOptions="{Binding Options.Value.BpmGrid}"
                                      Scale="{Binding Options.Value.Scale}"
                                      SubdivisionBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                      Viewport="{Binding #scroll.Viewport, Mode=OneWay}"
                                      ZIndex="1"
                                      Offset="{Binding #scroll.Offset, Mode=OneWay}" />

                <!--  Vector, Pointなど複数の値を持つ型のためにビューを分ける  -->
                <ItemsControl IsVisible="{Binding !IsSpeedGraph.Value}" x:Name="views"
                              Margin="{Binding Margin.Value}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ClipToBounds="False"
                              ItemsSource="{Binding Views}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Panel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModel:GraphEditorViewViewModel">
                            <Panel IsEnabled="{Binding IsSelected.Value}" IsHitTestVisible="{Binding IsSelected.Value}">
                                <Panel.Styles>
                                    <Style Selector="local|EaseLine:disabled">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </Style>
                                </Panel.Styles>
                                <!--  イージングの線  -->
                                <ItemsControl HorizontalAlignment="Left"
                                              VerticalAlignment="Stretch"
                                              ClipToBounds="False"
                                              ItemTemplate="{StaticResource GraphEditorEaseLineTemplate}"
                                              ItemsSource="{Binding KeyFrames}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Panel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <!--  SplineEasingの編集ポイント、キーフレームの移動ポイント  -->
                                <ItemsControl HorizontalAlignment="Left"
                                              VerticalAlignment="Stretch"
                                              ClipToBounds="False"
                                              IsVisible="{Binding IsSelected.Value}"
                                              ItemTemplate="{StaticResource GraphEditorKeyFramePointsTemplate}"
                                              ItemsSource="{Binding KeyFrames}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Panel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <views:TimelineOverlay x:Name="overlay"
                                       VerticalAlignment="Stretch"
                                       EndingBarBrush="{DynamicResource SystemFillColorCriticalBrush}"
                                       EndingBarMargin="{Binding EndingBarMargin.Value}"
                                       SeekBarBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                       SeekBarMargin="{Binding SeekBarMargin.Value}"
                                       StartingBarBrush="{DynamicResource SystemFillColorCriticalBrush}"
                                       StartingBarMargin="{Binding StartingBarMargin.Value}"
                                       Viewport="{Binding #scroll.Viewport, Mode=OneWay}"
                                       ZIndex="6"
                                       Offset="{Binding #scroll.Offset, Mode=OneWay}" />

                <Border Width="{Binding ElementWidth.Value, Mode=OneWay}"
                        Margin="{Binding ElementMargin.Value, Mode=OneWay}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        BorderBrush="{Binding ElementColor.Value}"
                        BorderThickness="1,0" />

            </Panel>
        </ScrollViewer>
        <controls:ToolTabBar x:Name="GraphToolBarHost" Grid.Row="2" Grid.ColumnSpan="2"
                             BorderThickness="0,1,0,0">
            <WrapPanel x:Name="GraphToolbar" ItemSpacing="4" LineSpacing="4">
                <WrapPanel.Styles>
                    <Style Selector="Button"><Setter Property="Theme" Value="{StaticResource ToolTabBarIconButtonTheme}" /></Style>
                    <Style Selector="ToggleButton">
                        <Setter Property="Theme" Value="{StaticResource ColorPickerTypeTransparentToggleButtonStyle}" />
                        <Setter Property="Padding" Value="{DynamicResource ToolTabBarIconButtonPadding}" />
                    </Style>
                    <Style Selector="Path">
                        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                        <Setter Property="StrokeThickness" Value="1" />
                        <Setter Property="StrokeLineCap" Value="Round" />
                        <Setter Property="StrokeJoin" Value="Round" />
                        <Setter Property="Width" Value="14" /><Setter Property="Height" Value="14" />
                        <Setter Property="Margin" Value="1" />
                        <Setter Property="Stretch" Value="Uniform" />
                    </Style>
                </WrapPanel.Styles>

                <ComboBox x:Name="GraphTypePicker" VerticalAlignment="Center"
                          Theme="{StaticResource LiteComboBoxStyle}"
                          SelectionChanged="GraphTypeSelectionChanged"
                          ToolTip.Tip="{x:Static lang:Strings.GraphTypeHint}"
                          AutomationProperties.Name="{x:Static lang:Strings.GraphTypeHint}">
                    <ComboBoxItem Content="{x:Static lang:Strings.GraphValueGraph}" />
                    <ComboBoxItem Content="{x:Static lang:Strings.GraphSpeedGraph}" />
                </ComboBox>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Tag="Snap" IsChecked="{Binding Snap.Value}" ToolTip.Tip="{x:Static lang:Strings.GraphSnap}"
                                  AutomationProperties.Name="{x:Static lang:Strings.GraphSnap}">
                        <Path Data="M3,2 L3,9 C3,15 13,15 13,9 L13,2 M3,5 L6,5 M10,5 L13,5" />
                    </ToggleButton>
                    <ToggleButton Tag="TransformBox" IsChecked="{Binding ShowTransformBox.Value}" ToolTip.Tip="{x:Static lang:Strings.GraphTransformBox}"
                                  AutomationProperties.Name="{x:Static lang:Strings.GraphTransformBox}">
                        <Path Data="M3,3 L13,3 13,13 3,13 Z M1,1 L5,1 5,5 1,5 Z M11,11 L15,11 15,15 11,15 Z" />
                    </ToggleButton>
                    <ToggleButton Tag="AutoHeight" IsChecked="{Binding AutoZoomHeight.Value}" ToolTip.Tip="{x:Static lang:Strings.GraphAutoZoomHeight}"
                                  AutomationProperties.Name="{x:Static lang:Strings.GraphAutoZoomHeight}">
                        <Path Data="M8,1 L8,15 M5,4 L8,1 11,4 M5,12 L8,15 11,12 M1,1 L3,1 M13,15 L15,15" />
                    </ToggleButton>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button usage:UsageTracking.Feature="GraphEditor.FitAll"
                            AutomationProperties.Name="{x:Static lang:Strings.GraphFitAll}"
                            Click="GraphActionClick"
                            Tag="FitAll"
                            ToolTip.Tip="{x:Static lang:Strings.GraphFitAll}">
                        <Path Data="M1,6 L1,1 6,1 M10,1 L15,1 15,6 M15,10 L15,15 10,15 M6,15 L1,15 1,10 M4,11 C8,11 8,5 12,5" />
                    </Button>
                    <Button usage:UsageTracking.Feature="GraphEditor.FitSelection"
                            AutomationProperties.Name="{x:Static lang:Strings.GraphFitSelection}"
                            Click="GraphActionClick"
                            IsEnabled="{Binding HasSelection.Value}"
                            Tag="FitSelection"
                            ToolTip.Tip="{x:Static lang:Strings.GraphFitSelection}">
                        <Path Data="M1,5 L1,1 5,1 M11,1 L15,1 15,5 M15,11 L15,15 11,15 M5,15 L1,15 1,11 M8,4 L12,8 8,12 4,8 Z" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button usage:UsageTracking.Feature="GraphEditor.Linear"
                            AutomationProperties.Name="{x:Static lang:Strings.Linear}"
                            Click="GraphActionClick"
                            IsEnabled="{Binding HasSelection.Value}"
                            Tag="Linear"
                            ToolTip.Tip="{x:Static lang:Strings.Linear}">
                        <Path Data="M2,13 L14,3 M1,12 L3,12 3,14 1,14 Z M13,2 L15,2 15,4 13,4 Z" />
                    </Button>
                    <Button usage:UsageTracking.Feature="GraphEditor.Ease"
                            AutomationProperties.Name="{x:Static lang:Strings.GraphEasyEase}"
                            Click="GraphActionClick"
                            IsEnabled="{Binding HasSelection.Value}"
                            Tag="Ease"
                            ToolTip.Tip="{x:Static lang:Strings.GraphEasyEase}">
                        <Path Data="M1,13 C12,13 4,3 15,3 M1,11 L1,15 M15,1 L15,5" />
                    </Button>
                    <Button usage:UsageTracking.Feature="GraphEditor.EaseIn"
                            AutomationProperties.Name="{x:Static lang:Strings.GraphEasyEaseIn}"
                            Click="GraphActionClick"
                            IsEnabled="{Binding HasSelection.Value}"
                            Tag="EaseIn"
                            ToolTip.Tip="{x:Static lang:Strings.GraphEasyEaseIn}">
                        <Path Data="M1,13 C5,7 8,3 15,3 M15,1 L15,5" />
                    </Button>
                    <Button usage:UsageTracking.Feature="GraphEditor.EaseOut"
                            AutomationProperties.Name="{x:Static lang:Strings.GraphEasyEaseOut}"
                            Click="GraphActionClick"
                            IsEnabled="{Binding HasSelection.Value}"
                            Tag="EaseOut"
                            ToolTip.Tip="{x:Static lang:Strings.GraphEasyEaseOut}">
                        <Path Data="M1,13 C8,13 11,9 15,3 M1,11 L1,15" />
                    </Button>
                    <Button usage:UsageTracking.Feature="GraphEditor.Hold"
                            AutomationProperties.Name="{x:Static lang:Strings.Hold}"
                            Click="GraphActionClick"
                            IsEnabled="{Binding HasSelection.Value}"
                            Tag="Hold"
                            ToolTip.Tip="{x:Static lang:Strings.Hold}">
                        <Path Data="M1,13 L8,13 8,3 15,3" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="VelocityButton"
                            usage:UsageTracking.Feature="GraphEditor.Velocity"
                            AutomationProperties.Name="{x:Static lang:Strings.GraphVelocity}"
                            Click="GraphActionClick"
                            IsEnabled="{Binding HasSelection.Value}"
                            Tag="Velocity"
                            ToolTip.Tip="{x:Static lang:Strings.GraphVelocity}">
                        <Path Data="M2,14 L2,2 M2,12 C8,12 6,4 12,4 M10,7 L14,7 M12,5 L12,9" />
                    </Button>
                    <Button Tag="TangentMode" ToolTip.Tip="{x:Static lang:Strings.GraphHandleMode}" AutomationProperties.Name="{x:Static lang:Strings.GraphHandleMode}">
                        <Path Data="M1,12 L15,4 M1,10 L1,14 M15,2 L15,6 M8,6 L10,8 8,10 6,8 Z" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem usage:UsageTracking.Feature="GraphEditor.Symmetry"
                                          Click="GraphActionClick"
                                          Header="{x:Static lang:Strings.Symmetry}"
                                          IsChecked="{Binding Symmetry.Value, Mode=OneWay}"
                                          Tag="Symmetry"
                                          ToggleType="Radio" />
                                <MenuItem usage:UsageTracking.Feature="GraphEditor.Asymmetry"
                                          Click="GraphActionClick"
                                          Header="{x:Static lang:Strings.Asymmetry}"
                                          IsChecked="{Binding Asymmetry.Value, Mode=OneWay}"
                                          Tag="Asymmetry"
                                          ToggleType="Radio" />
                                <MenuItem usage:UsageTracking.Feature="GraphEditor.Separately"
                                          Click="GraphActionClick"
                                          Header="{x:Static lang:Strings.Separately}"
                                          IsChecked="{Binding Separately.Value, Mode=OneWay}"
                                          Tag="Separately"
                                          ToggleType="Radio" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </WrapPanel>
        </controls:ToolTabBar>
    </Grid>
</UserControl>
