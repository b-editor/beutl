<UserControl x:Class="Beutl.Editor.Components.VersionControlTab.Views.VersionControlTabView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Beutl.Language"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Beutl.Editor.Components.VersionControlTab.ViewModels"
             d:DesignHeight="640"
             d:DesignWidth="420"
             x:CompileBindings="True"
             x:DataType="vm:VersionControlTabViewModel"
             mc:Ignorable="d">
    <UserControl.Styles>
        <Style Selector="TextBlock.sectionHeader">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Border.kindBadge">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="TextBlock.diffLine">
            <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style Selector="TextBlock.diffLine.added">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        </Style>
        <Style Selector="TextBlock.diffLine.removed">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>
        <Style Selector="TextBlock.diffLine.header">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <TextBlock Margin="20"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsVisible="{Binding HasBlockingGuidance.Value}"
                   Text="{Binding StatusMessage.Value}"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />

        <Grid IsVisible="{Binding !HasBlockingGuidance.Value}"
              RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0"
                Padding="10,8"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <TextBlock FontWeight="SemiBold"
                           Text="{Binding BranchText.Value}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Classes="secondary"
                           Text="{Binding AheadBehindText.Value}" />
                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Margin="0,4,0,0"
                           Classes="secondary"
                           Text="{Binding DirtySummary.Value}" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="8"
                Padding="10"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                CornerRadius="4"
                IsVisible="{Binding HasRecoverableLock.Value}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock VerticalAlignment="Center"
                           Text="{x:Static lang:Strings.VersionControl_StaleLockGuidance}"
                           TextWrapping="Wrap" />
                <Button Grid.Column="1"
                        Command="{Binding RemoveStaleLockCommand}"
                        Content="{x:Static lang:Strings.VersionControl_RemoveStaleLock}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <TextBlock Margin="20"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsVisible="{Binding !IsTracked.Value}"
                       Text="{Binding StatusMessage.Value}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />

            <Grid ColumnDefinitions="2*,5,3*"
                  IsVisible="{Binding IsTracked.Value}">
                <Grid Grid.Column="0"
                      Margin="8"
                      RowDefinitions="Auto,*,Auto"
                      RowSpacing="6">
                    <TextBlock Classes="sectionHeader"
                               Text="{x:Static lang:Strings.VersionControl_History}" />
                    <ListBox x:Name="CommitList"
                             Grid.Row="1"
                             ItemsSource="{Binding Commits}"
                             SelectionChanged="OnCommitSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:VersionControlCommitViewModel">
                                <Border Padding="8,6">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Command="{Binding RestoreCommand}"
                                                      Header="{x:Static lang:Strings.VersionControl_Restore}" />
                                            <MenuItem Command="{Binding RestoreToNewBranchCommand}"
                                                      Header="{x:Static lang:Strings.VersionControl_RestoreToNewBranch}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid ColumnDefinitions="*,Auto"
                                          RowDefinitions="Auto,Auto,Auto"
                                          ColumnSpacing="6">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding DisplayMessage}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="1" Classes="kindBadge">
                                            <TextBlock FontSize="10" Text="{Binding KindText}" />
                                        </Border>
                                        <TextBlock Grid.Row="1"
                                                   Grid.ColumnSpan="2"
                                                   Margin="0,3,0,0"
                                                   Classes="secondary"
                                                   Text="{Binding AuthorAndDate}" />
                                        <TextBlock Grid.Row="2"
                                                   Grid.ColumnSpan="2"
                                                   Classes="secondary"
                                                   Text="{Binding Commit.ShortSha}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="2"
                            HorizontalAlignment="Stretch"
                            Command="{Binding LoadMoreCommand}"
                            Content="{x:Static lang:Strings.VersionControl_LoadMore}"
                            IsEnabled="{Binding !IsLoading.Value}"
                            IsVisible="{Binding HasMoreHistory.Value}" />
                </Grid>

                <GridSplitter Grid.Column="1"
                              Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                              ResizeDirection="Columns" />

                <Grid Grid.Column="2"
                      Margin="8"
                      RowDefinitions="Auto,2*,Auto,3*"
                      RowSpacing="6">
                    <TextBlock Classes="sectionHeader"
                               Text="{x:Static lang:Strings.VersionControl_ChangedFiles}" />
                    <ListBox x:Name="ChangedFileList"
                             Grid.Row="1"
                             ItemsSource="{Binding ChangedFiles}"
                             SelectionChanged="OnChangedFileSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:VersionControlFileChangeViewModel">
                                <Grid Margin="6,4"
                                      ColumnDefinitions="24,*"
                                      ColumnSpacing="4">
                                    <TextBlock FontFamily="Consolas, Menlo, monospace"
                                               FontWeight="SemiBold"
                                               Text="{Binding StatusText}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding PathText}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding PathText}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2"
                               Classes="sectionHeader"
                               Text="{x:Static lang:Strings.VersionControl_Diff}" />
                    <ScrollViewer Grid.Row="3"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DiffLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:VersionControlDiffLineViewModel">
                                    <TextBlock Classes="diffLine"
                                               Classes.added="{Binding IsAdded}"
                                               Classes.header="{Binding IsHeader}"
                                               Classes.removed="{Binding IsRemoved}"
                                               Text="{Binding Text}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</UserControl>
