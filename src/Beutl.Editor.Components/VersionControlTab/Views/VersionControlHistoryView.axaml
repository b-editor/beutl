<UserControl x:Class="Beutl.Editor.Components.VersionControlTab.Views.VersionControlHistoryView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Beutl.Language"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Beutl.Editor.Components.VersionControlTab.ViewModels"
             d:DesignHeight="480"
             d:DesignWidth="320"
             x:CompileBindings="True"
             x:DataType="vm:VersionControlTabViewModel"
             mc:Ignorable="d">
    <UserControl.Styles>
        <Style Selector="ListBox#CommitList ListBoxItem">
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
        <TextBlock Margin="8,8,8,0"
                   Classes="sectionHeader"
                   Text="{x:Static lang:Strings.VersionControl_History}" />
        <Grid Grid.Row="1">
            <ListBox x:Name="CommitList"
                     ItemsSource="{Binding Commits}"
                     Padding="8"
                     SelectedItem="{Binding SelectedCommit.Value, Mode=TwoWay}"
                     SelectionChanged="OnCommitSelectionChanged"
                     Tapped="OnCommitListTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:VersionControlCommitViewModel">
                        <Border Padding="12,10">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="{Binding RestoreCommand}"
                                              Header="{x:Static lang:Strings.VersionControl_Restore}" />
                                    <MenuItem Command="{Binding RestoreToNewBranchCommand}"
                                              Header="{x:Static lang:Strings.VersionControl_RestoreToNewBranch}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto"
                                  RowSpacing="6"
                                  ColumnSpacing="8">
                                <TextBlock x:Name="HistoryMessageText"
                                           Grid.ColumnSpan="2"
                                           FontSize="14"
                                           FontWeight="Normal"
                                           MaxLines="1"
                                           Text="{Binding DisplayMessage}"
                                           TextTrimming="CharacterEllipsis">
                                    <ToolTip.Tip>
                                        <StackPanel MaxWidth="400" Spacing="4">
                                            <TextBlock MaxLines="0" Text="{Binding DisplayMessage}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Commit.ShortSha}" FontFamily="Consolas, Menlo, monospace" />
                                        </StackPanel>
                                    </ToolTip.Tip>
                                </TextBlock>
                                <TextBlock Grid.Row="1"
                                           Classes="secondary"
                                           FontSize="12"
                                           Text="{Binding AuthorAndRelativeDate}"
                                           ToolTip.Tip="{Binding AbsoluteLocalDate}" />
                                <Border Grid.Row="1"
                                        Grid.Column="1"
                                        Classes="kindBadge"
                                        Classes.restore="{Binding IsRestore}"
                                        Classes.safety="{Binding IsSafety}">
                                    <TextBlock FontSize="12" Text="{Binding KindText}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="HistoryEmptyHint"
                       Margin="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Classes="secondary"
                       IsVisible="{Binding IsHistoryEmpty.Value}"
                       Text="{x:Static lang:Strings.VersionControl_HistoryEmptyHint}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </Grid>
        <Button Grid.Row="2"
                Margin="8,0,8,8"
                HorizontalAlignment="Stretch"
                Command="{Binding LoadMoreCommand}"
                Content="{x:Static lang:Strings.VersionControl_LoadMore}"
                IsEnabled="{Binding !IsLoading.Value}"
                IsVisible="{Binding HasMoreHistory.Value}" />
    </Grid>
</UserControl>
