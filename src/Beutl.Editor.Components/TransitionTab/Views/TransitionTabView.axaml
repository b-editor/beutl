<UserControl x:Class="Beutl.Editor.Components.TransitionTab.Views.TransitionTabView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:editorConverters="using:Beutl.Controls.Converters"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:lang="using:Beutl.Language"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pe="using:Beutl.Controls.PropertyEditors"
             xmlns:viewModels="using:Beutl.Editor.Components.TransitionTab.ViewModels"
             d:DesignHeight="450"
             d:DesignWidth="320"
             x:CompileBindings="True"
             x:DataType="viewModels:TransitionTabViewModel"
             pe:PropertyEditorGrid.IsAlignmentScope="True"
             mc:Ignorable="d">
    <!--  Empty until a transition is opened, as the property tabs are until something is selected.  -->
    <ScrollViewer IsVisible="{Binding HasTarget.Value}">
        <StackPanel Margin="0,4">
            <pe:DropDownPickerEditor x:Name="typeEditor"
                                     DropDownClick="OnTypeDropDownClick"
                                     Header="{Binding EdgeName.Value}"
                                     IsReadOnly="{Binding !CanEdit.Value}"
                                     Text="{Binding TypeName.Value, TargetNullValue={x:Static lang:Strings.Null}}">
                <pe:DropDownPickerEditor.MenuContent>
                    <Button Width="24"
                            Height="24"
                            Margin="0,0,4,0"
                            Padding="0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Click="OnDeleteClick"
                            IsEnabled="{Binding CanDelete.Value}"
                            Theme="{StaticResource TransparentButton}"
                            ToolTip.Tip="{x:Static lang:Strings.Delete}">
                        <icons:FluentIcon FontSize="16" Icon="Delete" />
                    </Button>
                </pe:DropDownPickerEditor.MenuContent>
            </pe:DropDownPickerEditor>

            <ItemsControl DataContext="{Binding Properties.Value}" ItemsSource="{Binding Properties}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:Object">
                        <ContentControl Content="{Binding Converter={x:Static editorConverters:PropertyEditorContextToViewConverter.Instance}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
