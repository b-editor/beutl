<UserControl x:Class="Beutl.Editor.Components.ChannelMapProperties.Views.ChannelMapEditor"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Beutl.Controls"
             xmlns:lang="using:Beutl.Language"
             xmlns:pe="using:Beutl.Controls.PropertyEditors"
             xmlns:editors="using:Beutl.Editor.Components.PropertyEditors.Views"
             xmlns:vm="using:Beutl.Editor.Components.ChannelMapProperties.ViewModels"
             x:CompileBindings="True"
             x:DataType="vm:ChannelMapEditorViewModel">
    <Grid RowDefinitions="Auto,Auto">
        <ToggleButton x:Name="expandToggle"
                      Margin="8,4"
                      IsChecked="{Binding IsExpanded.Value}"
                      Theme="{DynamicResource PropertyEditorMiniExpanderToggleButton}"
                      ToolTip.Tip="{Binding HoverInfo.Value}">
            <ToggleButton.Tag>
                <editors:PropertyEditorMenu />
            </ToggleButton.Tag>
            <TextBlock Text="{Binding Header}" />
        </ToggleButton>
        <Panel x:Name="content" Grid.Row="1">
            <controls:TreeLineDecorator LineBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                <StackPanel>
                    <pe:EnumEditor x:Name="FormatEditor"
                                   Header="{x:Static lang:AudioStrings.ChannelMap_Format}"
                                   Items="{Binding Formats}"
                                   SelectedIndex="{Binding SelectedFormatIndex.Value, Mode=TwoWay}"
                                   IsReadOnly="{Binding !CanEditMap.Value}">
                        <pe:EnumEditor.MenuContent>
                            <Border Width="24" Margin="0,0,4,0" />
                        </pe:EnumEditor.MenuContent>
                    </pe:EnumEditor>
                    <ItemsControl ItemsSource="{Binding Channels}" IsEnabled="{Binding CanEditMap.Value}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChannelAssignmentViewModel">
                                <pe:EnumEditor Header="{Binding Name}" Items="{Binding SourceChannels}"
                                               SelectedIndex="{Binding SelectedIndex.Value, Mode=TwoWay}">
                                    <pe:EnumEditor.MenuContent>
                                        <Border Width="24" Margin="0,0,4,0" />
                                    </pe:EnumEditor.MenuContent>
                                </pe:EnumEditor>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </controls:TreeLineDecorator>
        </Panel>
    </Grid>
</UserControl>
