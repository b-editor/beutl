<UserControl x:Class="Beutl.Editor.Components.ChannelMapProperties.Views.ChannelMapEditor"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Beutl.Controls"
             xmlns:pe="using:Beutl.Controls.PropertyEditors"
             xmlns:editors="using:Beutl.Editor.Components.PropertyEditors.Views"
             xmlns:vm="using:Beutl.Editor.Components.ChannelMapProperties.ViewModels"
             x:CompileBindings="True"
             x:DataType="vm:ChannelMapEditorViewModel">
    <UserControl.Styles>
        <!-- Keep the inputs in the parent's columns; only the channel names are indented. -->
        <Style Selector="pe|EnumEditor.channel /template/ TextBlock#PART_HeaderTextBlock">
            <Setter Property="Margin" Value="20,0,0,0" />
        </Style>
    </UserControl.Styles>
    <StackPanel>
        <pe:EnumEditor x:Name="FormatEditor"
                       Header="{Binding Header}"
                       Description="{Binding Description.Value}"
                       HoverInfo="{Binding HoverInfo.Value}"
                       Items="{Binding Formats}"
                       SelectedIndex="{Binding SelectedFormatIndex.Value, Mode=TwoWay}"
                       IsReadOnly="{Binding !CanEditMap.Value}">
            <pe:EnumEditor.MenuContent>
                <editors:PropertyEditorMenu />
            </pe:EnumEditor.MenuContent>
        </pe:EnumEditor>
        <TextBlock Text="{Binding Message.Value}" TextWrapping="Wrap" Margin="8,0,32,4"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   IsVisible="{Binding Message.Value, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <controls:TreeLineDecorator LineBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <ItemsControl ItemsSource="{Binding Channels}" IsEnabled="{Binding CanEditMap.Value}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChannelAssignmentViewModel">
                        <!-- Offset the tree's 16 px indent and reserve the parent's 28 px menu column. -->
                        <pe:EnumEditor Classes="channel" Margin="-12,0,4,0"
                                       Header="{Binding Name}" Items="{Binding SourceChannels}"
                                       SelectedIndex="{Binding SelectedIndex.Value, Mode=TwoWay}">
                            <pe:EnumEditor.MenuContent>
                                <Border Width="24" Margin="0,0,4,0" />
                            </pe:EnumEditor.MenuContent>
                        </pe:EnumEditor>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </controls:TreeLineDecorator>
    </StackPanel>
</UserControl>
