<UserControl x:Class="Beutl.Editor.Components.ChannelMapProperties.Views.ChannelMapEditor"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="using:Beutl.Language"
             xmlns:vm="using:Beutl.Editor.Components.ChannelMapProperties.ViewModels"
             x:CompileBindings="True"
             x:DataType="vm:ChannelMapEditorViewModel">
    <StackPanel Margin="4,8" Spacing="8" IsEnabled="{Binding CanEdit.Value}" Grid.IsSharedSizeScope="True">
        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="ChannelLabel" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static lang:AudioStrings.ChannelMap_Format}" VerticalAlignment="Center" />
            <ComboBox x:Name="FormatBox" Grid.Column="1" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Formats}" SelectedIndex="{Binding SelectedFormatIndex.Value, Mode=TwoWay}" />
        </Grid>
        <TextBlock Text="{Binding Message.Value}" TextWrapping="Wrap"
                   IsVisible="{Binding Message.Value, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <ItemsControl ItemsSource="{Binding Channels}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChannelAssignmentViewModel">
                    <Grid Margin="0,0,0,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ChannelLabel" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding SourceChannels}" SelectedIndex="{Binding SelectedIndex.Value, Mode=TwoWay}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
