<UserControl x:Class="Beutl.Editor.Components.WebBrowserTab.Views.WebBrowserTabView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Beutl.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:lang="using:Beutl.Language"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:viewModel="using:Beutl.Editor.Components.WebBrowserTab.ViewModels"
             xmlns:views="using:Beutl.Editor.Components.WebBrowserTab.Views"
             xmlns:browser="using:Beutl.Editor.Components.WebBrowserTab"
             d:DesignHeight="500"
             d:DesignWidth="700"
             x:ClassModifier="internal"
             x:CompileBindings="True"
             x:DataType="viewModel:WebBrowserTabViewModel"
             mc:Ignorable="d">
    <UserControl.Styles>
        <Style Selector="Border.bookmarkCard">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style Selector="Border.bookmarkCard:pointerover, Border.bookmarkCard:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        </Style>
        <Style Selector="Button.removeBookmark">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style Selector="Border.bookmarkCard:pointerover Button.removeBookmark, Border.bookmarkCard:focus-within Button.removeBookmark">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Button.browserIcon">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Theme" Value="{StaticResource TransparentButton}" />
        </Style>
        <Style Selector="TextBlock.browserSecondary">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Styles>
    <UserControl.Resources>
        <DataTemplate x:Key="DownloadHistoryItemTemplate" x:DataType="views:BrowserDownloadHistoryItem">
            <Border Margin="0,0,0,12"
                    Padding="14"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border Width="40"
                                Height="40"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="10">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       Text="{Binding FileExtension}" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="5">
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="{Binding FileName}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding FileName}" />
                            <TextBlock Classes="browserSecondary"
                                       Text="{Binding SourceHost}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Record.Url}" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Static lang:Strings.BrowserRemoveHistoryItem}"
                                Classes="browserIcon removeHistory"
                                Click="OnRemoveHistoryClick"
                                Tag="{Binding Record}"
                                ToolTip.Tip="{x:Static lang:Strings.BrowserRemoveHistoryItem}">
                            <icons:FluentIcon FontSize="14"
                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                              Icon="Dismiss" />
                        </Button>
                    </Grid>
                    <StackPanel Spacing="4">
                        <TextBlock Classes="browserSecondary"
                                   FontSize="11"
                                   Text="{Binding Record.FilePath}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Record.FilePath}" />
                        <TextBlock Classes="browserSecondary"
                                   FontSize="11"
                                   Text="{Binding DownloadedAt}" />
                    </StackPanel>
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               IsVisible="{Binding !FileExists}"
                               Text="{x:Static lang:Strings.BrowserFileMissing}"
                               TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="4">
                        <Button Padding="14,6"
                                Click="OnOpenHistoryFileClick"
                                Content="{x:Static lang:Strings.Open}"
                                CornerRadius="8"
                                FontSize="13"
                                IsEnabled="{Binding FileExists}"
                                Tag="{Binding Record}" />
                        <Button Grid.Column="2"
                                AutomationProperties.Name="{x:Static lang:Strings.OpenFolder}"
                                Classes="browserIcon"
                                Click="OnOpenHistoryFolderClick"
                                Tag="{Binding Record}"
                                ToolTip.Tip="{x:Static lang:Strings.OpenFolder}">
                            <icons:FluentIcon FontSize="16" Icon="Folder" />
                        </Button>
                        <Button Grid.Column="3"
                                AutomationProperties.Name="{x:Static lang:Strings.BrowserAddToTimeline}"
                                Classes="browserIcon"
                                Click="OnImportHistoryClick"
                                IsEnabled="{Binding CanImport}"
                                Tag="{Binding Record}"
                                ToolTip.Tip="{x:Static lang:Strings.BrowserAddToTimeline}">
                            <icons:FluentIcon FontSize="16" Icon="Add" />
                        </Button>
                        <Button Grid.Column="4"
                                AutomationProperties.Name="{x:Static lang:Strings.BrowserRetry}"
                                Classes="browserIcon"
                                Click="OnRetryHistoryClick"
                                Tag="{Binding Record}"
                                ToolTip.Tip="{x:Static lang:Strings.BrowserRetry}">
                            <icons:FluentIcon FontSize="16" Icon="ArrowClockwise" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="DownloadHistoryEmptyTemplate" x:DataType="viewModel:WebBrowserTabViewModel">
            <Border MaxWidth="360" Padding="16,24">
                <StackPanel Spacing="20">
                    <Border Width="64"
                            Height="64"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="20">
                        <icons:FluentIcon HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          FontSize="28"
                                          Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                          Icon="ArrowDownload" />
                    </Border>
                    <StackPanel Spacing="10">
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="{x:Static lang:Strings.BrowserHistoryEmpty}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock Classes="browserSecondary"
                                   LineHeight="20"
                                   Text="{x:Static lang:Strings.BrowserHistoryEmptyHint}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="4">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="2">
                <Button Grid.Column="0"
                        Click="OnBackClick"
                        IsEnabled="{Binding CanGoBack.Value}"
                        Padding="6"
                        Theme="{StaticResource TransparentButton}"
                        ToolTip.Tip="{x:Static lang:Strings.Back}">
                    <icons:FluentIcon FontSize="16" Icon="ArrowLeft" />
                </Button>
                <Button Grid.Column="1"
                        Click="OnForwardClick"
                        IsEnabled="{Binding CanGoForward.Value}"
                        Padding="6"
                        Theme="{StaticResource TransparentButton}"
                        ToolTip.Tip="{x:Static lang:Strings.Forward}">
                    <icons:FluentIcon FontSize="16" Icon="ArrowRight" />
                </Button>
                <Panel Grid.Column="2">
                    <Button Click="OnRefreshClick"
                            IsVisible="{Binding !IsLoading.Value}"
                            Padding="6"
                            Theme="{StaticResource TransparentButton}"
                            ToolTip.Tip="{x:Static lang:Strings.Refresh}">
                        <icons:FluentIcon FontSize="16" Icon="ArrowClockwise" />
                    </Button>
                    <Button Click="OnStopClick"
                            IsVisible="{Binding IsLoading.Value}"
                            Padding="6"
                            Theme="{StaticResource TransparentButton}"
                            ToolTip.Tip="{x:Static lang:Strings.Stop}">
                        <icons:FluentIcon FontSize="16" Icon="Dismiss" />
                    </Button>
                </Panel>
                <views:WebBrowserAddressBox x:Name="AddressTextBox"
                         Grid.Column="3"
                         controls:TextBoxAttachment.EnterDownBehavior="None"
                         KeyDown="OnAddressKeyDown"
                         Address="{Binding Address.Value, Mode=TwoWay}"
                         Suggestions="{Binding AddressSuggestions}"
                         VerticalContentAlignment="Center"
                         PlaceholderText="{x:Static lang:Strings.WebAddress}" />
                <Button x:Name="BrowserMenuButton"
                        Grid.Column="4"
                        Padding="6"
                        Theme="{StaticResource TransparentButton}"
                        ToolTip.Tip="{x:Static lang:Strings.Menu}">
                    <Button.Flyout>
                        <ui:FAMenuFlyout>
                            <ui:FAMenuFlyoutItem Click="OnNewTabClick" Text="{x:Static lang:Strings.NewTab}" />
                            <ui:FAMenuFlyoutSeparator />
                            <ui:FAMenuFlyoutItem Click="OnDownloadHistoryClick" Text="{x:Static lang:Strings.BrowserDownloads}" />
                            <ui:FAMenuFlyoutItem Click="OnFindPageClick" Text="{x:Static lang:Strings.BrowserFind}" />
                            <ui:FAMenuFlyoutSeparator />
                            <ui:FAMenuFlyoutItem Click="OnZoomInClick" Text="{x:Static lang:Strings.BrowserZoomIn}" />
                            <ui:FAMenuFlyoutItem Click="OnZoomOutClick" Text="{x:Static lang:Strings.BrowserZoomOut}" />
                            <ui:FAMenuFlyoutItem x:Name="ZoomResetMenuItem" Click="OnZoomResetClick" Text="{x:Static lang:Strings.BrowserZoomReset}" />
                            <ui:FAMenuFlyoutSeparator />
                            <ui:FAMenuFlyoutItem Click="OnBrowserSettingsClick" Text="{x:Static lang:Strings.BrowserSettings}" />
                            <ui:FAMenuFlyoutItem Click="OnDownloadMediaClick"
                                              IsEnabled="{Binding HasWebAddress.Value}"
                                              Text="{x:Static lang:Strings.WebDownloadMedia}" />
                            <ui:FAMenuFlyoutItem Click="OnOpenInDefaultBrowserClick"
                                                   IsEnabled="{Binding HasWebAddress.Value}"
                                                   Text="{x:Static lang:Strings.OpenInDefaultBrowser}" />
                            <ui:FAMenuFlyoutItem Click="OnPrintClick"
                                                   IsEnabled="{Binding HasWebAddress.Value}"
                                                   Text="{x:Static lang:Strings.Print}" />
                        </ui:FAMenuFlyout>
                    </Button.Flyout>
                    <icons:FluentIcon FontSize="16" Icon="MoreHorizontal" />
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                IsVisible="{Binding ErrorMessage.Value, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Padding="8,4">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding ErrorMessage.Value}" TextWrapping="Wrap" />
                <Button x:Name="LinuxRuntimeHelpButton"
                        Click="OnOpenLinuxRuntimeHelpClick"
                        Content="{x:Static lang:Strings.OpenLinuxWebViewSetupGuide}"
                        HorizontalAlignment="Left"
                        IsVisible="{Binding IsLinuxRuntimeHelpVisible.Value}"
                        Padding="8,4"
                        Theme="{StaticResource TransparentButton}" />
            </StackPanel>
        </Border>

        <Popup x:Name="SearchSuggestionsPopup"
               Width="{Binding #AddressTextBox.Bounds.Width}"
               Closed="OnSearchSuggestionsPopupClosed"
               IsLightDismissEnabled="True"
               OverlayDismissEventPassThrough="True"
               OverlayInputPassThroughElement="{Binding #AddressTextBox}"
               Placement="Bottom"
               PlacementTarget="{Binding #AddressTextBox}"
               ShouldUseOverlayLayer="False"
               TakesFocusFromNativeControl="False"
               VerticalOffset="4"
               WindowManagerAddShadowHint="True">
            <Border Padding="4"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock x:Name="SearchEngineLabel"
                               Margin="10,6,10,4"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Google" />
                    <ListBox x:Name="SearchSuggestionsList"
                             MaxHeight="280"
                             Padding="0"
                             Background="Transparent"
                             BorderThickness="0"
                             Focusable="False"
                             PointerReleased="OnSearchSuggestionPointerReleased"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <icons:FluentIcon VerticalAlignment="Center"
                                                      FontSize="14"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                      Icon="Search" />
                                    <TextBlock Grid.Column="1"
                                               FontSize="13"
                                               Text="{Binding}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Popup>

        <Grid x:Name="DownloadStatusPanel"
              Grid.Row="2"
              Margin="8,6"
              IsVisible="False">
            <Border Padding="12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="10"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="8">
                    <icons:FluentIcon VerticalAlignment="Center"
                                      FontSize="18"
                                      Icon="ArrowDownload" />
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="4">
                        <TextBlock x:Name="DownloadStatusText"
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="DownloadProgressText"
                                   Classes="browserSecondary"
                                   IsVisible="False" />
                    </StackPanel>
                    <Panel Grid.Column="2" VerticalAlignment="Center">
                        <Button x:Name="DownloadCancelButton"
                                AutomationProperties.Name="{x:Static lang:Strings.Cancel}"
                                Classes="browserIcon"
                                Click="OnCancelDownloadClick"
                                IsVisible="False"
                                ToolTip.Tip="{x:Static lang:Strings.Cancel}">
                            <icons:FluentIcon FontSize="16" Icon="Dismiss" />
                        </Button>
                        <Button x:Name="DismissDownloadStatusButton"
                                AutomationProperties.Name="{x:Static lang:Strings.Close}"
                                Classes="browserIcon"
                                Click="OnDismissDownloadStatusClick"
                                ToolTip.Tip="{x:Static lang:Strings.Close}">
                            <icons:FluentIcon FontSize="16" Icon="Dismiss" />
                        </Button>
                    </Panel>
                    <ProgressBar x:Name="DownloadProgressBar"
                                 Grid.Row="1"
                                 Grid.ColumnSpan="3"
                                 Height="3"
                                 IsVisible="False"
                                 Maximum="100"
                                 Minimum="0" />
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="FindPanel"
              Grid.Row="3"
              Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
              IsVisible="False"
              RowDefinitions="Auto,Auto">
            <Grid Margin="8"
                  ColumnDefinitions="*,Auto,Auto,Auto"
                  ColumnSpacing="4">
                <TextBox x:Name="FindTextBox"
                         MinWidth="60"
                         VerticalContentAlignment="Center"
                         controls:TextBoxAttachment.EnterDownBehavior="None"
                         CornerRadius="8"
                         KeyDown="OnFindKeyDown"
                         PlaceholderText="{x:Static lang:Strings.BrowserFind}"
                         TextChanged="OnFindTextChanged">
                    <TextBox.InnerLeftContent>
                        <icons:FluentIcon Margin="8,0,4,0"
                                          VerticalAlignment="Center"
                                          FontSize="16"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Icon="Search" />
                    </TextBox.InnerLeftContent>
                    <TextBox.InnerRightContent>
                        <Border Margin="4,0,6,0"
                                Padding="5,2"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="5"
                                IsVisible="{Binding #FindCountText.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock x:Name="FindCountText"
                                       MaxWidth="64"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding #FindCountText.Text}" />
                        </Border>
                    </TextBox.InnerRightContent>
                </TextBox>
                <Button x:Name="FindPreviousButton"
                        Grid.Column="1"
                        AutomationProperties.Name="{x:Static lang:Strings.BrowserFindPrevious}"
                        Classes="browserIcon"
                        Click="OnFindPreviousClick"
                        IsEnabled="False"
                        ToolTip.Tip="{x:Static lang:Strings.BrowserFindPrevious}">
                    <icons:FluentIcon FontSize="16" Icon="ChevronUp" />
                </Button>
                <Button x:Name="FindNextButton"
                        Grid.Column="2"
                        AutomationProperties.Name="{x:Static lang:Strings.BrowserFindNext}"
                        Classes="browserIcon"
                        Click="OnFindNextClick"
                        IsEnabled="False"
                        ToolTip.Tip="{x:Static lang:Strings.BrowserFindNext}">
                    <icons:FluentIcon FontSize="16" Icon="ChevronDown" />
                </Button>
                <Button x:Name="CloseFindButton"
                        Grid.Column="3"
                        AutomationProperties.Name="{x:Static lang:Strings.Close}"
                        Classes="browserIcon"
                        Click="OnCloseFindClick"
                        ToolTip.Tip="{x:Static lang:Strings.Close}">
                    <icons:FluentIcon FontSize="16" Icon="Dismiss" />
                </Button>
            </Grid>
            <TextBlock x:Name="FindStatusText"
                       Grid.Row="1"
                       Margin="12,0,12,8"
                       FontSize="12"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       IsVisible="False"
                       TextWrapping="Wrap" />
        </Grid>

        <Grid Grid.Row="4">
            <Grid x:Name="BrowserSurface">
                <ContentControl x:Name="WebViewHost"
                                IsVisible="{Binding HasWebAddress.Value}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
                <ScrollViewer x:Name="BlankPagePanel"
                              HorizontalContentAlignment="Stretch"
                              Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                              HorizontalScrollBarVisibility="Disabled"
                              IsVisible="{Binding !HasWebAddress.Value}">
                    <StackPanel x:Name="BlankPageContent"
                                MaxWidth="520"
                                Margin="24"
                                VerticalAlignment="Center"
                                Spacing="16">
                        <Border x:Name="BrowserEmptyState" Padding="8,24">
                            <StackPanel MaxWidth="320"
                                        HorizontalAlignment="Center"
                                        Spacing="24">
                                <Border Width="64"
                                        Height="64"
                                        HorizontalAlignment="Center"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="20">
                                    <icons:FluentIcon HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      FontSize="30"
                                                      Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                      Icon="Globe" />
                                </Border>
                                <StackPanel Spacing="10">
                                    <TextBlock FontSize="20"
                                               FontWeight="SemiBold"
                                               Text="{x:Static lang:Strings.WebBrowser}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <TextBlock FontSize="13"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               LineHeight="22"
                                               Text="{x:Static lang:Strings.BrowserStartDescription}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                    <Button x:Name="StartBrowsingButton"
                                            Padding="14,9"
                                            AutomationProperties.Name="{x:Static lang:Strings.BrowserStartSearch}"
                                            Click="OnStartSearchClick"
                                            CornerRadius="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <icons:FluentIcon VerticalAlignment="Center"
                                                              FontSize="16"
                                                              Icon="Search" />
                                            <TextBlock Text="{x:Static lang:Strings.BrowserStartSearch}" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="AddBookmarkButton"
                                            Width="36"
                                            Height="36"
                                            Padding="9"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Static lang:Strings.BrowserAddBookmark}"
                                            Click="OnShowBookmarkEditorClick"
                                            CornerRadius="8"
                                            Theme="{StaticResource TransparentButton}"
                                            ToolTip.Tip="{x:Static lang:Strings.BrowserAddBookmark}">
                                        <icons:FluentIcon FontSize="18" Icon="Add" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="BookmarkListPanel"
                                    IsVisible="False"
                                    Spacing="8">
                            <ItemsControl x:Name="BookmarkItems"
                                          AutomationProperties.Name="{x:Static lang:Strings.BrowserBookmarks}"
                                          ItemsSource="{Binding Bookmarks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="browser:BrowserBookmark">
                                        <Border Margin="0,0,0,8"
                                                BorderThickness="1"
                                                Classes="bookmarkCard"
                                                CornerRadius="12">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Button Padding="12"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        AutomationProperties.Name="{Binding Title}"
                                                        Classes="openBookmark"
                                                        Click="OnOpenBookmarkClick"
                                                        CornerRadius="11"
                                                        Tag="{Binding}"
                                                        Theme="{StaticResource TransparentButton}"
                                                        ToolTip.Tip="{Binding Url}">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                        <Border Width="40"
                                                                Height="40"
                                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                                CornerRadius="12">
                                                            <Panel>
                                                                <TextBlock HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="18"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                           IsVisible="{Binding #BookmarkIcon.Source, Converter={x:Static ObjectConverters.IsNull}}"
                                                                           Text="{Binding Initial}" />
                                                                <views:BrowserBookmarkIcon x:Name="BookmarkIcon"
                                                                                           Width="24"
                                                                                           Height="24"
                                                                                           HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center"
                                                                                           Loader="{Binding $parent[views:WebBrowserTabView].FaviconLoader}"
                                                                                           PageUrl="{Binding Url}" />
                                                            </Panel>
                                                        </Border>
                                                        <StackPanel Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Spacing="4">
                                                            <TextBlock FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding Title}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock FontSize="12"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       Text="{Binding Host}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                                <Button Grid.Column="1"
                                                        Width="32"
                                                        Height="32"
                                                        Margin="0,0,8,0"
                                                        Padding="8"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="{x:Static lang:Strings.Delete}"
                                                        Classes="removeBookmark"
                                                        Click="OnRemoveBookmarkClick"
                                                        CornerRadius="8"
                                                        Tag="{Binding}"
                                                        Theme="{StaticResource TransparentButton}"
                                                        ToolTip.Tip="{x:Static lang:Strings.Delete}">
                                                    <icons:FluentIcon FontSize="14" Icon="Dismiss" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="AddAnotherBookmarkButton"
                                    Width="36"
                                    Height="36"
                                    Padding="9"
                                    HorizontalAlignment="Center"
                                    AutomationProperties.Name="{x:Static lang:Strings.BrowserAddBookmark}"
                                    Click="OnShowBookmarkEditorClick"
                                    CornerRadius="10"
                                    Theme="{StaticResource TransparentButton}"
                                    ToolTip.Tip="{x:Static lang:Strings.BrowserAddBookmark}">
                                <icons:FluentIcon FontSize="18" Icon="Add" />
                            </Button>
                        </StackPanel>
                        <Border x:Name="BookmarkEditor"
                                Padding="20"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                IsVisible="False">
                            <StackPanel Spacing="16">
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="{x:Static lang:Strings.BrowserAddBookmark}" />
                                <StackPanel Spacing="6">
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="URL" />
                                    <TextBox x:Name="BookmarkUrlInput"
                                             AutomationProperties.Name="URL"
                                             PlaceholderText="https://example.com" />
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{x:Static lang:Strings.Name}" />
                                    <TextBox x:Name="BookmarkNameInput"
                                             AutomationProperties.Name="{x:Static lang:Strings.Name}"
                                             PlaceholderText="{x:Static lang:Strings.Name}" />
                                </StackPanel>
                                <TextBlock x:Name="BookmarkEditorError"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                           IsVisible="False"
                                           TextWrapping="Wrap" />
                                <StackPanel HorizontalAlignment="Right"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                    <Button x:Name="CancelBookmarkButton"
                                            Click="OnCancelBookmarkEditorClick"
                                            Content="{x:Static lang:Strings.Cancel}" />
                                    <Button x:Name="SaveBookmarkButton"
                                            Classes="accent"
                                            Click="OnSaveBookmarkClick"
                                            Content="{x:Static lang:Strings.Add}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid x:Name="ToolPanel"
                  Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                  IsVisible="False"
                  RowDefinitions="Auto,*">
                <Border Padding="16,12"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock x:Name="ToolPanelTitle"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <Button x:Name="CloseBrowserPanelButton"
                                Grid.Column="1"
                                AutomationProperties.Name="{x:Static lang:Strings.Close}"
                                Classes="browserIcon"
                                Click="OnCloseBrowserPanelClick"
                                ToolTip.Tip="{x:Static lang:Strings.Close}">
                            <icons:FluentIcon FontSize="16" Icon="Dismiss" />
                        </Button>
                    </Grid>
                </Border>
                <ContentControl x:Name="ToolPanelContent"
                                Grid.Row="1"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
