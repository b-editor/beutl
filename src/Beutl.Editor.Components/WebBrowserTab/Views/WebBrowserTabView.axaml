<UserControl x:Class="Beutl.Editor.Components.WebBrowserTab.Views.WebBrowserTabView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Beutl.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:lang="using:Beutl.Language"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:viewModel="using:Beutl.Editor.Components.WebBrowserTab.ViewModels"
             xmlns:views="using:Beutl.Editor.Components.WebBrowserTab.Views"
             xmlns:browser="using:Beutl.Editor.Components.WebBrowserTab"
             d:DesignHeight="500"
             d:DesignWidth="700"
             x:ClassModifier="internal"
             x:CompileBindings="True"
             x:DataType="viewModel:WebBrowserTabViewModel"
             mc:Ignorable="d">
    <UserControl.Resources>
        <DataTemplate x:Key="DownloadHistoryItemTemplate" x:DataType="views:BrowserDownloadHistoryItem">
            <Border Padding="16" Margin="0,0,0,12" CornerRadius="12"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <icons:FluentIcon Icon="Document" FontSize="24" VerticalAlignment="Top" Margin="0,4,0,0" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileName}" />
                            <TextBlock Text="{Binding Record.FilePath}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Record.FilePath}" />
                            <WrapPanel>
                                <TextBlock Text="{Binding SourceHost}" FontSize="12" Opacity="0.65" Margin="0,0,12,0" ToolTip.Tip="{Binding Record.Url}" />
                                <TextBlock Text="{Binding DownloadedAt}" FontSize="12" Opacity="0.65" />
                            </WrapPanel>
                        </StackPanel>
                        <Button Grid.Column="2" Content="×" Tag="{Binding Record}" Click="OnRemoveHistoryClick" VerticalAlignment="Top"
                                Padding="6" Theme="{StaticResource TransparentButton}" ToolTip.Tip="{x:Static lang:Strings.BrowserRemoveHistoryItem}" />
                    </Grid>
                    <TextBlock Text="{x:Static lang:Strings.BrowserFileMissing}" IsVisible="{Binding !FileExists}" TextWrapping="Wrap" Opacity="0.7" />
                    <WrapPanel>
                        <Button Content="{x:Static lang:Strings.Open}" Tag="{Binding Record}" Click="OnOpenHistoryFileClick"
                                IsEnabled="{Binding FileExists}" FontSize="13" Padding="8,6" Margin="0,2,6,0" CornerRadius="8" />
                        <Button Content="{x:Static lang:Strings.OpenFolder}" Tag="{Binding Record}" Click="OnOpenHistoryFolderClick"
                                FontSize="13" Padding="8,6" Margin="0,2,6,0" CornerRadius="8" />
                        <Button Content="{x:Static lang:Strings.BrowserAddToTimeline}" Tag="{Binding Record}" Click="OnImportHistoryClick"
                                IsEnabled="{Binding CanImport}" FontSize="13" Padding="8,6" Margin="0,2,6,0" CornerRadius="8" />
                        <Button Content="{x:Static lang:Strings.BrowserRetry}" Tag="{Binding Record}" Click="OnRetryHistoryClick"
                                FontSize="13" Padding="8,6" Margin="0,2,6,0" CornerRadius="8" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
        <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="4">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="2">
                <Button Grid.Column="0"
                        Click="OnBackClick"
                        IsEnabled="{Binding CanGoBack.Value}"
                        Padding="6"
                        Theme="{StaticResource TransparentButton}"
                        ToolTip.Tip="{x:Static lang:Strings.Back}">
                    <icons:FluentIcon FontSize="16" Icon="ArrowLeft" />
                </Button>
                <Button Grid.Column="1"
                        Click="OnForwardClick"
                        IsEnabled="{Binding CanGoForward.Value}"
                        Padding="6"
                        Theme="{StaticResource TransparentButton}"
                        ToolTip.Tip="{x:Static lang:Strings.Forward}">
                    <icons:FluentIcon FontSize="16" Icon="ArrowRight" />
                </Button>
                <Panel Grid.Column="2">
                    <Button Click="OnRefreshClick"
                            IsVisible="{Binding !IsLoading.Value}"
                            Padding="6"
                            Theme="{StaticResource TransparentButton}"
                            ToolTip.Tip="{x:Static lang:Strings.Refresh}">
                        <icons:FluentIcon FontSize="16" Icon="ArrowClockwise" />
                    </Button>
                    <Button Click="OnStopClick"
                            IsVisible="{Binding IsLoading.Value}"
                            Padding="6"
                            Theme="{StaticResource TransparentButton}"
                            ToolTip.Tip="{x:Static lang:Strings.Stop}">
                        <icons:FluentIcon FontSize="16" Icon="Dismiss" />
                    </Button>
                </Panel>
                <views:WebBrowserAddressBox x:Name="AddressTextBox"
                         Grid.Column="3"
                         controls:TextBoxAttachment.EnterDownBehavior="None"
                         KeyDown="OnAddressKeyDown"
                         Address="{Binding Address.Value, Mode=TwoWay}"
                         Suggestions="{Binding AddressSuggestions}"
                         VerticalContentAlignment="Center"
                         PlaceholderText="{x:Static lang:Strings.WebAddress}" />
                <Button x:Name="BrowserMenuButton"
                        Grid.Column="4"
                        Padding="6"
                        Theme="{StaticResource TransparentButton}"
                        ToolTip.Tip="{x:Static lang:Strings.Menu}">
                    <Button.Flyout>
                        <ui:FAMenuFlyout>
                            <ui:FAMenuFlyoutItem Click="OnNewTabClick" Text="{x:Static lang:Strings.NewTab}" />
                            <ui:FAMenuFlyoutSeparator />
                            <ui:FAMenuFlyoutItem Click="OnDownloadHistoryClick" Text="{x:Static lang:Strings.BrowserDownloads}" />
                            <ui:FAMenuFlyoutItem Click="OnFindPageClick" Text="{x:Static lang:Strings.BrowserFind}" />
                            <ui:FAMenuFlyoutSeparator />
                            <ui:FAMenuFlyoutItem Click="OnZoomInClick" Text="{x:Static lang:Strings.BrowserZoomIn}" />
                            <ui:FAMenuFlyoutItem Click="OnZoomOutClick" Text="{x:Static lang:Strings.BrowserZoomOut}" />
                            <ui:FAMenuFlyoutItem x:Name="ZoomResetMenuItem" Click="OnZoomResetClick" Text="{x:Static lang:Strings.BrowserZoomReset}" />
                            <ui:FAMenuFlyoutSeparator />
                            <ui:FAMenuFlyoutItem Click="OnBrowserSettingsClick" Text="{x:Static lang:Strings.BrowserSettings}" />
                            <ui:FAMenuFlyoutItem Click="OnDownloadMediaClick"
                                              IsEnabled="{Binding HasWebAddress.Value}"
                                              Text="{x:Static lang:Strings.WebDownloadMedia}" />
                            <ui:FAMenuFlyoutItem Click="OnOpenInDefaultBrowserClick"
                                                   IsEnabled="{Binding HasWebAddress.Value}"
                                                   Text="{x:Static lang:Strings.OpenInDefaultBrowser}" />
                            <ui:FAMenuFlyoutItem Click="OnPrintClick"
                                                   IsEnabled="{Binding HasWebAddress.Value}"
                                                   Text="{x:Static lang:Strings.Print}" />
                        </ui:FAMenuFlyout>
                    </Button.Flyout>
                    <icons:FluentIcon FontSize="16" Icon="MoreHorizontal" />
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                IsVisible="{Binding ErrorMessage.Value, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Padding="8,4">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding ErrorMessage.Value}" TextWrapping="Wrap" />
                <Button x:Name="LinuxRuntimeHelpButton"
                        Click="OnOpenLinuxRuntimeHelpClick"
                        Content="{x:Static lang:Strings.OpenLinuxWebViewSetupGuide}"
                        HorizontalAlignment="Left"
                        IsVisible="{Binding IsLinuxRuntimeHelpVisible.Value}"
                        Padding="8,4"
                        Theme="{StaticResource TransparentButton}" />
            </StackPanel>
        </Border>

        <StackPanel x:Name="SearchSuggestionsPanel" Grid.Row="2" IsVisible="False">
            <TextBlock x:Name="SearchEngineLabel" Text="Google" Margin="8,4" />
            <ListBox x:Name="SearchSuggestionsList"
                     MaxHeight="220"
                     Focusable="False"
                     PointerReleased="OnSearchSuggestionPointerReleased">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </ListBox.Styles>
            </ListBox>
        </StackPanel>

        <Grid x:Name="DownloadStatusPanel" Grid.Row="3" ColumnDefinitions="*,Auto" IsVisible="False" Margin="8,4">
            <TextBlock x:Name="DownloadStatusText" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button x:Name="DownloadCancelButton" Grid.Column="1" Content="{x:Static lang:Strings.Cancel}" Click="OnCancelDownloadClick" />
        </Grid>

        <Grid x:Name="FindPanel" Grid.Row="4" Margin="4" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="4" IsVisible="False">
                <TextBox x:Name="FindTextBox" MinWidth="60" PlaceholderText="{x:Static lang:Strings.BrowserFind}"
                         controls:TextBoxAttachment.EnterDownBehavior="None"
                         TextChanged="OnFindTextChanged" KeyDown="OnFindKeyDown" />
                <Button Grid.Column="1" Content="↑" Click="OnFindPreviousClick" ToolTip.Tip="{x:Static lang:Strings.BrowserFindPrevious}" />
                <Button Grid.Column="2" Content="↓" Click="OnFindNextClick" ToolTip.Tip="{x:Static lang:Strings.BrowserFindNext}" />
                <TextBlock x:Name="FindCountText" Grid.Column="3" MaxWidth="80" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Button Grid.Column="4" Content="×" Click="OnCloseFindClick" ToolTip.Tip="{x:Static lang:Strings.Close}" />

        </Grid>

        <Grid Grid.Row="5">
            <Grid x:Name="BrowserSurface">
                <ContentControl x:Name="WebViewHost"
                                IsVisible="{Binding HasWebAddress.Value}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
                <ScrollViewer x:Name="BlankPagePanel" IsVisible="{Binding !HasWebAddress.Value}">
                    <StackPanel Margin="24,36,24,24" MaxWidth="620" HorizontalAlignment="Stretch" Spacing="24">
                        <StackPanel Spacing="8">
                            <Border Width="48" Height="48" CornerRadius="14" HorizontalAlignment="Left"
                                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                <icons:FluentIcon Icon="Globe" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{x:Static lang:Strings.NewTab}" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Static lang:Strings.BrowserStartDescription}" Opacity="0.65" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Click="OnStartSearchClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Padding="16,12" CornerRadius="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <icons:FluentIcon Icon="Search" FontSize="18" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Static lang:Strings.BrowserStartSearch}" Opacity="0.75" TextWrapping="Wrap" />
                            </Grid>
                        </Button>
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="{x:Static lang:Strings.BrowserBookmarks}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button x:Name="AddBookmarkButton" Grid.Column="1" Click="OnShowBookmarkEditorClick"
                                        Content="{x:Static lang:Strings.Add}" Padding="12,6" CornerRadius="8" />
                            </Grid>
                            <Border x:Name="BookmarkEditor" IsVisible="False" Padding="16" CornerRadius="12"
                                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                <StackPanel Spacing="10">
                                    <TextBox x:Name="BookmarkUrlInput" PlaceholderText="{x:Static lang:Strings.WebAddress}" />
                                    <TextBox x:Name="BookmarkNameInput" PlaceholderText="{x:Static lang:Strings.Name}" />
                                    <TextBlock x:Name="BookmarkEditorError" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="SaveBookmarkButton" Content="{x:Static lang:Strings.Add}" Click="OnSaveBookmarkClick" />
                                        <Button Content="{x:Static lang:Strings.Cancel}" Click="OnCancelBookmarkEditorClick" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border x:Name="BookmarkEmptyState" Padding="20,24" CornerRadius="12"
                                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Static lang:Strings.BrowserBookmarksEmpty}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Static lang:Strings.BrowserBookmarksHint}" Opacity="0.65" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <ItemsControl x:Name="BookmarkItems" ItemsSource="{Binding Bookmarks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="browser:BrowserBookmark">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8" ColumnSpacing="4">
                                            <Button Tag="{Binding}" Click="OnOpenBookmarkClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                    Padding="14,12" CornerRadius="10">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                    <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                                                        <icons:FluentIcon Icon="Globe" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="3">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Url}" TextTrimming="CharacterEllipsis" Opacity="0.6" FontSize="12" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                            <Button Grid.Column="1" Content="×" Tag="{Binding}" Click="OnRemoveBookmarkClick"
                                                    Padding="8" VerticalAlignment="Center" Theme="{StaticResource TransparentButton}"
                                                    ToolTip.Tip="{x:Static lang:Strings.Delete}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid x:Name="ToolPanel" IsVisible="False" RowDefinitions="Auto,*" Margin="12">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock x:Name="ToolPanelTitle" FontSize="20" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="×" Click="OnCloseBrowserPanelClick" ToolTip.Tip="{x:Static lang:Strings.Close}" />
                </Grid>
                <ScrollViewer Grid.Row="1">
                    <ContentControl x:Name="ToolPanelContent" HorizontalContentAlignment="Stretch" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
