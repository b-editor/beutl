<UserControl x:Class="Beutl.Editor.Components.CompressorProperties.Views.CompressorPropertiesEditor"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Beutl.Language"
             xmlns:local="using:Beutl.Editor.Components.CompressorProperties.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Beutl.Editor.Components.CompressorProperties.ViewModels"
             d:DesignHeight="450"
             d:DesignWidth="400"
             x:CompileBindings="True"
             x:DataType="vm:CompressorPropertiesViewModel"
             mc:Ignorable="d">
    <StackPanel>
        <local:CompressorCurveEditor Height="180"
                                     Margin="8,4"
                                     Editor="{Binding}"
                                     Knee="{Binding Knee.Value}"
                                     MakeupGain="{Binding MakeupGain.Value}"
                                     Ratio="{Binding Ratio.Value}"
                                     Threshold="{Binding Threshold.Value}"
                                     ToolTip.Tip="{x:Static lang:AudioStrings.CompressorEffect_Curve_ToolTip}" />

        <ItemsControl ItemsSource="{Binding Properties}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding Converter={StaticResource ViewModelToViewConverter}}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
