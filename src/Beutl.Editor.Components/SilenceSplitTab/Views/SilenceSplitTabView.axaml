<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Beutl.Controls"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:lang="using:Beutl.Language"
             xmlns:timeline="using:Beutl.Editor.Components.TimelineTab.Views"
             xmlns:vm="using:Beutl.Editor.Components.SilenceSplitTab.ViewModels"
             x:Class="Beutl.Editor.Components.SilenceSplitTab.Views.SilenceSplitTabView"
             x:DataType="vm:SilenceSplitTabViewModel"
             x:CompileBindings="True">
    <UserControl.Styles>
        <Style Selector="TextBlock.secondary">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto">
        <controls:ToolTabBar x:Name="ToolBar">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding TargetName.Value}"
                           Theme="{StaticResource ToolTabBarTitleTextBlockTheme}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding TargetName.Value}" />
                <Button x:Name="RefreshButton" Grid.Column="1"
                        Click="OnRefreshClick" IsEnabled="{Binding !IsApplying.Value}"
                        Theme="{StaticResource ToolTabBarIconButtonTheme}"
                        AutomationProperties.Name="{x:Static lang:Strings.Refresh}"
                        ToolTip.Tip="{x:Static lang:Strings.Refresh}">
                    <icons:FluentIcon FontSize="16" Icon="ArrowClockwise" />
                </Button>
            </Grid>
        </controls:ToolTabBar>

        <TextBlock Grid.Row="1" Margin="16" Classes="secondary"
                   IsVisible="{Binding !HasAnalysis.Value}"
                   Text="{x:Static lang:Strings.SilenceSplit_SelectAudio}" />
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding HasAnalysis.Value}" IsEnabled="{Binding !IsApplying.Value}">
            <StackPanel Margin="8" Spacing="12">
                <TextBlock Classes="secondary" Text="{x:Static lang:Strings.SilenceSplit_Description}" />
                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        CornerRadius="{DynamicResource ControlCornerRadius}" Padding="8">
                    <timeline:WaveformControl x:Name="Waveform" Height="112"
                                              WaveformBrush="{DynamicResource TextFillColorPrimaryBrush}" />
                </Border>
                <TextBlock Classes="secondary" Text="{x:Static lang:Strings.SilenceSplit_PreviewHint}" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding Analysis.Value.IsBusy.Value}" />

                <Border Classes="options-group" Padding="12">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Static lang:Strings.Settings}" Theme="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnDefinitions="*,120" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                            <TextBlock Text="{x:Static lang:Strings.SilenceSplit_Threshold}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <NumericUpDown x:Name="Threshold" Grid.Column="1" Minimum="-120" Maximum="0" Increment="1" VerticalAlignment="Center"
                                           Value="{Binding Analysis.Value.ThresholdDb.Value}" AutomationProperties.Name="{x:Static lang:Strings.SilenceSplit_Threshold}" />
                            <TextBlock Grid.Row="1" Text="{x:Static lang:Strings.SilenceSplit_Minimum}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <NumericUpDown x:Name="Minimum" Grid.Row="1" Grid.Column="1" Minimum="20" Maximum="3600000" Increment="20" VerticalAlignment="Center"
                                           Value="{Binding Analysis.Value.MinimumMilliseconds.Value}" AutomationProperties.Name="{x:Static lang:Strings.SilenceSplit_Minimum}" />
                            <TextBlock Grid.Row="2" Text="{x:Static lang:Strings.SilenceSplit_Padding}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <NumericUpDown x:Name="PaddingEditor" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="3600000" Increment="20" VerticalAlignment="Center"
                                           Value="{Binding Analysis.Value.PaddingMilliseconds.Value}" AutomationProperties.Name="{x:Static lang:Strings.SilenceSplit_Padding}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Static lang:Strings.SilenceSplit_Mode}" Theme="{StaticResource BodyStrongTextBlockStyle}" />
                    <ComboBox x:Name="Mode" HorizontalAlignment="Stretch" SelectedIndex="{Binding Analysis.Value.ModeIndex.Value}">
                        <ComboBoxItem><TextBlock Text="{x:Static lang:Strings.SilenceSplit_SplitOnly}" TextWrapping="Wrap" /></ComboBoxItem>
                        <ComboBoxItem><TextBlock Text="{x:Static lang:Strings.SilenceSplit_Delete}" TextWrapping="Wrap" /></ComboBoxItem>
                        <ComboBoxItem><TextBlock Text="{x:Static lang:Strings.SilenceSplit_Ripple}" TextWrapping="Wrap" /></ComboBoxItem>
                    </ComboBox>
                    <CheckBox x:Name="Linked" IsVisible="{Binding Analysis.Value.HasLinkedElements}" IsChecked="{Binding Analysis.Value.IncludeLinked.Value}">
                        <TextBlock Text="{x:Static lang:Strings.SilenceSplit_Linked}" TextWrapping="Wrap" />
                    </CheckBox>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="12" IsVisible="{Binding HasAnalysis.Value}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="8" IsEnabled="{Binding !IsApplying.Value}">
                <TextBlock Text="{Binding Analysis.Value.Status.Value}" Classes="secondary" />
                <Button x:Name="ApplyButton" Content="{x:Static lang:Strings.Apply}" Classes="accent"
                        HorizontalAlignment="Stretch" Click="OnApplyClick" IsEnabled="{Binding Analysis.Value.CanApply.Value}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
