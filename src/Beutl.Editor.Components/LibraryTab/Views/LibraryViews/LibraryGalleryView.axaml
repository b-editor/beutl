<UserControl x:Class="Beutl.Editor.Components.LibraryTab.Views.LibraryViews.LibraryGalleryView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Beutl.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModel="using:Beutl.Editor.Components.LibraryTab.ViewModels"
             d:DesignHeight="450"
             d:DesignWidth="320"
             x:CompileBindings="True"
             mc:Ignorable="d">
    <UserControl.Styles>
        <Style Selector="Border.galleryTile">
            <Setter Property="Background" Value="Transparent" />

            <Style Selector="^ Border.galleryFrame">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
                <Setter Property="ClipToBounds" Value="True" />
            </Style>

            <Style Selector="^:pointerover Border.galleryFrame">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            </Style>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="Sections" Margin="0,0,0,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="16" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="viewModel:LibraryGallerySection">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="effectCategoryHeading"
                                   FontWeight="SemiBold"
                                   IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="effectCategoryDescription"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Text="{Binding Description}"
                                   TextWrapping="Wrap" />
                        <ItemsRepeater ItemsSource="{Binding Items}">
                            <ItemsRepeater.Layout>
                                <controls:HorizontalGridLayout ColumnSpacing="8"
                                                               MinItemWidth="144"
                                                               RowSpacing="12" />
                            </ItemsRepeater.Layout>
                            <!--  Each repeater owns its template and its recycling pool.  -->
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="viewModel:LibraryGalleryItemViewModel">
                                    <Border x:Name="Tile"
                                            Classes="galleryTile"
                                            ToolTip.Placement="Top"
                                            ToolTip.Tip="{Binding Description}"
                                            ToolTip.VerticalOffset="0">
                                        <StackPanel Spacing="4">
                                            <Border Classes="galleryFrame">
                                                <!--  One pixel tighter than ControlCornerRadius, so the thumbnail sits flush inside the 1px stroke.  -->
                                                <Border ClipToBounds="True" CornerRadius="7">
                                                    <controls:AnimatedThumbnail IsPlaying="{Binding #Tile.IsPointerOver}" Source="{Binding Thumbnail}" />
                                                </Border>
                                            </Border>
                                            <TextBlock HorizontalAlignment="Center"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
