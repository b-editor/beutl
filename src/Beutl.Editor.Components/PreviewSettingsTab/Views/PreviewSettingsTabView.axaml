<UserControl x:Class="Beutl.Editor.Components.PreviewSettingsTab.Views.PreviewSettingsTabView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:Beutl.Editor.Components.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Beutl.Language"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:Beutl.Models"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:viewModel="using:Beutl.Editor.Components.PreviewSettingsTab.ViewModels"
             d:DesignHeight="600"
             d:DesignWidth="400"
             x:CompileBindings="True"
             x:DataType="viewModel:PreviewSettingsTabViewModel"
             mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="0,0,4,0"
                    Grid.IsSharedSizeScope="True"
                    Orientation="Vertical">

            <!--  Disabled during playback, which would rebuild the renderer; hidden without IPreviewRenderQuality.  -->
            <Grid Margin="8,8,8,0"
                  ColumnDefinitions="*,Auto"
                  IsVisible="{CompiledBinding IsRenderQualityAvailable}">
                <TextBlock VerticalAlignment="Center"
                           Text="{x:Static lang:Strings.PreviewRenderQuality}"
                           Theme="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox Grid.Column="1"
                          MinWidth="120"
                          IsEnabled="{CompiledBinding !IsPlaying.Value}"
                          ItemsSource="{CompiledBinding PreviewScaleOptions}"
                          SelectedItem="{CompiledBinding PreviewScale.Value}"
                          ToolTip.Tip="{x:Static lang:Strings.PreviewRenderQuality_Tip}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:RenderScale">
                            <TextBlock Text="{CompiledBinding Converter={x:Static converters:RenderScaleNameConverter.Instance}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <Grid Margin="8,16,8,0" ColumnDefinitions="*,Auto">
                <TextBlock VerticalAlignment="Center"
                           Text="{x:Static lang:Strings.PreviewSource}"
                           Theme="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox Grid.Column="1"
                          MinWidth="120"
                          SelectedIndex="{CompiledBinding PreviewSourceMode.Value}">
                    <ComboBoxItem Content="{x:Static lang:Strings.PreviewSourcePreferProxy}" />
                    <ComboBoxItem Content="{x:Static lang:Strings.PreviewSourceForceOriginal}" />
                </ComboBox>
            </Grid>

            <Grid Margin="8,16,8,0" ColumnDefinitions="*,Auto">
                <TextBlock VerticalAlignment="Center"
                           Text="{x:Static lang:Strings.OnionSkin}"
                           Theme="{StaticResource BodyStrongTextBlockStyle}" />
                <ToggleSwitch Grid.Column="1"
                              Classes="left"
                              IsChecked="{CompiledBinding IsOnionSkinEnabled.Value}"
                              Theme="{StaticResource CompactToggleSwitchStyle}" />
            </Grid>

            <ItemsControl IsEnabled="{CompiledBinding IsOnionSkinEnabled.Value}" ItemsSource="{CompiledBinding OnionSkinProperties}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding Converter={StaticResource ViewModelToViewConverter}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  The editor settings page edits the same settings.  -->
            <Grid Margin="8,16,8,0" ColumnDefinitions="*,Auto">
                <TextBlock VerticalAlignment="Center"
                           Text="{x:Static lang:Strings.PreviewGuides}"
                           Theme="{StaticResource BodyStrongTextBlockStyle}" />
                <ToggleSwitch x:Name="GuidesToggle"
                              Grid.Column="1"
                              Classes="left"
                              IsChecked="{CompiledBinding Guides.IsEnabled.Value}"
                              Theme="{StaticResource CompactToggleSwitchStyle}" />
            </Grid>

            <StackPanel x:Name="GuideSettings"
                        Margin="8,4,8,0"
                        IsEnabled="{CompiledBinding Guides.IsEnabled.Value}"
                        Spacing="4">
                <ItemsControl ItemsSource="{CompiledBinding Guides.Kinds}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModel:PreviewGuideKindItem">
                            <CheckBox MinWidth="140"
                                      Content="{CompiledBinding DisplayName}"
                                      IsChecked="{CompiledBinding IsChecked.Value}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock VerticalAlignment="Center" Text="{x:Static lang:Strings.PreviewGuide_Color}" />
                    <ui:ColorPickerButton Grid.Column="1"
                                          IsAlphaEnabled="False"
                                          IsCompact="True"
                                          IsMoreButtonVisible="True"
                                          ShowAcceptDismissButtons="True"
                                          UseColorPalette="False"
                                          UseColorTriangle="False"
                                          UseColorWheel="False"
                                          UseSpectrum="True"
                                          Color="{CompiledBinding Guides.Color.Value, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock VerticalAlignment="Center" Text="{x:Static lang:Strings.PreviewGuide_Opacity}" />
                    <Slider Grid.Column="1"
                            Width="120"
                            IsSnapToTickEnabled="True"
                            Maximum="1"
                            Minimum="0"
                            TickFrequency="0.05"
                            Value="{CompiledBinding Guides.Opacity.Value}" />
                    <TextBlock Grid.Column="2"
                               MinWidth="36"
                               VerticalAlignment="Center"
                               Text="{CompiledBinding Guides.Opacity.Value, StringFormat={}{0:P0}}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto"
                      IsEnabled="{CompiledBinding Guides.IsGridEnabled.Value}"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="4">
                    <TextBlock VerticalAlignment="Center" Text="{x:Static lang:Strings.PreviewGuide_GridColumns}" />
                    <NumericUpDown Grid.Column="1"
                                   MinWidth="120"
                                   FormatString="F0"
                                   Maximum="{x:Static viewModel:PreviewGuideSettingsViewModel.GridMaxCells}"
                                   Minimum="1"
                                   Value="{Binding Guides.GridColumns.Value}" />
                    <TextBlock Grid.Row="1"
                               VerticalAlignment="Center"
                               Text="{x:Static lang:Strings.PreviewGuide_GridRows}" />
                    <NumericUpDown Grid.Row="1"
                                   Grid.Column="1"
                                   MinWidth="120"
                                   FormatString="F0"
                                   Maximum="{x:Static viewModel:PreviewGuideSettingsViewModel.GridMaxCells}"
                                   Minimum="1"
                                   Value="{Binding Guides.GridRows.Value}" />
                </Grid>

                <StackPanel IsEnabled="{CompiledBinding Guides.IsAspectRatioEnabled.Value}" Spacing="4">
                    <TextBlock Text="{x:Static lang:Strings.PreviewGuide_AspectRatios}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                        <TextBox x:Name="AspectRatiosBox"
                                 Text="{CompiledBinding Guides.AspectRatios.Value}"
                                 ToolTip.Tip="{x:Static lang:Strings.PreviewGuide_AspectRatios_Tip}" />
                        <ComboBox Grid.Column="1"
                                  MinWidth="120"
                                  ItemsSource="{CompiledBinding Guides.Presets}"
                                  PlaceholderText="{x:Static lang:Strings.PreviewGuide_Preset}"
                                  SelectedItem="{CompiledBinding Guides.SelectedPreset.Value}" />
                    </Grid>
                </StackPanel>
            </StackPanel>

            <Grid Margin="8,16,8,0" ColumnDefinitions="*,Auto">
                <TextBlock VerticalAlignment="Center"
                           Text="{x:Static lang:Strings.FrameCache}"
                           Theme="{StaticResource BodyStrongTextBlockStyle}" />
                <ToggleSwitch Grid.Column="1"
                              Classes="left"
                              IsChecked="{CompiledBinding IsFrameCacheEnabled.Value}"
                              Theme="{StaticResource CompactToggleSwitchStyle}" />
            </Grid>

            <ItemsControl IsEnabled="{CompiledBinding IsFrameCacheEnabled.Value}" ItemsSource="{CompiledBinding FrameCacheProperties}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding Converter={StaticResource ViewModelToViewConverter}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  Disabled during playback, like the render quality: the renderer only takes new node cache options
                  once playback releases the render thread.  -->
            <Grid Margin="8,16,8,0" ColumnDefinitions="*,Auto">
                <TextBlock VerticalAlignment="Center"
                           Text="{x:Static lang:SettingsStrings.NodeCache}"
                           Theme="{StaticResource BodyStrongTextBlockStyle}" />
                <ToggleSwitch x:Name="NodeCacheToggle"
                              Grid.Column="1"
                              Classes="left"
                              IsChecked="{CompiledBinding IsNodeCacheEnabled.Value}"
                              IsEnabled="{CompiledBinding !IsPlaying.Value}"
                              Theme="{StaticResource CompactToggleSwitchStyle}" />
            </Grid>

            <ui:FAInfoBar Margin="8,8,8,0"
                        IsClosable="False"
                        IsOpen="{CompiledBinding IsNodeCacheEnabled.Value}"
                        Message="{x:Static lang:SettingsStrings.NodeCacheWarning}"
                        Severity="Warning" />

            <ItemsControl x:Name="NodeCacheLimits" ItemsSource="{CompiledBinding NodeCacheProperties}">
                <ItemsControl.IsEnabled>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsNodeCacheEnabled.Value" />
                        <Binding Converter="{x:Static BoolConverters.Not}" Path="IsPlaying.Value" />
                    </MultiBinding>
                </ItemsControl.IsEnabled>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding Converter={StaticResource ViewModelToViewConverter}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
