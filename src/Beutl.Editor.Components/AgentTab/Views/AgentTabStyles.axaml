            <StreamGeometry x:Key="AgentAcpGeometry">F1 M7.5,2 C8,2 8.4,2.4 8.4,2.9 L8.4,7 L15.6,7 L15.6,2.9 C15.6,2.4 16,2 16.5,2 C17,2 17.4,2.4 17.4,2.9 L17.4,7 L19,7 A1,1 0 0 1 19,9 L18,9 L18,12 A6,6 0 0 1 13,17.9 L13,21 A1,1 0 0 1 11,21 L11,17.9 A6,6 0 0 1 6,12 L6,9 L5,9 A1,1 0 0 1 5,7 L6.6,7 L6.6,2.9 C6.6,2.4 7,2 7.5,2 Z M8,9 L8,12 A4,4 0 0 0 16,12 L16,9 Z</StreamGeometry>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="PathIcon.agent-provider-glyph">
        <Setter Property="Data" Value="{StaticResource AgentAcpGeometry}" />
    </Style>
    <Style Selector="PathIcon.agent-provider-glyph:codex">
        <Setter Property="Data" Value="{StaticResource AgentCodexGeometry}" />
    </Style>
    <Style Selector="Button#ModelButton PathIcon.agent-provider-glyph:not(:claude)">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="PathIcon.agent-provider-glyph:claude">
        <Setter Property="Data" Value="{StaticResource AgentClaudeGeometry}" />
        <Setter Property="Foreground" Value="{DynamicResource AgentClaudeBrandBrush}" />
    </Style>

    <Style Selector="Border.agent-wide-gutter">
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="views|AgentTabView.wide Border.agent-wide-gutter">
        <Setter Property="Padding" Value="18,0" />
    </Style>
    <Style Selector="Border.agent-card">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="11,10" />
    </Style>
    <Style Selector="Border.agent-composer:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
    </Style>
    <Style Selector="Border.agent-composer:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    </Style>
    <Style Selector="Border.agent-composer Border.agent-drop-indicator">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.agent-composer.dragover Border.agent-drop-indicator">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="FlyoutPresenter.agent-thread-picker">
        <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="FlyoutPresenter.agent-model-picker">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MaxWidth" Value="520" />
    </Style>
    <Style Selector="FlyoutPresenter.agent-background-work">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="FlyoutPresenter.agent-background-work /template/ ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="Panel.agent-task-actions">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="FlyoutPresenter.agent-background-work Panel.agent-task-actions">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Grid.agent-attachment-card">
        <Setter Property="Height" Value="96" />
        <Setter Property="Width" Value="104" />
    </Style>
    <Style Selector="Grid.agent-attachment-card.pasted-text">
        <Setter Property="Height" Value="73" />
        <Setter Property="Width" Value="152" />
    </Style>
    <Style Selector="Button.agent-scene-chip icons|FluentIcon.agent-scene-icon-hover">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.agent-scene-chip:pointerover icons|FluentIcon.agent-scene-icon-idle">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.agent-scene-chip:pointerover icons|FluentIcon.agent-scene-icon-hover">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Grid.agent-attachment-card Border.agent-attachment-remove">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Grid.agent-attachment-card:pointerover Border.agent-attachment-remove, Grid.agent-attachment-card:focus-within Border.agent-attachment-remove">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="Ellipse.agent-provider-dot">
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="6" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>
    <Style Selector="Ellipse.agent-provider-dot.available">
        <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
    </Style>
    <Style Selector="TextBlock.agent-secondary, SelectableTextBlock.agent-secondary">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.agent-caption">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.agent-message-time">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,5,0" />
    </Style>
    <Style Selector="Button.agent-message-action">
        <Setter Property="Theme" Value="{StaticResource ToolTabBarIconButtonTheme}" />
        <Setter Property="Width" Value="23" />
        <Setter Property="Height" Value="23" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>
    <Style Selector=".agent-message:pointerover Button.agent-message-action, Button.agent-message-action:focus">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="views|AgentShimmerTextBlock">
        <Setter Property="MutedBrush" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="HighlightBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.agent-disclosure">
        <Setter Property="Theme" Value="{StaticResource AgentDisclosureToggleTheme}" />
    </Style>
    <Style Selector="ToggleButton.agent-disclosure:pointerover TextBlock.agent-disclosure-label">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.agent-disclosure:pointerover icons|FluentIcon.agent-disclosure-glyph">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.agent-disclosure views|AgentShimmerTextBlock">
        <Setter Property="MutedBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.agent-disclosure:pointerover views|AgentShimmerTextBlock">
        <Setter Property="MutedBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="views|AgentContextRing">
        <Setter Property="TrackBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="IndicatorBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="views|AgentContextRing.warning">
        <Setter Property="IndicatorBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
    </Style>
    <Style Selector="views|AgentContextRing.critical">
        <Setter Property="IndicatorBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>
    <Style Selector="Grid.agent-thread-row.archived">
        <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="TextBlock.agent-turn-time">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.agent-turn-divider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    </Style>
    <Style Selector="TextBlock.agent-request-label">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.7" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="icons|FluentIcon.agent-status">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>
    <Style Selector="icons|FluentIcon.agent-status.success">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
    </Style>
    <Style Selector="icons|FluentIcon.agent-status.active">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="icons|FluentIcon.agent-chevron">
        <Setter Property="Icon" Value="ChevronRight" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="RenderTransform" Value="rotate(0deg)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ToggleButton:checked icons|FluentIcon.agent-chevron">
        <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>
</Styles>
