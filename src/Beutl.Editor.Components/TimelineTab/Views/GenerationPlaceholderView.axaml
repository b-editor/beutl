<UserControl x:Class="Beutl.Editor.Components.TimelineTab.Views.GenerationPlaceholderView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:lang="using:Beutl.Language"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Beutl.Editor.Components.TimelineTab.ViewModels"
             Height="{DynamicResource LayerHeight}"
             Margin="{Binding Margin.Value}"
             Padding="0,1"
             HorizontalAlignment="Left"
             VerticalAlignment="Top"
             d:DesignHeight="40"
             d:DesignWidth="200"
             x:CompileBindings="True"
             x:DataType="vm:GenerationPlaceholderViewModel"
             IsVisible="{Binding IsVisible.Value}"
             ToolTip.Tip="{Binding Text.Value}"
             ZIndex="4"
             mc:Ignorable="d">
    <Border x:Name="border"
            Width="{Binding Width.Value}"
            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
            BorderThickness="1"
            Classes.failed="{Binding IsFailed.Value}"
            CornerRadius="4"
            Cursor="Hand"
            PointerPressed="Border_PointerPressed">
        <Border.Styles>
            <Style Selector="Border#border.failed">
                <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </Style>
        </Border.Styles>
        <Border.Background>
            <!-- Stripes say "not a clip yet" without hiding what lies beneath. -->
            <VisualBrush DestinationRect="0,0,12,12"
                         Opacity="0.35"
                         SourceRect="0,0,12,12"
                         TileMode="Tile">
                <VisualBrush.Visual>
                    <Canvas Width="12" Height="12">
                        <Line EndPoint="12,0"
                              StartPoint="0,12"
                              Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                              StrokeThickness="2" />
                    </Canvas>
                </VisualBrush.Visual>
            </VisualBrush>
        </Border.Background>
        <Border.ContextFlyout>
            <ui:FAMenuFlyout>
                <ui:FAMenuFlyoutItem Click="Open_Click" Text="{x:Static lang:Strings.Open}" />
                <ui:FAMenuFlyoutItem Click="Cancel_Click"
                                     IsVisible="{Binding IsRunning.Value}"
                                     Text="{x:Static lang:Strings.Cancel}" />
                <ui:FAMenuFlyoutItem Click="Discard_Click"
                                     IsVisible="{Binding !IsRunning.Value}"
                                     Text="{x:Static lang:Strings.AiTimelineDiscard}" />
            </ui:FAMenuFlyout>
        </Border.ContextFlyout>
        <StackPanel Margin="6,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
            <ProgressRing Width="14"
                             Height="14"
                             MinWidth="0"
                             MinHeight="0"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsRunning.Value}" />
            <icons:FluentIcon FontSize="14"
                              Icon="Sparkle"
                              IsVisible="{Binding !IsRunning.Value}" />
            <TextBlock VerticalAlignment="Center"
                       FontSize="12"
                       Text="{Binding Text.Value}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Border>
</UserControl>
