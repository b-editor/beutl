<UserControl x:Class="Beutl.Editor.Components.TimelineTab.Views.TimelineTabView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Beutl.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ecv="using:Beutl.Editor.Components.Views"
             xmlns:h="using:Beutl.Editor.Components.Helpers"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:lang="using:Beutl.Language"
             xmlns:local="using:Beutl.Editor.Components.TimelineTab.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:p="using:Beutl.Services.PrimitiveImpls"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:usage="using:Beutl.Editor.Components.Helpers"
             xmlns:vm="using:Beutl.Editor.Components.TimelineTab.ViewModels"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:DataType="vm:TimelineTabViewModel"
             mc:Ignorable="d">
    <Grid x:Name="grid" RowDefinitions="Auto,*">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="275" MinWidth="200" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <GridSplitter x:Name="gridSplitter"
                      Grid.RowSpan="2"
                      Grid.Column="1" />

        <Border Grid.ColumnSpan="3"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="{DynamicResource ToolTabBarBorderThickness}"
                IsHitTestVisible="False" />

        <Border x:Name="RulerBar"
                Grid.Column="2"
                Height="{DynamicResource ToolTabBarMinHeight}"
                Background="Transparent"
                PointerExited="TimelinePanel_PointerExited"
                PointerMoved="TimelinePanel_PointerMoved"
                PointerPressed="TimelinePanel_PointerPressed"
                PointerReleased="TimelinePanel_PointerReleased">
            <ecv:TimelineScale x:Name="Scale"
                               Height="32"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Bottom"
                               BufferBrush="{DynamicResource TextFillColorSecondaryBrush}"
                               BufferEnd="{Binding BufferStatus.End.Value}"
                               BufferStart="{Binding BufferStatus.Start.Value}"
                               CacheBlockBrush="{DynamicResource SystemFillColorSuccessBrush}"
                               CacheBlocks="{Binding BufferStatus.CacheBlocks.Value}"
                               ContextRequested="Scale_ContextRequested"
                               EndingBarBrush="{DynamicResource SystemFillColorCriticalBrush}"
                               EndingBarMargin="{CompiledBinding EndingBarMargin.Value}"
                               FrameRate="{CompiledBinding FrameRate}"
                               HoveredCacheBlock="{Binding HoveredCacheBlock.Value}"
                               LockedCacheBlockBrush="{DynamicResource AccentFillColorTertiaryBrush}"
                               MarkerLabelBackground="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                               MarkerLabelForeground="{DynamicResource TextFillColorPrimaryBrush}"
                               Markers="{Binding Markers}"
                               Scale="{Binding Options.Value.Scale}"
                               ScaleBrush="{DynamicResource TextControlForeground}"
                               SeekBarBrush="{DynamicResource AccentFillColorDefaultBrush}"
                               SeekBarMargin="{CompiledBinding SeekBarMargin.Value}"
                               StartingBarBrush="{DynamicResource SystemFillColorCriticalBrush}"
                               StartingBarMargin="{CompiledBinding StartingBarMargin.Value}"
                               TimeDisplayFormat="{CompiledBinding TimeDisplayFormat.Value}"
                               Offset="{Binding #ContentScroll.Offset, Mode=OneWay}">
                <ecv:TimelineScale.ContextFlyout>
                    <ui:FAMenuFlyout>
                        <ui:FAMenuFlyoutItem usage:UsageTracking.Feature="Timeline.DeleteAllFrameCache"
                                             Command="{Binding DeleteAllFrameCache}"
                                             Text="{x:Static lang:Strings.DeleteAll}" />
                        <ui:FAMenuFlyoutItem usage:UsageTracking.Feature="Timeline.DeleteFrameCache"
                                             Command="{Binding DeleteFrameCache}"
                                             Text="{x:Static lang:Strings.Delete}" />
                        <ui:FAMenuFlyoutItem usage:UsageTracking.Feature="Timeline.LockFrameCache"
                                             Command="{Binding LockFrameCache}"
                                             Text="{x:Static lang:Strings.Lock}" />
                        <ui:FAMenuFlyoutItem usage:UsageTracking.Feature="Timeline.UnlockFrameCache"
                                             Command="{Binding UnlockFrameCache}"
                                             Text="{x:Static lang:Strings.Unlock}" />
                    </ui:FAMenuFlyout>
                </ecv:TimelineScale.ContextFlyout>
            </ecv:TimelineScale>
        </Border>

        <ui:FATeachingTip x:Name="CacheTip"
                        Title="{x:Static lang:Strings.FrameCache}"
                        Subtitle="{x:Static lang:Strings.RightClickToOperateCache}"
                        Target="{Binding #Scale}" />

        <ScrollViewer x:Name="PaneScroll"
                      Grid.Row="1"
                      BringIntoViewOnFocusChange="False"
                      ScrollChanged="PaneScroll_ScrollChanged"
                      VerticalScrollBarVisibility="Hidden">
            <ItemsControl x:Name="LeftPanel"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ItemsSource="{CompiledBinding LayerHeaders}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:LayerHeader />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!--
            The tool modes on the left and the editing toggles on the right, which the right-click menu and the keys
            also change. Six 28 px buttons stay on one row in the column's 200 px minimum, so the row stays as tall
            as the ruler. The tooltips are written in code, with the current key.
        -->
        <controls:ToolTabBar x:Name="ToolBar" BorderThickness="0">
            <controls:ToolTabBarPanel>
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="RazorModeButton"
                                  usage:UsageTracking.Feature="Timeline.ToggleRazorMode"
                                  AutomationProperties.Name="{x:Static lang:Strings.RazorTool}"
                                  Classes="razor"
                                  IsChecked="{CompiledBinding IsRazorMode.Value, Mode=TwoWay}"
                                  Theme="{StaticResource TimelineToolModeToggleButtonTheme}">
                        <icons:FluentIcon FontSize="16" Icon="Cut" />
                    </ToggleButton>
                    <ToggleButton x:Name="SlipModeButton"
                                  usage:UsageTracking.Feature="Timeline.ToggleSlipMode"
                                  AutomationProperties.Name="{x:Static lang:Strings.SlipTool}"
                                  Classes="slip"
                                  IsChecked="{CompiledBinding IsSlipMode.Value, Mode=TwoWay}"
                                  Theme="{StaticResource TimelineToolModeToggleButtonTheme}">
                        <icons:FluentIcon FontSize="16" Icon="ArrowSwap" />
                    </ToggleButton>
                    <ToggleButton x:Name="RollModeButton"
                                  usage:UsageTracking.Feature="Timeline.ToggleRollMode"
                                  AutomationProperties.Name="{x:Static lang:Strings.RollTool}"
                                  Classes="roll"
                                  IsChecked="{CompiledBinding IsRollMode.Value, Mode=TwoWay}"
                                  Theme="{StaticResource TimelineToolModeToggleButtonTheme}">
                        <icons:FluentIcon FontSize="16" Icon="ArrowAutofitWidth" />
                    </ToggleButton>
                    <ToggleButton x:Name="SlideModeButton"
                                  usage:UsageTracking.Feature="Timeline.ToggleSlideMode"
                                  AutomationProperties.Name="{x:Static lang:Strings.SlideTool}"
                                  Classes="slide"
                                  IsChecked="{CompiledBinding IsSlideMode.Value, Mode=TwoWay}"
                                  Theme="{StaticResource TimelineToolModeToggleButtonTheme}">
                        <icons:FluentIcon FontSize="16" Icon="ArrowMove" />
                    </ToggleButton>
                </StackPanel>
                <ToggleButton x:Name="RippleButton"
                              usage:UsageTracking.Feature="Timeline.ToggleRippleMode"
                              AutomationProperties.Name="{x:Static lang:Strings.RippleEdit}"
                              IsChecked="{CompiledBinding IsRippleEnabled.Value, Mode=TwoWay}"
                              Theme="{StaticResource TimelineToolBarToggleButtonTheme}">
                    <icons:FluentIcon FontSize="16" Icon="ArrowFitIn" />
                </ToggleButton>
                <ToggleButton x:Name="SnapButton"
                              usage:UsageTracking.Feature="Timeline.ToggleSnap"
                              AutomationProperties.Name="{x:Static lang:Strings.TimelineSnap}"
                              IsChecked="{CompiledBinding IsSnapEnabled.Value, Mode=TwoWay}"
                              Theme="{StaticResource TimelineToolBarToggleButtonTheme}">
                    <Path Width="14"
                          Height="14"
                          Margin="1"
                          Data="{StaticResource TimelineSnapGeometry}"
                          Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                          StrokeJoin="Round"
                          StrokeLineCap="Round"
                          StrokeThickness="1" />
                </ToggleButton>
            </controls:ToolTabBarPanel>
        </controls:ToolTabBar>

        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="2"
                BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
                IsVisible="{CompiledBinding IsRazorMode.Value}"
                Theme="{StaticResource TimelineToolModeFrameTheme}" />

        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="2"
                BorderBrush="{DynamicResource SystemFillColorSuccessBrush}"
                IsVisible="{CompiledBinding IsSlipMode.Value}"
                Theme="{StaticResource TimelineToolModeFrameTheme}" />

        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="2"
                BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                IsVisible="{CompiledBinding IsRollMode.Value}"
                Theme="{StaticResource TimelineToolModeFrameTheme}" />

        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="2"
                BorderBrush="{DynamicResource SystemFillColorAttentionBrush}"
                IsVisible="{CompiledBinding IsSlideMode.Value}"
                Theme="{StaticResource TimelineToolModeFrameTheme}" />

        <ScrollViewer x:Name="ContentScroll"
                      Grid.Row="1"
                      Grid.Column="2"
                      BringIntoViewOnFocusChange="False"
                      HorizontalScrollBarVisibility="Visible">
            <Panel x:Name="TimelinePanel"
                   Width="{CompiledBinding PanelWidth.Value}"
                   MinWidth="{Binding #ContentScroll.Bounds.Width}"
                   MinHeight="{Binding #LeftPanel.Bounds.Height}"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Background="Transparent"
                   PointerExited="TimelinePanel_PointerExited"
                   PointerMoved="TimelinePanel_PointerMoved"
                   PointerPressed="TimelinePanel_PointerPressed"
                   PointerReleased="TimelinePanel_PointerReleased">
                <Panel.ContextFlyout>
                    <ui:FAMenuFlyout>
                        <ui:FAMenuFlyoutSubItem x:Name="EditingModeMenu" Text="{x:Static lang:Strings.EditingMode}">
                            <ui:FAMenuFlyoutSubItem.IconSource>
                                <icons:FluentIconSource Icon="Edit" />
                            </ui:FAMenuFlyoutSubItem.IconSource>
                        </ui:FAMenuFlyoutSubItem>
                        <ui:FAMenuFlyoutSeparator />
                        <ui:FAMenuFlyoutSubItem x:Name="AddElementSubMenu" Text="{x:Static lang:Strings.AddElement}" />
                        <ui:FAMenuFlyoutSubItem x:Name="AddFromTemplateSubMenu" Text="{x:Static lang:Strings.AddFromTemplate}" />
                        <ui:FAMenuFlyoutItem usage:UsageTracking.Feature="Timeline.AddAdjustmentLayer"
                                             Click="AddAdjustmentLayerClick"
                                             Text="{x:Static lang:Strings.AddAdjustmentLayer}">
                            <ui:FAMenuFlyoutItem.IconSource>
                                <icons:FluentIconSource Icon="Color" />
                            </ui:FAMenuFlyoutItem.IconSource>
                        </ui:FAMenuFlyoutItem>
                        <ui:FAMenuFlyoutItem usage:UsageTracking.Feature="Timeline.Paste"
                                             Command="{CompiledBinding Paste}"
                                             InputGesture="{h:GetCommandGesture timeline.paste}"
                                             Text="{x:Static lang:Strings.Paste}">
                            <ui:FAMenuFlyoutItem.IconSource>
                                <icons:FluentIconSource Icon="ClipboardPaste" />
                            </ui:FAMenuFlyoutItem.IconSource>
                        </ui:FAMenuFlyoutItem>
                        <ui:FAMenuFlyoutSeparator />
                        <ui:FAMenuFlyoutItem usage:UsageTracking.Feature="Timeline.SetStartTimeToPointerPosition"
                                             Command="{Binding SetStartTimeToPointerPosition}"
                                             InputGesture="{h:GetCommandGesture timeline.setStartTime}"
                                             Text="{x:Static lang:Strings.SetStartTime}" />
                        <ui:FAMenuFlyoutItem usage:UsageTracking.Feature="Timeline.SetEndTimeToPointerPosition"
                                             Command="{Binding SetEndTimeToPointerPosition}"
                                             InputGesture="{h:GetCommandGesture timeline.setEndTime}"
                                             Text="{x:Static lang:Strings.SetEndTime}" />
                        <ui:FAMenuFlyoutSubItem Text="{x:Static lang:Strings.Gaps}">
                            <ui:FAMenuFlyoutSubItem.IconSource>
                                <icons:SymbolIconSource Symbol="ArrowMoveInward" />
                            </ui:FAMenuFlyoutSubItem.IconSource>
                            <ui:FAMenuFlyoutItem usage:UsageTracking.Feature="Timeline.CloseGapAtPointerPosition"
                                                 Command="{CompiledBinding CloseGapAtPointerPosition}"
                                                 Text="{x:Static lang:Strings.CloseGap}" />
                            <ui:FAMenuFlyoutItem usage:UsageTracking.Feature="Timeline.CloseAllGaps"
                                                 Command="{CompiledBinding CloseAllGaps}"
                                                 InputGesture="{h:GetCommandGesture timeline.closeAllGaps,
                                                                                  ExtensionType={x:Type p:TimelineTabExtension}}"
                                                 Text="{x:Static lang:Strings.CloseAllGaps}" />
                            <ui:FAMenuFlyoutSeparator />
                            <ui:FAMenuFlyoutItem usage:UsageTracking.Feature="Timeline.GoToNextGap"
                                                 Command="{CompiledBinding GoToNextGap}"
                                                 InputGesture="{h:GetCommandGesture timeline.goToNextGap,
                                                                                  ExtensionType={x:Type p:TimelineTabExtension}}"
                                                 Text="{x:Static lang:Strings.GoToNextGap}" />
                            <ui:FAMenuFlyoutItem usage:UsageTracking.Feature="Timeline.GoToPreviousGap"
                                                 Command="{CompiledBinding GoToPreviousGap}"
                                                 InputGesture="{h:GetCommandGesture timeline.goToPreviousGap,
                                                                                  ExtensionType={x:Type p:TimelineTabExtension}}"
                                                 Text="{x:Static lang:Strings.GoToPreviousGap}" />
                        </ui:FAMenuFlyoutSubItem>
                        <ui:FAMenuFlyoutSubItem x:Name="BulkSelectionMenu" Text="{x:Static lang:Strings.BulkSelection}" />
                        <ui:FAMenuFlyoutSeparator />
                        <ui:FAToggleMenuFlyoutItem IsChecked="{Binding AutoAdjustSceneDuration.Value, Mode=TwoWay}" Text="{x:Static lang:SettingsStrings.AutoAdjustSceneDuration}" />
                        <ui:FAToggleMenuFlyoutItem IsChecked="{Binding IsSnapEnabled.Value, Mode=TwoWay}" Text="{x:Static lang:Strings.TimelineSnap}" />
                        <ui:FAMenuFlyoutSeparator />
                        <ui:FAMenuFlyoutItem usage:UsageTracking.Feature="Timeline.ShowSceneSettings"
                                             Click="ShowSceneSettings"
                                             Text="{x:Static lang:Strings.Settings}">
                            <ui:FAMenuFlyoutItem.IconSource>
                                <icons:FluentIconSource Icon="Settings" />
                            </ui:FAMenuFlyoutItem.IconSource>
                        </ui:FAMenuFlyoutItem>
                        <ui:FAMenuFlyoutItem usage:UsageTracking.Feature="Timeline.ShowBpmGridFlyout"
                                             Click="ShowBpmGridFlyout"
                                             Text="{x:Static lang:Strings.BpmGrid}">
                            <ui:FAMenuFlyoutItem.IconSource>
                                <icons:FluentIconSource Icon="MusicNote1" />
                            </ui:FAMenuFlyoutItem.IconSource>
                        </ui:FAMenuFlyoutItem>
                        <ui:FAMenuFlyoutSubItem x:Name="ZoomMenu" Text="{x:Static lang:Strings.TimelineZoom}">
                            <ui:FAMenuFlyoutSubItem.IconSource>
                                <icons:FluentIconSource Icon="ZoomIn" />
                            </ui:FAMenuFlyoutSubItem.IconSource>
                            <ui:FAMenuFlyoutItem usage:UsageTracking.Feature="Timeline.FitAll"
                                                 Command="{CompiledBinding FitAll}"
                                                 InputGesture="{h:GetCommandGesture timeline.fitAll,
                                                                                  ExtensionType={x:Type p:TimelineTabExtension}}"
                                                 Text="{x:Static lang:Strings.GraphFitAll}" />
                            <ui:FAMenuFlyoutItem usage:UsageTracking.Feature="Timeline.FitSelection"
                                                 Command="{CompiledBinding FitSelection}"
                                                 InputGesture="{h:GetCommandGesture timeline.fitSelection,
                                                                                  ExtensionType={x:Type p:TimelineTabExtension}}"
                                                 Text="{x:Static lang:Strings.GraphFitSelection}" />
                            <ui:FAMenuFlyoutSeparator />
                            <ui:FAMenuFlyoutItem usage:UsageTracking.Feature="Timeline.Zoom"
                                                 Click="ZoomClick"
                                                 CommandParameter="2.0"
                                                 Text="200%" />
                            <ui:FAMenuFlyoutItem usage:UsageTracking.Feature="Timeline.Zoom"
                                                 Click="ZoomClick"
                                                 CommandParameter="1.7"
                                                 Text="170%" />
                            <ui:FAMenuFlyoutItem usage:UsageTracking.Feature="Timeline.Zoom"
                                                 Click="ZoomClick"
                                                 CommandParameter="1.5"
                                                 Text="150%" />
                            <ui:FAMenuFlyoutItem usage:UsageTracking.Feature="Timeline.Zoom"
                                                 Click="ZoomClick"
                                                 CommandParameter="1.2"
                                                 Text="120%" />
                            <ui:FAMenuFlyoutItem usage:UsageTracking.Feature="Timeline.Zoom"
                                                 Click="ZoomClick"
                                                 CommandParameter="1.0"
                                                 Text="100%" />
                            <ui:FAMenuFlyoutItem usage:UsageTracking.Feature="Timeline.Zoom"
                                                 Click="ZoomClick"
                                                 CommandParameter="0.7"
                                                 Text="70%" />
                            <ui:FAMenuFlyoutItem usage:UsageTracking.Feature="Timeline.Zoom"
                                                 Click="ZoomClick"
                                                 CommandParameter="0.5"
                                                 Text="50%" />
                            <ui:FAMenuFlyoutItem usage:UsageTracking.Feature="Timeline.Zoom"
                                                 Click="ZoomClick"
                                                 CommandParameter="0.2"
                                                 Text="20%" />
                        </ui:FAMenuFlyoutSubItem>
                    </ui:FAMenuFlyout>
                </Panel.ContextFlyout>

                <local:TimelineBackground BorderBrush="{DynamicResource TextFillColorTertiaryBrush}" ItemHeight="{DynamicResource LayerHeight}" />

                <ecv:BpmGridOverlay x:Name="BpmGrid"
                                    VerticalAlignment="Stretch"
                                    BeatBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                    BpmOptions="{CompiledBinding Options.Value.BpmGrid}"
                                    Scale="{CompiledBinding Options.Value.Scale}"
                                    SubdivisionBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                    Viewport="{Binding #ContentScroll.Viewport, Mode=OneWay}"
                                    ZIndex="1"
                                    Offset="{Binding #ContentScroll.Offset, Mode=OneWay}" />

                <ecv:TimelineOverlay x:Name="overlay"
                                     VerticalAlignment="Stretch"
                                     EndingBarBrush="{DynamicResource SystemFillColorCriticalBrush}"
                                     EndingBarMargin="{CompiledBinding EndingBarMargin.Value}"
                                     SeekBarBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                     SeekBarMargin="{CompiledBinding SeekBarMargin.Value}"
                                     SnapBarBrush="{DynamicResource SystemFillColorAttentionBrush}"
                                     SnapBarPosition="{CompiledBinding SnapBarPosition.Value}"
                                     StartingBarBrush="{DynamicResource SystemFillColorCriticalBrush}"
                                     StartingBarMargin="{CompiledBinding StartingBarMargin.Value}"
                                     Viewport="{Binding #ContentScroll.Viewport, Mode=OneWay}"
                                     ZIndex="6"
                                     Offset="{Binding #ContentScroll.Offset, Mode=OneWay}" />
            </Panel>
        </ScrollViewer>
    </Grid>
</UserControl>
