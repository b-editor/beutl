<UserControl x:Class="Beutl.Editor.Components.AiWorkspaceTab.Views.AiJoinProPanel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="using:Beutl.Language"
             xmlns:vm="using:Beutl.Editor.Components.AiWorkspaceTab.ViewModels"
             x:CompileBindings="True"
             x:DataType="vm:IAiPlanOffer"
             IsVisible="{CompiledBinding ShowJoinPro.Value}">
    <StackPanel Spacing="8">
        <TextBlock Text="{x:Static lang:Strings.AiProRequired}" TextWrapping="Wrap" />
        <Button x:Name="JoinButton"
                HorizontalAlignment="Left"
                Command="{CompiledBinding OpenAiPlan}"
                Content="{x:Static lang:Strings.AiJoinPro}" />
    </StackPanel>
</UserControl>
