<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Beutl.Controls"
                    xmlns:pe="using:Beutl.Controls.PropertyEditors">
    <!--  A number with its header and box only, as Low Range and High Range beside the tonal range slider.  -->
    <ControlTheme x:Key="GradingCompactNumberEditor" TargetType="pe:StringEditorBase">
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Name="PART_HeaderTextBlock"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               Cursor="SizeWestEast"
                               Text="{TemplateBinding Header}"
                               ToolTip.Tip="{TemplateBinding HeaderTooltip}" />

                    <TextBox x:Name="PART_InnerTextBox"
                             Grid.Column="1"
                             Width="56"
                             MinHeight="26"
                             Margin="0,2"
                             Padding="6,3,6,3"
                             HorizontalContentAlignment="Right"
                             controls:TextBoxAttachment.EnterDownBehavior="LostFocus"
                             IsEnabled="{TemplateBinding IsReadOnly, Converter={x:Static BoolConverters.Not}}"
                             Text="{TemplateBinding Text, Mode=TwoWay}" />

                    <StackPanel Name="LeftRightButtons"
                                Grid.Column="2"
                                Margin="2,0,0,0"
                                Orientation="Horizontal">
                        <Button Name="PART_LeftButton"
                                Classes="left"
                                Theme="{StaticResource PropertyEditorLeftRightButton}" />

                        <Button Name="PART_RightButton"
                                Classes="right"
                                Theme="{StaticResource PropertyEditorLeftRightButton}" />
                    </StackPanel>

                    <ContentPresenter Name="PART_MenuContentPresenter"
                                      Grid.Column="3"
                                      VerticalAlignment="Center"
                                      Content="{TemplateBinding MenuContent}"
                                      ContentTemplate="{TemplateBinding MenuContentTemplate}" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:not(:visible-left-button) /template/ Button#PART_LeftButton">
            <Setter Property="IsEnabled" Value="False" />
        </Style>
        <Style Selector="^:not(:visible-right-button) /template/ Button#PART_RightButton">
            <Setter Property="IsEnabled" Value="False" />
        </Style>
        <Style Selector="^[KeyFrameCount=0] /template/ StackPanel#LeftRightButtons">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ControlTheme>

    <!--  The name of a group of adjustments, above its sliders.  -->
    <ControlTheme x:Key="GradingGroupLabelTheme" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </ControlTheme>
</ResourceDictionary>
