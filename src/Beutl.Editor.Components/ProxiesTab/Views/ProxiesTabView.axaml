<UserControl x:Class="Beutl.Editor.Components.ProxiesTab.Views.ProxiesTabView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Beutl.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             xmlns:lang="using:Beutl.Language"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:Beutl.Editor.Components.ProxiesTab.Views"
             xmlns:vm="using:Beutl.Editor.Components.ProxiesTab.ViewModels"
             d:DesignHeight="520"
             d:DesignWidth="360"
             x:CompileBindings="True"
             x:DataType="vm:ProxiesTabViewModel"
             mc:Ignorable="d">
    <UserControl.Styles>
        <Style Selector="Button#GenerateButton">
            <Setter Property="Command" Value="{Binding GenerateAllCommand}" />
            <Setter Property="Content" Value="{x:Static lang:Strings.ProxyGenerateAll}" />
        </Style>
        <Style Selector="Button#GenerateButton.hasSelection">
            <Setter Property="Command" Value="{Binding GenerateSelectedCommand}" />
            <Setter Property="Content" Value="{x:Static lang:Strings.ProxyGenerateSelected}" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.metricValue">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Border.proxyItem">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.proxyItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Border.proxyItem.selected">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Border.statePill">
            <Setter Property="MaxWidth" Value="110" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.statePill.ready">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
        </Style>
        <Style Selector="Border.statePill.stale">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
        </Style>
        <Style Selector="Border.statePill.failed">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <controls:ToolTabBar x:Name="ToolBar">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="{x:Static lang:Strings.Proxies}"
                           Theme="{StaticResource ToolTabBarTitleTextBlockTheme}" />
                <TextBlock Grid.Column="1"
                           Margin="0,0,8,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Text="{Binding ClipCountText.Value}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding ClipSummary.Value}" />
                <Button x:Name="RefreshButton"
                        Grid.Column="2"
                        AutomationProperties.Name="{x:Static lang:Strings.Refresh}"
                        Command="{Binding RefreshCommand}"
                        Theme="{StaticResource ToolTabBarIconButtonTheme}"
                        ToolTip.Tip="{x:Static lang:Strings.Refresh}">
                    <icons:SymbolIcon FontSize="16" Symbol="ArrowClockwise" />
                </Button>
            </Grid>
        </controls:ToolTabBar>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !HasClips.Value}">
            <Border x:Name="EmptyState" Margin="24" VerticalAlignment="Center">
                <StackPanel MaxWidth="320" Spacing="12">
                    <Border Width="56" Height="56" HorizontalAlignment="Center"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="16">
                        <icons:SymbolIcon FontSize="24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="Play" />
                    </Border>
                    <TextBlock FontSize="16" Text="{x:Static lang:Strings.ProxyEmptyTitle}"
                               TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Classes="secondary" Text="{x:Static lang:Strings.ProxyEmptyDescription}"
                               TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <ScrollViewer x:Name="ContentScrollViewer" Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasClips.Value}">
            <StackPanel Margin="8" Spacing="12">
                <Border x:Name="StorageSummary" Classes="options-group" Padding="12">
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                        <TextBlock Classes="secondary" Text="{x:Static lang:Strings.Project}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Classes="secondary" Text="{x:Static lang:Strings.ProxyStoreUsage}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="2" Classes="secondary" Text="{x:Static lang:Strings.ProxyStoreCap}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Classes="metricValue" Text="{Binding ProjectUsageText.Value}" ToolTip.Tip="{Binding ProjectUsageText.Value}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="metricValue" Text="{Binding StoreUsageText.Value}" ToolTip.Tip="{Binding StoreUsageText.Value}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Classes="metricValue" Text="{Binding StoreCapText.Value}" ToolTip.Tip="{Binding StoreCapText.Value}" />
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Button x:Name="GenerateButton" Classes="accent"
                            Classes.hasSelection="{Binding HasSelection.Value}"
                            HorizontalAlignment="Left" />
                    <Button x:Name="MoreActionsButton" Grid.Column="2"
                            AutomationProperties.Name="{x:Static lang:Strings.ProxyMoreActions}"
                            Theme="{StaticResource ToolTabBarIconButtonTheme}"
                            ToolTip.Tip="{x:Static lang:Strings.ProxyMoreActions}">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="{x:Static lang:Strings.ProxyGenerateAll}" Command="{Binding GenerateAllCommand}" />
                                <Separator />
                                <MenuItem Header="{x:Static lang:Strings.ProxyRegenerateSelected}"
                                          Command="{Binding RegenerateSelectedCommand}" IsEnabled="{Binding HasSelection.Value}" />
                                <MenuItem Header="{x:Static lang:Strings.ProxyDeleteSelected}"
                                          Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding HasSelection.Value}" />
                                <Separator />
                                <MenuItem Header="{x:Static lang:Strings.ProxyDeleteProjectProxies}" Command="{Binding DeleteAllForProjectCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <icons:FluentIcon FontSize="16" Icon="MoreVertical" />
                    </Button>
                </Grid>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{x:Static lang:Strings.ProxyClips}" />
                    <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding SelectionSummary.Value}" />
                </Grid>

                <Border Classes="options-group">
                    <ItemsControl x:Name="ClipList" ItemsSource="{Binding Clips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:OptionsGroupPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProxyClipViewModel">
                                <Border Classes="proxyItem" Classes.selected="{Binding IsSelected.Value}" Tapped="OnProxyItemTapped">
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                        <CheckBox x:Name="SelectClipCheckBox" Grid.RowSpan="2" VerticalAlignment="Top"
                                                  AutomationProperties.Name="{Binding FileName}"
                                                  IsChecked="{Binding IsSelected.Value}" />
                                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock x:Name="FileNameText" VerticalAlignment="Center"
                                                       Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                                            <Border Grid.Column="1" Classes="statePill"
                                                    Classes.failed="{Binding IsFailed.Value}"
                                                    Classes.ready="{Binding IsReady.Value}"
                                                    Classes.stale="{Binding IsStale.Value}">
                                                <TextBlock FontSize="12" Text="{Binding State.Value}" TextWrapping="Wrap" />
                                            </Border>
                                        </Grid>

                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                            <Grid x:Name="ClipActions" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                                <ComboBox x:Name="QualityComboBox" MinWidth="88" HorizontalAlignment="Left"
                                                          AutomationProperties.Name="{x:Static lang:Strings.ProxyQuality}"
                                                          SelectedIndex="{Binding Preset.Value, Converter={x:Static views:ProxyPresetIndexConverter.Instance}, Mode=TwoWay}"
                                                          Theme="{StaticResource LiteComboBoxStyle}" ToolTip.Tip="{x:Static lang:Strings.ProxyQuality}">
                                                    <ComboBoxItem Content="{x:Static lang:Strings.ProxyPresetHalf}" />
                                                    <ComboBoxItem Content="{x:Static lang:Strings.ProxyPresetQuarter}" />
                                                    <ComboBoxItem Content="{x:Static lang:Strings.ProxyPresetEighth}" />
                                                </ComboBox>
                                                <Button x:Name="GenerateClipButton" Grid.Column="1"
                                                        Command="{Binding GenerateCommand}" Content="{x:Static lang:Strings.ProxyGenerate}"
                                                        IsVisible="{Binding !HasJob.Value}" />
                                                <Button x:Name="CancelJobButton" Grid.Column="1"
                                                        Command="{Binding CancelJobCommand}"
                                                        AutomationProperties.Name="{x:Static lang:Strings.Cancel}"
                                                        Theme="{StaticResource ToolTabBarIconButtonTheme}"
                                                        ToolTip.Tip="{x:Static lang:Strings.Cancel}"
                                                        IsVisible="{Binding HasJob.Value}">
                                                    <icons:SymbolIcon FontSize="16" Symbol="Dismiss" />
                                                </Button>
                                                <Button x:Name="ClipMoreButton" Grid.Column="2"
                                                        AutomationProperties.Name="{x:Static lang:Strings.ProxyMoreActions}"
                                                        Theme="{StaticResource ToolTabBarIconButtonTheme}" ToolTip.Tip="{x:Static lang:Strings.ProxyMoreActions}">
                                                    <Button.Flyout>
                                                        <MenuFlyout>
                                                            <MenuItem Header="{x:Static lang:Strings.ProxyRegenerate}" Command="{Binding RegenerateCommand}" />
                                                            <MenuItem Header="{x:Static lang:Strings.Delete}" Command="{Binding DeleteCommand}" />
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                    <icons:FluentIcon FontSize="16" Icon="MoreVertical" />
                                                </Button>
                                            </Grid>

                                            <TextBlock Classes="secondary" Text="{Binding ProxyInfoText.Value}"
                                                       TextWrapping="Wrap" IsVisible="{Binding !IsMissing.Value}" />
                                            <TextBlock FontSize="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                       Text="{Binding FailureReason.Value}" TextWrapping="Wrap"
                                                       IsVisible="{Binding FailureReason.Value, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <StackPanel x:Name="JobProgressPanel" Spacing="4" IsVisible="{Binding HasJob.Value}">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <TextBlock Classes="secondary" Text="{Binding JobStatus.Value}" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding JobProgressText.Value}" />
                                                </Grid>
                                                <ProgressBar Height="4" Maximum="1" Value="{Binding JobProgressValue.Value}" />
                                            </StackPanel>

                                            <ToggleButton x:Name="DetailsToggle" Padding="0,2" HorizontalAlignment="Left"
                                                          FontSize="12" IsChecked="False" Theme="{StaticResource TransparentButton}"
                                                          AutomationProperties.Name="{x:Static lang:Strings.ProxyDetails}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <icons:FluentIcon FontSize="12" Icon="ChevronRight" IsVisible="{Binding !#DetailsToggle.IsChecked}" />
                                                    <icons:FluentIcon FontSize="12" Icon="ChevronDown" IsVisible="{Binding #DetailsToggle.IsChecked}" />
                                                    <TextBlock Text="{x:Static lang:Strings.ProxyDetails}" />
                                                </StackPanel>
                                            </ToggleButton>
                                            <StackPanel x:Name="DetailsPanel" Spacing="4" IsVisible="{Binding #DetailsToggle.IsChecked}">
                                                <SelectableTextBlock Background="Transparent" FontSize="12" Text="{Binding Path}" TextWrapping="Wrap" />
                                                <TextBlock Classes="secondary" Text="{Binding SourceInfoText}" TextWrapping="Wrap" />
                                                <TextBlock Classes="secondary" Text="{Binding LastUsedText.Value}" TextWrapping="Wrap"
                                                           IsVisible="{Binding LastUsedText.Value, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
