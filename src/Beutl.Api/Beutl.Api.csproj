<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <BeutlPublicLibrary>true</BeutlPublicLibrary>
    <BeutlSdkAutoReference>Api</BeutlSdkAutoReference>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\index.html" />
    <!-- Beutl's libraries, which CoreLibraries resolves to the host and never downloads (build/BeutlLibraries.proj). -->
    <EmbeddedResource Include="$(IntermediateOutputPath)BeutlLibraries.txt" LogicalName="BeutlLibraries.txt" />
    <_BeutlLibraryInput Include="$(RootDirectory)src/*/*.csproj;$(RootDirectory)build/BeutlLibraries.proj;$(RootDirectory)Directory.Build.targets" />
  </ItemGroup>

  <Target Name="_WriteBeutlLibraries" BeforeTargets="PrepareResources" Inputs="@(_BeutlLibraryInput)" Outputs="$(IntermediateOutputPath)BeutlLibraries.txt">
    <MSBuild Projects="$(RootDirectory)build/BeutlLibraries.proj" Targets="CollectBeutlLibraries">
      <Output TaskParameter="TargetOutputs" ItemName="_BeutlLibrary" />
    </MSBuild>
    <WriteLinesToFile File="$(IntermediateOutputPath)BeutlLibraries.txt" Lines="@(_BeutlLibrary)" Overwrite="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyModel" />
    <PackageReference Include="Nito.AsyncEx" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="ReactiveProperty" />
    <PackageReference Include="Refit" />
    <PackageReference Include="System.Reactive" />
    <PackageReference Include="System.Interactive" />

    <PackageReference Include="NuGet.ProjectModel" />
    <PackageReference Include="NuGet.Protocol" />
    <PackageReference Include="NuGet.Resolver" />
    <!-- NuGet.Packaging 7.9.0 pulls System.Security.Cryptography.Pkcs 8.0.1, which has DoS advisories
         (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Drop this once NuGet.Packaging depends on a patched version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Beutl.Core\Beutl.Core.csproj" />
    <ProjectReference Include="..\Beutl.Configuration\Beutl.Configuration.csproj" />
    <ProjectReference Include="..\Beutl.Extensibility\Beutl.Extensibility.csproj" />
    <ProjectReference Include="..\Beutl.Language\Beutl.Language.csproj" />
    <ProjectReference Include="..\Beutl.ProjectSystem\Beutl.ProjectSystem.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Allow package lifecycle tests to exercise internal load/rollback seams without
         widening the extension API surface. -->
    <InternalsVisibleTo Include="Beutl.UnitTests" />
    <InternalsVisibleTo Include="Beutl.Editor" />
    <!-- Headless integration tests exercise the internal authenticated retry seam. -->
    <InternalsVisibleTo Include="Beutl.HeadlessUITests" />
  </ItemGroup>

</Project>
