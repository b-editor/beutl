<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fonts="using:Beutl.Controls.Styling">
    <fonts:UiFontFamily x:Key="NotoSansJP" FamilyName="Noto Sans JP" />
    <fonts:UiFontFamily x:Key="BeutlUIFontFamily" />
    <StaticResource x:Key="ContentControlThemeFontFamily" ResourceKey="BeutlUIFontFamily" />
</ResourceDictionary>
