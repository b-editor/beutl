    <StaticResource x:Key="GraphEditorHandleLineBrush" ResourceKey="TextControlForeground" />
    <StaticResource x:Key="GraphEditorKeyFrameBrush" ResourceKey="SystemFillColorCautionBrush" />

</ResourceDictionary>
