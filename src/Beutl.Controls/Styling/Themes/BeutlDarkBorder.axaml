    <!-- ===== Main window background ===== -->
    <SolidColorBrush x:Key="MainWindowBackground" Color="#FF0E0E0F" />

    <!--
        ===== Dock surfaces =====
        DynamicResource-consumed, so these flat overrides win over Dock/DockFluent.axaml's Dark
        ThemeDictionary.
    -->
    <SolidColorBrush x:Key="DockThemeBackgroundBrush" Color="#0E0E0F" />
    <SolidColorBrush x:Key="DockThemeControlBackgroundBrush" Color="#17181A" />
    <SolidColorBrush x:Key="DockThemeBorderLowBrush" Color="#222327" />

    <SolidColorBrush x:Key="DockSurfaceWorkbenchBrush" Color="#222327" />
    <SolidColorBrush x:Key="DockSurfaceSidebarBrush" Color="#0E0E0F" />
    <SolidColorBrush x:Key="DockSurfaceEditorBrush" Color="#0E0E0F" />
    <SolidColorBrush x:Key="DockSurfacePanelBrush" Color="#0E0E0F" />
    <SolidColorBrush x:Key="TerminalForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DockSurfaceHeaderBrush" Color="#0E0E0F" />
    <SolidColorBrush x:Key="DockSurfaceHeaderActiveBrush" Color="#0E0E0F" />

    <SolidColorBrush x:Key="DockBorderSubtleBrush" Color="#222327" />
    <SolidColorBrush x:Key="DockBorderStrongBrush" Color="#333437" />
    <SolidColorBrush x:Key="DockSeparatorBrush" Color="#222327" />
    <SolidColorBrush x:Key="DockSplitterIdleBrush" Color="#222327" />
    <SolidColorBrush x:Key="DockSplitterHoverBrush" Color="{DynamicResource SystemAccentColorLight1}" />
    <!--  The title-bar bottom border shares the dock splitter's color in this theme only.  -->
    <StaticResource x:Key="TitleBarBottomBorderBrush" ResourceKey="DockSplitterIdleBrush" />

    <SolidColorBrush x:Key="DockTabBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="DockTabHoverBackgroundBrush" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="DockTabActiveBackgroundBrush" Color="#14FFFFFF" />

    <SolidColorBrush x:Key="DockDocumentTabStripBackgroundBrush" Color="Transparent" />

    <SolidColorBrush x:Key="DockChromeButtonHoverBackgroundBrush" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="DockChromeButtonPressedBackgroundBrush" Color="#14FFFFFF" />

    <!-- ===== Graph editor (shared with Timeline) ===== -->
    <StaticResource x:Key="GraphEditorBackgroundBrush" ResourceKey="DockSurfacePanelBrush" />
    <StaticResource x:Key="GraphEditorGridLineBrush" ResourceKey="TextFillColorTertiaryBrush" />
    <StaticResource x:Key="GraphEditorScaleTextBrush" ResourceKey="TextControlForeground" />
    <StaticResource x:Key="GraphEditorControlPointFillBrush" ResourceKey="SystemFillColorCautionBrush" />
