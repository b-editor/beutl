<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="using:FluentIcons.Avalonia.Fluent">
    <Styles.Resources>
        <ControlTheme x:Key="ToolTabNavigationItemTheme"
                      BasedOn="{StaticResource LiteNavTabStripItem}"
                      TargetType="TabStripItem">
            <Setter Property="MinHeight" Value="32" />
            <!--  LiteNav's content presenter already supplies 3px above and below.  -->
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontWeight" Value="Normal" />
        </ControlTheme>
    </Styles.Resources>

    <Style Selector="TabStrip.toolTabNavigation">
        <Setter Property="Theme" Value="{StaticResource LiteNavTabStrip}" />
        <Setter Property="ItemContainerTheme" Value="{StaticResource ToolTabNavigationItemTheme}" />
    </Style>

    <Style Selector="TabStrip.toolTabNavigation TabStripItem > Grid">
        <Setter Property="ColumnSpacing" Value="4" />
        <Style Selector="^ > TextBlock">
            <Setter Property="IsVisible" Value="{Binding $parent[TabStripItem].IsSelected}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="^ > icons|FluentIcon">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Style>
</Styles>
