<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Beutl.Controls"
                    xmlns:local="using:Beutl.Controls.PropertyEditors">
    <Design.PreviewWith>
        <StackPanel Width="360" Grid.IsSharedSizeScope="True" Spacing="4">
            <local:ValueSlider Maximum="100" Minimum="-100" Origin="0" Value="30" />
        </StackPanel>
    </Design.PreviewWith>

    <!--  Tints rather than Fluent's fill brushes, some of which are opaque in high contrast: a ValueSliderField lies over
          the number's text, which has to show through it.  -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="ValueSliderFieldTint" Color="#12000000" />
            <SolidColorBrush x:Key="ValueSliderFieldStrongTint" Color="#1F000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ValueSliderFieldTint" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="ValueSliderFieldStrongTint" Color="#28FFFFFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <ControlTheme x:Key="{x:Type local:ValueSlider}" TargetType="local:ValueSlider">
        <Setter Property="Background" Value="{DynamicResource SliderTrackFill}" />
        <Setter Property="Foreground" Value="{DynamicResource SliderTrackValueFill}" />
        <Setter Property="ThumbBrush" Value="{DynamicResource SliderThumbBackground}" />
        <Setter Property="ThumbBorderBrush" Value="{DynamicResource SliderThumbBorderBrush}" />
        <Setter Property="TickBrush" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <!--  A number in one row: its header, a slider, the box and its keyframe buttons. Rows that share a
          Grid.IsSharedSizeScope line up: their sliders start at one place, and once any row shows keyframe buttons
          the others keep room for them, so that the sliders also end at one place. With the compact class a row
          drops its slider and its box takes the slider's place, at the end of the room the row is given. The box's
          column comes from styles, since a value the template sets would beat them.  -->
    <ControlTheme x:Key="NumberSliderEditorTheme" TargetType="local:StringEditorBase">
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="NumberSliderEditorHeader" />
                            <ColumnDefinition Width="*" MinWidth="32" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="NumberSliderEditorKeyFrames" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Name="PART_HeaderTextBlock"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Cursor="SizeWestEast"
                                   Text="{TemplateBinding Header}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{TemplateBinding HeaderTooltip}" />

                        <local:ValueSlider Name="PART_Slider"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           IsEnabled="{TemplateBinding IsReadOnly, Converter={x:Static BoolConverters.Not}}" />

                        <TextBox x:Name="PART_InnerTextBox"
                                 Width="64"
                                 MinHeight="26"
                                 Margin="8,2,0,2"
                                 Padding="6,3,6,3"
                                 HorizontalContentAlignment="Right"
                                 controls:TextBoxAttachment.EnterDownBehavior="LostFocus"
                                 IsEnabled="{TemplateBinding IsReadOnly, Converter={x:Static BoolConverters.Not}}"
                                 Text="{TemplateBinding Text, Mode=TwoWay}" />

                        <StackPanel Name="LeftRightButtons"
                                    Grid.Column="3"
                                    Margin="2,0,0,0"
                                    Orientation="Horizontal">
                            <Button Name="PART_LeftButton"
                                    Classes="left"
                                    Theme="{StaticResource PropertyEditorLeftRightButton}" />

                            <Button Name="PART_RightButton"
                                    Classes="right"
                                    Theme="{StaticResource PropertyEditorLeftRightButton}" />
                        </StackPanel>

                        <ContentPresenter Name="PART_MenuContentPresenter"
                                          Grid.Column="4"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding MenuContent}"
                                          ContentTemplate="{TemplateBinding MenuContentTemplate}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ TextBox#PART_InnerTextBox">
            <Setter Property="Grid.Column" Value="2" />
        </Style>
        <Style Selector="^.compact">
            <Style Selector="^ /template/ local|ValueSlider#PART_Slider">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ TextBox#PART_InnerTextBox">
                <Setter Property="Grid.Column" Value="1" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
        </Style>

        <Style Selector="^:not(:visible-left-button) /template/ Button#PART_LeftButton">
            <Setter Property="IsEnabled" Value="False" />
        </Style>
        <Style Selector="^:not(:visible-right-button) /template/ Button#PART_RightButton">
            <Setter Property="IsEnabled" Value="False" />
        </Style>
        <Style Selector="^[KeyFrameCount=0] /template/ StackPanel#LeftRightButtons">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ControlTheme>

    <!--  Over a number's text box: nothing shows until the pointer comes, and then the slider fades in. It fades as a
          whole because a brush fading from Transparent, which is a white, passes through colors brighter than it ends on.  -->
    <ControlTheme x:Key="{x:Type local:ValueSliderField}" TargetType="local:ValueSliderField">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ValueSliderFieldTint}" />
        <Setter Property="ThumbBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrushPointerOver}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Cursor" Value="SizeWestEast" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="00:00:00.083" />
                <BrushTransition Property="Background" Duration="00:00:00.083" />
                <BrushTransition Property="Foreground" Duration="00:00:00.083" />
                <BrushTransition Property="ThumbBrush" Duration="00:00:00.083" />
            </Transitions>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </ControlTheme>

    <!--  A number whose box takes a drag and is also its slider if it has a range, in the panel's two layouts. PART_Slider
          lies over the text box, which it leaves to the pointer only while the text is being edited.  -->
    <ControlTheme x:Key="NumberSliderFieldEditorTheme" TargetType="local:StringEditorBase">
        <Setter Property="MinWidth" Value="{DynamicResource PropertyEditorMinWidth}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Padding="{TemplateBinding Padding}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <local:PropertyEditorGrid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Name="PART_HeaderTextBlock"
                                   Margin="4,0,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   ClipToBounds="False"
                                   Text="{TemplateBinding Header}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{TemplateBinding HeaderTooltip}" />

                        <GridSplitter Grid.Column="1" Background="Transparent" />

                        <Grid Grid.Column="2"
                              MinWidth="120"
                              Margin="4"
                              ColumnDefinitions="*,Auto">
                            <TextBox x:Name="PART_InnerTextBox"
                                     controls:TextBoxAttachment.EnterDownBehavior="LostFocus"
                                     IsEnabled="{TemplateBinding IsReadOnly, Converter={x:Static BoolConverters.Not}}"
                                     Text="{TemplateBinding Text, Mode=TwoWay}" />

                            <local:ValueSliderField Name="PART_Slider"
                                                    IsEnabled="{TemplateBinding IsReadOnly, Converter={x:Static BoolConverters.Not}}"
                                                    IsHitTestVisible="{CompiledBinding #PART_InnerTextBox.IsKeyboardFocusWithin, Converter={x:Static BoolConverters.Not}}" />

                            <StackPanel Name="LeftRightButtons"
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        Orientation="Horizontal">
                                <Button Name="PART_LeftButton"
                                        Classes="left"
                                        Theme="{StaticResource PropertyEditorLeftRightButton}" />

                                <Button Name="PART_RightButton"
                                        Classes="right"
                                        Theme="{StaticResource PropertyEditorLeftRightButton}" />
                            </StackPanel>
                        </Grid>

                        <ContentPresenter Name="PART_MenuContentPresenter"
                                          Grid.Column="3"
                                          Content="{TemplateBinding MenuContent}"
                                          ContentTemplate="{TemplateBinding MenuContentTemplate}" />
                    </local:PropertyEditorGrid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:compact">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Padding="{TemplateBinding Padding}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*">
                            <TextBlock Name="PART_HeaderTextBlock"
                                       Grid.Row="0"
                                       Margin="4,0,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Text="{TemplateBinding Header}"
                                       ToolTip.Tip="{TemplateBinding HeaderTooltip}" />

                            <TextBox x:Name="PART_InnerTextBox"
                                     Grid.Row="1"
                                     Margin="4"
                                     controls:TextBoxAttachment.EnterDownBehavior="LostFocus"
                                     IsEnabled="{TemplateBinding IsReadOnly, Converter={x:Static BoolConverters.Not}}"
                                     Text="{TemplateBinding Text, Mode=TwoWay}" />

                            <local:ValueSliderField Name="PART_Slider"
                                                    Grid.Row="1"
                                                    Margin="4"
                                                    IsEnabled="{TemplateBinding IsReadOnly, Converter={x:Static BoolConverters.Not}}"
                                                    IsHitTestVisible="{CompiledBinding #PART_InnerTextBox.IsKeyboardFocusWithin, Converter={x:Static BoolConverters.Not}}" />

                            <StackPanel Name="LeftRightButtons"
                                        Margin="0,0,4,0"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <Button Name="PART_LeftButton"
                                        Classes="left"
                                        Theme="{StaticResource PropertyEditorLeftRightButton}" />

                                <Button Name="PART_RightButton"
                                        Classes="right"
                                        Theme="{StaticResource PropertyEditorLeftRightButton}" />
                            </StackPanel>

                            <ContentPresenter Name="PART_MenuContentPresenter"
                                              Grid.Row="1"
                                              Grid.Column="1"
                                              Content="{TemplateBinding MenuContent}"
                                              ContentTemplate="{TemplateBinding MenuContentTemplate}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^:not(:visible-left-button) /template/ Button#PART_LeftButton">
            <Setter Property="IsEnabled" Value="False" />
        </Style>
        <Style Selector="^:not(:visible-right-button) /template/ Button#PART_RightButton">
            <Setter Property="IsEnabled" Value="False" />
        </Style>
        <Style Selector="^[KeyFrameCount=0] /template/ StackPanel#LeftRightButtons">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!--  A drag darkens the whole box, as well as the fill.  -->
        <Style Selector="^:sliding /template/ local|ValueSliderField#PART_Slider">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Background" Value="{DynamicResource ValueSliderFieldTint}" />
            <Setter Property="Foreground" Value="{DynamicResource ValueSliderFieldStrongTint}" />
            <Setter Property="ThumbBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style Selector="^ /template/ local|ValueSliderField#PART_Slider[IsHitTestVisible=False]">
            <Setter Property="Opacity" Value="0" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
