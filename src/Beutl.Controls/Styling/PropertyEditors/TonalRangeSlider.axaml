<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:Beutl.Controls.PropertyEditors">
    <Design.PreviewWith>
        <Border Width="360" Padding="16">
            <local:TonalRangeSlider High="60" Low="40" />
        </Border>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type local:TonalRangeSlider}" TargetType="local:TonalRangeSlider">
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="HandleBrush" Value="White" />
        <Setter Property="HandleBorderBrush" Value="#B3000000" />
        <Setter Property="Cursor" Value="SizeWestEast" />
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
