<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:icons="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
                    xmlns:local="using:Beutl.Controls.PropertyEditors"
                    xmlns:ui="using:FluentAvalonia.UI.Controls">
    <Design.PreviewWith>
        <Border Width="300">
            <StackPanel>
                <local:GradingColorEditor EditorStyle="Settings" Header="Property 1" />
                <local:GradingColorEditor Header="Property 1" KeyFrameCount="3" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type local:GradingColorEditor}"
                  BasedOn="{StaticResource {x:Type local:ColorEditor}}"
                  TargetType="local:GradingColorEditor">
        <Style Selector="^ /template/ Grid#PART_ValueGrid">
            <Setter Property="MinWidth" Value="120" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
