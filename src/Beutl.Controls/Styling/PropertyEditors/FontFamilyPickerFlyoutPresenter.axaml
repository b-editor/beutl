<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Beutl.Controls"
                    xmlns:media="using:Beutl.Media"
                    xmlns:local="using:Beutl.Controls.PropertyEditors"
                    x:CompileBindings="True">

    <ControlTheme x:Key="FontFamilyPickerFlyoutPresenter"
                  BasedOn="{StaticResource {x:Type local:LibraryItemPickerFlyoutPresenter}}"
                  TargetType="local:LibraryItemPickerFlyoutPresenter">
        <Setter Property="ItemTemplate">
            <DataTemplate x:DataType="local:PinnableLibraryItem">
                <!--  A symbol font draws its own name as symbols, so the tooltip, which keeps the UI font, spells it out.  -->
                <controls:MarqueeTextBlock VerticalAlignment="Center"
                                           FontFamily="{Binding UserData, Converter={x:Static local:BeutlFontFamilyToAvaloniaConverter.Instance}}"
                                           Text="{Binding DisplayName}"
                                           ToolTip.Tip="{Binding ((media:FontFamily)UserData).Name}">
                    <controls:MarqueeTextBlock.IsMarqueeActive>
                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                            <Binding Path="$parent[ListBoxItem].IsPointerOver" />
                            <Binding Path="$parent[ListBoxItem].IsSelected" />
                        </MultiBinding>
                    </controls:MarqueeTextBlock.IsMarqueeActive>
                </controls:MarqueeTextBlock>
            </DataTemplate>
        </Setter>

        <Style Selector="^ /template/ ToggleButton#ShowAllButton">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
