<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Beutl's corner rounding, overriding FluentAvalonia's defaults (4 / 8). Use these keys rather than literals;
        spots that match a value by hand (circles, some corners only, inside a stroke) carry their own comment.
    -->
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
</ResourceDictionary>
