<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <BeutlPublicLibrary>true</BeutlPublicLibrary>
    <BeutlSdkAutoReference>Controls</BeutlSdkAutoReference>
    <TargetFramework></TargetFramework><!-- empty so the TFMs below cross-target -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <NoWarn>AVP1002</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('windows'))">
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('windows'))">
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Beutl.E2ETests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The UI fonts are runtime assets of the host app. Leave them out of the
         NuGet package so the assembly stays under the feed's upload limit. -->
    <AvaloniaResource Include="Assets\**" Exclude="Assets\Fonts\**" />
    <AvaloniaResource Include="Assets\Fonts\**" Condition="'$(BeutlNuGetPack)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" />
    <PackageReference Include="Xaml.Behaviors.Avalonia" />
    <PackageReference Include="Xaml.Behaviors.Interactivity" />
    <PackageReference Include="DynamicData" />
    <PackageReference Include="FluentAvaloniaUI" />
    <PackageReference Include="FluentIcons.Avalonia.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Beutl.Extensibility\Beutl.Extensibility.csproj" />
    <ProjectReference Include="..\Beutl.Language\Beutl.Language.csproj" />
    <ProjectReference Include="..\Beutl.Engine\Beutl.Engine.csproj" />
  </ItemGroup>

</Project>
