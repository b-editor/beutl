<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework></TargetFramework><!-- empty so the TFMs below cross-target -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <NoWarn>AVP1002</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('windows'))">
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('windows'))">
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only the controls that extensions use are public; the app's assemblies use the rest. -->
    <InternalsVisibleTo Include="Beutl" />
    <InternalsVisibleTo Include="Beutl.Editor.Components" />
    <InternalsVisibleTo Include="Beutl.PackageTools.UI" />
    <InternalsVisibleTo Include="Beutl.ExceptionHandler" />
    <InternalsVisibleTo Include="Beutl.E2ETests" />
    <InternalsVisibleTo Include="Beutl.UnitTests" />
    <InternalsVisibleTo Include="Beutl.HeadlessUITests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" />
    <PackageReference Include="Xaml.Behaviors.Avalonia" />
    <PackageReference Include="Xaml.Behaviors.Interactivity" />
    <PackageReference Include="DynamicData" />
    <PackageReference Include="FluentAvaloniaUI" />
    <PackageReference Include="FluentIcons.Avalonia.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Beutl.Extensibility\Beutl.Extensibility.csproj" />
    <ProjectReference Include="..\Beutl.Language\Beutl.Language.csproj" />
    <ProjectReference Include="..\Beutl.Engine\Beutl.Engine.csproj" />
  </ItemGroup>

</Project>
