<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework></TargetFramework><!-- empty so the TFMs below cross-target -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <SelfContained>false</SelfContained>
    <DefineConstants>$(DefineConstants);BEUTL_LINKED_UI_FONTS</DefineConstants>
    <DesktopExeRids>true</DesktopExeRids>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DynamicData" />
    <PackageReference Include="HarfBuzzSharp" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="System.CommandLine" />

    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="AvaloniaUI.DiagnosticsSupport" />
    <PackageReference Include="FluentAvaloniaUI" />
    <PackageReference Include="FluentIcons.Avalonia.Fluent" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Beutl.Controls\Styling\UiFonts.cs" Link="Styling\UiFonts.cs" />
    <Compile Include="..\Beutl.Controls\Styling\UiFontFamilyExtension.cs" Link="Styling\UiFontFamilyExtension.cs" />
    <AvaloniaResource Include="..\Beutl.Controls\Styling\Fonts.axaml" Link="Styling\Fonts.axaml" />
    <AvaloniaResource Include="..\Beutl.Controls\Assets\Fonts\**" Link="Assets\Fonts\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
