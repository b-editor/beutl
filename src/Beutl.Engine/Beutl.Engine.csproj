<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNameSpace>Beutl</RootNameSpace>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(RootDirectory)native/SkiaSharp/Beutl.Engine.targets" Pack="true" PackagePath="buildTransitive/Beutl.Engine.targets" />
    <None Remove="runtimes/**/*" />
    <None Include="$(BeutlSkiaSharpNativeRoot)runtimes/**/*" Pack="true" PackagePath="buildTransitive/native/runtimes/%(RecursiveDir)%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>
  <Target Name="RequireSkiaSharpForPackage" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <_RequiredSkiaSharp Include="linux-x64/native/libSkiaSharp.so;linux-arm64/native/libSkiaSharp.so;win-x64/native/libSkiaSharp.dll;win-arm64/native/libSkiaSharp.dll;osx/native/libSkiaSharp.dylib" />
    </ItemGroup>
    <Error Condition="!Exists('$(BeutlSkiaSharpNativeRoot)runtimes/%(_RequiredSkiaSharp.Identity)')"
           Text="Packing Beutl.Engine requires all supported libSkiaSharp binaries from src/Beutl.Engine/runtimes. Restore the committed files, or set BeutlSkiaSharpNativeRoot to a complete native runtime directory." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\Beutl.Core\Beutl.Core.csproj" />
    <ProjectReference Include="..\Beutl.Configuration\Beutl.Configuration.csproj" />
    <ProjectReference Include="..\Beutl.Language\Beutl.Language.csproj" />
    <ProjectReference Include="..\Beutl.Threading\Beutl.Threading.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Beutl.Engine.SourceGenerators\Beutl.Engine.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HarfBuzzSharp" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.DependencyModel" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" />
    <PackageReference Include="NAudio.Core" />
    <PackageReference Include="Silk.NET.MoltenVK.Native" />
    <PackageReference Include="Silk.NET.OpenAL" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" />
    <PackageReference Include="Silk.NET.Vulkan" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" />
    <PackageReference Include="Silk.NET.Vulkan.Loader.Native" />
    <PackageReference Include="Silk.NET.Vulkan.SwiftShader.Native" />
    <PackageReference Include="SkiaSharp.HarfBuzz" />
    <PackageReference Include="Vortice.XAudio2" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" />
    <PackageReference Include="Silk.NET.Shaderc" />
    <PackageReference Include="Silk.NET.Shaderc.Native" GeneratePathProperty="true" />
    <PackageReference Include="Silk.NET.Assimp" />
    <PackageReference Include="Ultz.Native.Assimp" GeneratePathProperty="true" />
  </ItemGroup>

  <!--
    Silk.NET's loader cannot resolve distro-specific RIDs (e.g. ubuntu.24.04-x64), so also copy the natives next to
    the binaries. A RID-specific publish gets them from NuGet, so this copy is not published: publishing it from an
    x64 host would let the SDK pick the x64 copy and drop the arm64 one from a linux-arm64 publish.
  -->
  <PropertyGroup>
    <_ShadercNativeRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_ShadercNativeRid>

    <_ShadercNativeRid Condition="'$(_ShadercNativeRid)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' == 'true' And '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X64'">linux-x64</_ShadercNativeRid>
    <_ShadercNativeRid Condition="'$(_ShadercNativeRid)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' == 'true' And '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64'">linux-arm64</_ShadercNativeRid>
    <_ShadercNativeRid Condition="'$(_ShadercNativeRid)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true' And '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X64'">osx-x64</_ShadercNativeRid>
    <_ShadercNativeRid Condition="'$(_ShadercNativeRid)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true' And '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64'">osx-arm64</_ShadercNativeRid>
    <_ShadercNativeRid Condition="'$(_ShadercNativeRid)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true' And '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X64'">win-x64</_ShadercNativeRid>
    <_ShadercNativeRid Condition="'$(_ShadercNativeRid)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true' And '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64'">win-arm64</_ShadercNativeRid>
    <_ShadercNativeRid Condition="'$(_ShadercNativeRid)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true' And '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X86'">win-x86</_ShadercNativeRid>
  </PropertyGroup>

  <!--
    Exists() ガードで、パッケージに含まれていない RID (例: linux-musl-x64, osx.13-arm64 など) が
    指定された場合に空 Content にフェイルし、ビルド失敗を回避する。
  -->
  <ItemGroup Condition="'$(_ShadercNativeRid)' != '' And '$(PkgSilk_NET_Shaderc_Native)' != '' And Exists('$(PkgSilk_NET_Shaderc_Native)\runtimes\$(_ShadercNativeRid)\native')">
    <Content Include="$(PkgSilk_NET_Shaderc_Native)\runtimes\$(_ShadercNativeRid)\native\*">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      <Visible>False</Visible>
    </Content>
  </ItemGroup>

  <!-- Assimp uses the same Silk loader and distro-specific RID lookup as Shaderc.
       Make the bundled libraries available to RID-neutral outputs through BaseDirectoryResolver;
       a RID-specific publish gets the target's own copies from NuGet, as with Shaderc above. -->
  <ItemGroup Condition="'$(_ShadercNativeRid)' != '' And '$(PkgUltz_Native_Assimp)' != '' And Exists('$(PkgUltz_Native_Assimp)\runtimes\$(_ShadercNativeRid)\native')">
    <Content Include="$(PkgUltz_Native_Assimp)\runtimes\$(_ShadercNativeRid)\native\*">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      <Visible>False</Visible>
    </Content>
  </ItemGroup>
</Project>
